<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colors -->
    <Color x:Key="PrimaryColor">#2D7FF9</Color>
    <Color x:Key="BackgroundColor">#FFFFFF</Color>
    <Color x:Key="SidebarBackgroundColor">#F5F5F5</Color>
    <Color x:Key="TextColor">#333333</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>

    <!-- Default Font Style -->
    <Style TargetType="Control">
        <Setter Property="FontFamily" Value="Microsoft YaHei, Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <!-- Navigation ListBox Style -->
    <Style x:Key="NavigationListBoxStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

</ResourceDictionary>
