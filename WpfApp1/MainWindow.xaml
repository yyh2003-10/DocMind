<Window x:Class="DocMind.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DocMind"
        xmlns:vm="clr-namespace:DocMind.ViewModels"
        xmlns:v="clr-namespace:DocMind.Views"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="600" Width="1000"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}" Icon="/托盘图标D 单.png" ResizeMode="CanMinimize">

    <Window.Resources>
        <!-- DataTemplates to map ViewModels to Views -->
        <DataTemplate DataType="{x:Type vm:SearchViewModel}">
            <v:SearchView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ImportViewModel}">
            <v:ImportView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConvertViewModel}">
            <v:ConvertView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QualityViewModel}">
            <v:QualityView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <v:SettingsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="37*"/>
            <ColumnDefinition Width="322*"/>
            <ColumnDefinition Width="641*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Border Grid.Row="0" BorderBrush="#EEE" BorderThickness="0,0,0,1" Grid.ColumnSpan="3">
            <Grid Margin="10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="DocMind" FontWeight="Bold" FontSize="18" Foreground="{StaticResource PrimaryBrush}"/>
                    <Ellipse Width="10" Height="10" Fill="Green" Margin="20,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Backend Connected" VerticalAlignment="Center" FontSize="12" Foreground="Gray"/>
                </StackPanel>
                <Button Content="Settings" HorizontalAlignment="Right" VerticalAlignment="Center" Width="80" Height="30" Background="Transparent" BorderThickness="0"/>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,30" Grid.RowSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <!-- Sidebar -->
                <ColumnDefinition Width="*"/>
                <!-- Content -->
                <ColumnDefinition Width="300"/>
                <!-- Details -->
            </Grid.ColumnDefinitions>

            <!-- Sidebar Navigation -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}" BorderBrush="#EEE" BorderThickness="0,0,1,0">
                <ListBox ItemsSource="{Binding NavigationItems}" 
                         SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                         Style="{StaticResource NavigationListBoxStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="10,12">
                                <Image Source="{Binding IconSource}" Width="32" Height="32" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <!-- Simple selection logic: we use a trigger or a custom ListBox to handle Type to Instance mapping,
                         but for this skeleton, we'll manually set SelectedItem to the instance in code or MainViewModel.
                         Actually, let's keep it simple: ListBox SelectedItem binds to CurrentPage. 
                         We need MainViewModel to handle selection change or provide instances. -->
                </ListBox>
            </Border>

            <!-- Content Area -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="20"/>

            <!-- Right Detail Panel -->
            <Expander Grid.Column="2" ExpandDirection="Left" IsExpanded="True" Header="Details" BorderBrush="#EEE" BorderThickness="1,0,0,0">
                <Grid Margin="10">
                    <TextBlock Text="Detail panel" Foreground="Gray" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                </Grid>
            </Expander>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Right" Width="1" Background="#EEE"/>
        </Grid>

        <!-- Bottom Bar -->
        <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="#EEE" BorderThickness="0,1,0,0" Grid.ColumnSpan="3">
            <StatusBar Background="Transparent">
                <StatusBarItem>
                    <TextBlock Text="Backend: localhost:8765" FontSize="12"/>
                </StatusBarItem>
                <Separator/>
                <StatusBarItem>
                    <TextBlock Text="Documents: 0" FontSize="12"/>
                </StatusBarItem>
                <StatusBarItem>
                    <TextBlock Text="Chunks: 0" FontSize="12"/>
                </StatusBarItem>
            </StatusBar>
        </Border>
    </Grid>
</Window>
