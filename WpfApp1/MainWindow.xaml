<Window x:Class="DocMind.MainWindow" x:Name="WindowRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DocMind.ViewModels"
        xmlns:v="clr-namespace:DocMind.Views"
        xmlns:h="clr-namespace:DocMind.Helpers"
        xmlns:cc="clr-namespace:DocMind.Controls"
        mc:Ignorable="d"
        Title="{Binding Title}"
        MinWidth="800" MinHeight="600"
        Width="1000" Height="700"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Icon="/托盘图标D 单.png"
        SnapsToDevicePixels="True">

    <Window.InputBindings>
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding NavigateToSearchCommand}"/>
        <KeyBinding Key="I" Modifiers="Control" Command="{Binding NavigateToImportCommand}"/>
        <KeyBinding Key="C" Modifiers="Control+Shift" Command="{Binding NavigateToConvertCommand}"/>
        <KeyBinding Key="Q" Modifiers="Control+Shift" Command="{Binding NavigateToQualityCommand}"/>
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding NavigateToSettingsCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <!-- DataTemplates: ViewModel → View -->
        <DataTemplate DataType="{x:Type vm:SearchViewModel}">
            <v:SearchView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ImportViewModel}">
            <v:ImportView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConvertViewModel}">
            <v:ConvertView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QualityViewModel}">
            <v:QualityView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DocumentsViewModel}">
            <v:DocumentsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <v:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DebugLogViewModel}">
            <v:DebugLogView/>
        </DataTemplate>

        <!-- 侧栏折叠宽度转换器 -->
        <h:BooleanToSidebarWidthConverter x:Key="SidebarWidthConverter"/>
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>   <!-- 顶栏 -->
            <RowDefinition Height="*"/>    <!-- 主体区域 -->
            <RowDefinition Height="30"/>   <!-- 底栏 -->
        </Grid.RowDefinitions>

        <!-- =====================================================================
             顶栏 (Row 0)
             ===================================================================== -->
        <Border Grid.Row="0"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧: 品牌 + 连接状态 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="DocMind" Style="{StaticResource SubtitleText}"
                               Foreground="{StaticResource PrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <Ellipse Width="8" Height="8"
                             Fill="{Binding BackendStatusBrush, Mode=OneWay}"
                             Margin="16,0,6,0"
                             VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding BackendStatusText, Mode=OneWay}"
                               Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 右侧: 操作按钮 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⚙"
                            Command="{Binding NavigateToSettingsCommand}"
                            ToolTip="设置"
                            Style="{StaticResource IconButtonStyle}"/>
                    <Button Content="—"
                            Command="{Binding MinimizeToTrayCommand}"
                            ToolTip="最小化到托盘"
                            Style="{StaticResource IconButtonStyle}"
                            Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- =====================================================================
             主体区域 (Row 1) — 侧栏 | 内容 | 详情
             ===================================================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- 侧栏宽度绑定折叠状态 -->
                <ColumnDefinition Width="{Binding SidebarWidth, Mode=OneWay}"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- 侧栏 (Col 0)  -->
            <Border Grid.Column="0"
                    Background="{StaticResource SidebarBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 导航项 -->
                    <ListBox Grid.Row="0"
                             ItemsSource="{Binding NavigationItems}"
                             SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                             Style="{StaticResource NavigationListBoxStyle}"
                             ItemContainerStyle="{StaticResource SidebarItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NavigationItem}">
                                <StackPanel Orientation="Horizontal">
                                    <!-- emoji 字符图标（无 PNG 时回退显示） -->
                                    <TextBlock Text="{Binding Icon}"
                                               FontSize="16"
                                               Width="24" Height="24"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IconSource}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- PNG 图标 -->
                                    <Image Source="{Binding IconSource}"
                                           Width="24" Height="24"
                                           VerticalAlignment="Center">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IconSource}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <!-- 标题（折叠时隐藏） -->
                                    <TextBlock Text="{Binding Title, Mode=OneWay}"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"
                                               FontSize="14">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, Source={x:Reference WindowRoot}}"
                                                                 Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 折叠按钮 -->
                    <Button Grid.Row="1"
                            Command="{Binding ToggleSidebarCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            Height="32" Margin="0,0,0,4"
                            HorizontalAlignment="Center"
                            ToolTip="{Binding SidebarToggleTooltip}">
                        <TextBlock Text="{Binding SidebarToggleIcon, Mode=OneWay}"
                                   FontSize="12"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 侧栏分割线 -->
            <GridSplitter Grid.Column="1"
                          Width="1"
                          Background="{StaticResource BorderBrush}"
                          IsEnabled="False"/>

            <!-- 内容区域 (Col 2)  -->
            <cc:TransitioningContentControl Grid.Column="2"
                                            Content="{Binding CurrentPage}"
                                            Margin="16,12,16,12"
                                            Focusable="False"/>

            <!-- 详情分割线 -->
            <GridSplitter Grid.Column="3"
                          Width="1"
                          Background="{StaticResource BorderBrush}"/>

            <!-- 详情面板 (Col 4)  -->
            <Border Grid.Column="4"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,0,0,0"
                    Background="{StaticResource SurfaceBrush}"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="详情"
                               Style="{StaticResource SubtitleText}"
                               Margin="0,8,0,12"/>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- 搜索详情 -->
                            <StackPanel Visibility="{Binding IsSearchActive, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="当前选中" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SelectedHitInfo, Mode=OneWay}"
                                           Style="{StaticResource BodyText}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- 导入详情 -->
                            <StackPanel Visibility="{Binding IsImportActive, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="导入进度" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding ImportSummary, Mode=OneWay}"
                                           Style="{StaticResource BodyText}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- 无内容 -->
                            <TextBlock Text="选择内容以查看详情"
                                       Style="{StaticResource SmallText}"
                                       HorizontalAlignment="Center"
                                       Margin="0,20,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- =====================================================================
             底栏 (Row 2) — 统一状态
             ===================================================================== -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 后端连接信息 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6"
                             Fill="{Binding BackendStatusBrush, Mode=OneWay}"
                             VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding BackendUrl, Mode=OneWay}"
                               Style="{StaticResource SmallText}"
                               Margin="6,0,16,0"/>
                </StackPanel>

                <!-- 当前页面状态 -->
                <TextBlock Grid.Column="1"
                           Text="{Binding CurrentStatusText, Mode=OneWay}"
                           Style="{StaticResource SmallText}"
                           VerticalAlignment="Center"/>

                <!-- 忙碌指示器 -->
                <ProgressBar Grid.Column="2"
                             IsIndeterminate="True"
                             Width="100" Height="6"
                             MinHeight="6"
                             Visibility="{Binding CurrentIsBusy, Converter={StaticResource BoolToVis}}"
                             VerticalAlignment="Center"
                             Margin="8,0,0,0"/>
            </Grid>
        </Border>

        <!-- Toast 通知覆盖层 -->
        <cc:ToastControl x:Name="ToastLayer"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"
                         IsHitTestVisible="True"
                         Panel.ZIndex="9999"
                         Width="0" Height="0"/>
    </Grid>
</Window>
