<UserControl x:Class="DocMind.Views.ConvertView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DocMind.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 输入选择条 -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="选择要转换的源文件（PDF / DOCX / XLSX / PPTX / MD / HTML …）"
                     IsReadOnly="True" Padding="6" VerticalContentAlignment="Center" />
            <Button Grid.Column="1" Content="选择文件" Command="{Binding PickInputCommand}" Margin="8,0,0,0" Padding="10,4" />
        </Grid>

        <!-- 输出 + 格式条 -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="输出文件位置（留空仅预览）"
                     Padding="6" VerticalContentAlignment="Center" />
            <Button Grid.Column="1" Content="另存为…" Command="{Binding PickOutputCommand}" Margin="8,0,8,0" Padding="8,4" />
            <TextBlock Grid.Column="2" Text="格式：" VerticalAlignment="Center" Margin="4,0,4,0" />
            <ComboBox Grid.Column="3" ItemsSource="{Binding SupportedFormats}"
                      SelectedItem="{Binding Format}" Width="80" Margin="0,0,8,0" />
            <Button Grid.Column="4" Content="转换" Command="{Binding ConvertCommand}" Margin="0,0,4,0" Padding="10,4" />
            <Button Grid.Column="5" Content="重置" Command="{Binding ResetCommand}" Padding="10,4" />
        </Grid>

        <!-- 预览区 -->
        <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="预览"
                           FontWeight="Bold" Margin="0,0,0,6" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <TextBox Text="{Binding PreviewContent, Mode=OneWay}"
                             IsReadOnly="True" BorderThickness="0"
                             TextWrapping="Wrap" FontFamily="Consolas, monospace"
                             Background="White" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 状态栏 -->
        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock DockPanel.Dock="Left" Text="●" Foreground="#2B6CB0" Margin="0,0,4,0" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="#4A5560" />
            <ProgressBar DockPanel.Dock="Right"
                        IsIndeterminate="True" Width="120" Height="14"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                        Margin="8,0,0,0" />
        </DockPanel>
    </Grid>
</UserControl>
