<UserControl x:Class="DocMind.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DocMind.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,0,8">
            <StackPanel MaxWidth="540">
                <TextBlock Text="后端连接" FontWeight="Bold" Margin="0,0,0,8" />

                <TextBlock Text="后端地址" Foreground="#4A5560" Margin="0,0,0,2" />
                <TextBox Text="{Binding BackendUrl, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="http://127.0.0.1:8765" Padding="6" Margin="0,0,0,12" />

                <TextBlock Text="任务轮询间隔（毫秒）" Foreground="#4A5560" Margin="0,0,0,2" />
                <TextBox Text="{Binding PollIntervalMs, UpdateSourceTrigger=PropertyChanged}"
                         Padding="6" Margin="0,0,0,12" />

                <TextBlock Text="后端启动超时（秒）" Foreground="#4A5560" Margin="0,0,0,2" />
                <TextBox Text="{Binding StartupTimeoutSec, UpdateSourceTrigger=PropertyChanged}"
                         Padding="6" Margin="0,0,0,12" />

                <TextBlock Foreground="#7C8B9A" FontSize="11" TextWrapping="Wrap"
                           Text="提示：保存后写入 appsettings.json，重启客户端后生效。" />
            </StackPanel>
        </ScrollViewer>

        <!-- 工具条 + 状态 -->
        <DockPanel Grid.Row="1" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="保存" Command="{Binding SaveCommand}" Padding="10,4" Margin="0,0,4,0" />
                <Button Content="恢复" Command="{Binding RevertCommand}" Padding="10,4" />
            </StackPanel>
            <TextBlock VerticalAlignment="Center" Foreground="#4A5560" Text="{Binding StatusMessage}" Margin="8,0,0,0" />
            <Border DockPanel.Dock="Right" Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}"
                    CornerRadius="8" Background="#FED7D7" Padding="8,2" VerticalAlignment="Center" Margin="8,0,0,0">
                <TextBlock Text="未保存" Foreground="#C53030" FontSize="11" />
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
