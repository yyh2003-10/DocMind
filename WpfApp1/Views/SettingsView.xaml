<UserControl x:Class="DocMind.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DocMind.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 设置内容（可滚动） ===== -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      Padding="0,0,0,12">
            <StackPanel MaxWidth="560">
                <!-- ===== 网络连接 ===== -->
                <Border Background="{StaticResource BackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20,16"
                        Margin="0,0,0,12"
                        Effect="{StaticResource ShadowSm}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="🌐" FontSize="20" Margin="0,0,10,0"/>
                            <TextBlock Text="后端连接" Style="{StaticResource SubtitleText}"/>
                        </StackPanel>

                        <TextBlock Text="后端地址" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding BackendUrl, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="例如 http://127.0.0.1:8765"
                                 Margin="0,0,0,16"/>

                        <TextBlock Text="启动超时（秒）" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding StartupTimeoutSec, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="后端进程启动等待时间"
                                 Margin="0,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ===== 性能 ===== -->
                <Border Background="{StaticResource BackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20,16"
                        Margin="0,0,0,12"
                        Effect="{StaticResource ShadowSm}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="⚡" FontSize="20" Margin="0,0,10,0"/>
                            <TextBlock Text="性能" Style="{StaticResource SubtitleText}"/>
                        </StackPanel>

                        <TextBlock Text="任务轮询间隔（毫秒）" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding PollIntervalMs, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="100-10000ms，值越小实时性越高但负载越大"/>
                    </StackPanel>
                </Border>

                <!-- ===== 模型与分块 ===== -->
                <Border Background="{StaticResource BackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20,16"
                        Margin="0,0,0,12"
                        Effect="{StaticResource ShadowSm}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="🧠" FontSize="20" Margin="0,0,10,0"/>
                            <TextBlock Text="模型与分块" Style="{StaticResource SubtitleText}"/>
                        </StackPanel>

                        <TextBlock Text="嵌入模型" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding SupportedEmbedModels}"
                                  SelectedItem="{Binding EmbedModel}"
                                  ToolTip="向量化用模型；更换模型后需在后端重启后到「文档库」页重建索引"
                                  Margin="0,0,0,8"/>

                        <!-- GPU 加速警告条（精简版安装包无 onnxruntime-gpu 时显示） -->
                        <Border Background="#FFF8E1"
                                BorderBrush="#FFC107"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,8"
                                Margin="0,0,0,12"
                                Visibility="{Binding GpuWarning.ShowWarning, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="当前为 CPU 模式（嵌入推理较慢）" FontWeight="SemiBold"/>
                                    <TextBlock Text="安装 GPU 加速包可显著提升性能" FontSize="12" Foreground="Gray"/>
                                </StackPanel>
                                <Button Content="安装 GPU 加速"
                                        Command="{Binding GpuWarning.OpenGpuInstallCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Padding="8,4"
                                        Margin="12,0,0,0"
                                        FontSize="12"
                                        VerticalAlignment="Center"/>
                                <Button Content="不再提示"
                                        Command="{Binding GpuWarning.DismissGpuWarningCommand}"
                                        Style="{StaticResource TextButtonStyle}"
                                        Margin="8,0,0,0"
                                        FontSize="12"
                                        VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="本地模型目录（可选）" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EmbedModelPath, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="填本地 ONNX 模型目录（含 model.onnx / model_optimized.onnx + tokenizer.json）；留空则用上面的模型联网下载"
                                 Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource SmallText}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,0,12">
                            留空 = 使用上方下拉的推荐模型（首次自动下载，之后用本地缓存）；填本地目录 = 完全离线使用自己的模型。
                        </TextBlock>

                        <TextBlock Style="{StaticResource SmallText}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,0,12">
                            以下参数修改后重启客户端生效（注入后端环境变量），留空使用后端默认值。
                        </TextBlock>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="分块最大 token 数" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding ChunkMaxTokens, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="默认 1500；越大分块越粗"
                                         Margin="0,0,0,12"/>
                                <TextBlock Text="分块最小字符数" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding ChunkMinChars, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="默认 50；低于此长度的块被丢弃"
                                         Margin="0,0,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="分块重叠字符数" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding ChunkOverlapChars, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="默认 200；相邻块重叠量，越大上下文越连贯"
                                         Margin="0,0,0,12"/>
                                <TextBlock Text="分块最大字符数" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding ChunkMaxChars, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="默认 4000；单块字符上限"
                                         Margin="0,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== 启动选项 ===== -->
                <Border Background="{StaticResource BackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20,16"
                        Margin="0,0,0,12"
                        Effect="{StaticResource ShadowSm}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="🚀" FontSize="20" Margin="0,0,10,0"/>
                            <TextBlock Text="启动选项" Style="{StaticResource SubtitleText}"/>
                        </StackPanel>

                        <!-- 自动拉起后端 -->
                        <CheckBox IsChecked="{Binding AutoStartBackend}"
                                  Margin="0,0,0,8">
                            <TextBlock Text="启动客户端时自动拉起后端"
                                       Style="{StaticResource BodyText}"/>
                        </CheckBox>
                        <TextBlock Style="{StaticResource SmallText}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,0,12">
                            取消勾选则仅连接外部已运行的后端（手动 doc2mind serve）
                        </TextBlock>

                        <!-- 退出联动终止 -->
                        <CheckBox IsChecked="{Binding StopBackendOnExit}"
                                  Margin="0,0,0,8">
                            <TextBlock Text="退出客户端时联动终止后端"
                                       Style="{StaticResource BodyText}"/>
                        </CheckBox>
                        <TextBlock Style="{StaticResource SmallText}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,0,12">
                            取消勾选则退出后保留后端继续运行
                        </TextBlock>

                        <!-- 后端命令路径 -->
                        <TextBlock Text="后端命令路径（可选）" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding BackendCommand, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="绝对路径优先；空走自动探测 doc2mind / python -m doc2mind"
                                 Margin="0,0,0,16"/>

                        <!-- 自动导入 -->
                        <TextBlock Text="启动时自动导入的目录（可选）" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding AutoIngestPath, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="空表示不自动导入；填目录或文件路径"
                                 Margin="0,0,0,8"/>
                        <TextBlock Text="目标集合名" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding AutoIngestCollection, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="默认 default"
                                 Margin="0,0,0,8"/>
                        <CheckBox IsChecked="{Binding AutoIngestRecursive}"
                                  Margin="0,0,0,0">
                            <TextBlock Text="目录时递归子目录"
                                       Style="{StaticResource BodyText}"/>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- ===== 外观 ===== -->
                <Border Background="{StaticResource BackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20,16"
                        Margin="0,0,0,12"
                        Effect="{StaticResource ShadowSm}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="🎨" FontSize="20" Margin="0,0,10,0"/>
                            <TextBlock Text="外观" Style="{StaticResource SubtitleText}"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="主题"
                                       Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="☀ 浅色"
                                        Command="{Binding SetLightThemeCommand}"
                                        Width="Auto" MinWidth="64"
                                        Padding="12,6"
                                        Margin="0,0,8,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedTheme}" Value="Light">
                                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextInverseBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="🌙 深色"
                                        Command="{Binding SetDarkThemeCommand}"
                                        Width="Auto" MinWidth="64"
                                        Padding="12,6">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedTheme}" Value="Dark">
                                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextInverseBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== 关于 ===== -->
                <Border Background="{StaticResource BackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20,16"
                        Effect="{StaticResource ShadowSm}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="ℹ" FontSize="20" Margin="0,0,10,0"/>
                            <TextBlock Text="关于" Style="{StaticResource SubtitleText}"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource BodyText}">
                            <Run Text="DocMind "/>
                            <Run Text="v1.0.0"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0">
                            <Run Text="后端 "/><Run Text="{Binding BackendUrl}"/>
                        </TextBlock>

                        <!-- GPU 加速状态 -->
                        <TextBlock Style="{StaticResource SmallText}"
                                   Margin="0,8,0,0"
                                   Foreground="{Binding GpuWarning.GpuStatusBrush}">
                            <Run Text="GPU 加速："/>
                            <Run Text="{Binding GpuWarning.GpuStatusText}"/>
                        </TextBlock>

                        <TextBlock Style="{StaticResource SmallText}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0">
                            提示：修改后端连接后保存配置，重启客户端使通信变更加载最新配置。
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== 底部工具条 ===== -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,8,0,0">
            <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="保存"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,8,0"/>
                    <Button Content="恢复上次保存"
                            Command="{Binding RevertCommand}"
                            Style="{StaticResource TextButtonStyle}"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage, Mode=OneWay}"
                           Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center"
                           Margin="12,0,12,0"/>

                <Border Grid.Column="2"
                        CornerRadius="10"
                        Background="{StaticResource WarningLightBrush}"
                        Padding="10,4"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6"
                                 Fill="{StaticResource WarningBrush}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,6,0"/>
                        <TextBlock Text="有未保存的修改"
                                   Style="{StaticResource SmallText}"
                                   Foreground="{StaticResource WarningBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
