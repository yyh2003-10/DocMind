<UserControl x:Class="DocMind.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DocMind.ViewModels"
             xmlns:m="clr-namespace:DocMind.Models"
             xmlns:cc="clr-namespace:DocMind.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- 评分颜色: 高→绿, 中→蓝, 低→灰 -->
        <Style x:Key="ScoreBadge" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Score}" Value="0">
                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 结果卡片模板 -->
        <DataTemplate x:Key="HitCardTemplate" DataType="{x:Type m:SearchHit}">
            <Border Background="{StaticResource BackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,8"
                    Effect="{StaticResource ShadowSm}"
                    SnapsToDevicePixels="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Effect" Value="{StaticResource ShadowMd}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <!-- 选中高亮：跟随 ListBoxItem.IsSelected -->
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                         Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                                <Setter Property="Effect" Value="{StaticResource ShadowMd}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 第一行：评分 + 来源 -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 评分徽章 -->
                        <Border Grid.Column="0" Style="{StaticResource ScoreBadge}">
                            <TextBlock Text="{Binding Score, Mode=OneWay, StringFormat={}{0:F4}}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}"/>
                        </Border>

                        <!-- 来源文件名 -->
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Source, Mode=OneWay}"
                                   Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>

                        <!-- 格式标记 -->
                        <Border Grid.Column="2" CornerRadius="3"
                                Background="{StaticResource SurfaceBrush}"
                                Padding="4,1" Margin="4,0,0,0">
                            <TextBlock Text="{Binding Format, Mode=OneWay}"
                                       Style="{StaticResource SmallText}"/>
                        </Border>
                    </Grid>

                    <!-- 第二行：内容摘要 -->
                    <TextBlock Grid.Row="1"
                               Text="{Binding Content, Mode=OneWay}"
                               Style="{StaticResource BodyText}"
                               TextWrapping="Wrap"
                               MaxHeight="60"
                               TextTrimming="CharacterEllipsis"
                               LineHeight="20"/>

                    <!-- 第三行：元数据信息 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                                Margin="0,6,0,0">
                        <TextBlock Style="{StaticResource SmallText}">
                            <Run Text="page "/><Run Text="{Binding Page, Mode=OneWay, TargetNullValue=—}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource SmallText}" Margin="12,0,0,0">
                            <Run Text="type "/><Run Text="{Binding MatchType, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <!-- 搜索条 -->
            <RowDefinition Height="Auto"/>
            <!-- 统计 -->
            <RowDefinition Height="Auto"/>
            <!-- 结果 + 详情 -->
            <RowDefinition Height="*"/>
            <!-- 状态栏由 MainWindow 统一接管 -->
        </Grid.RowDefinitions>

        <!-- ===== 搜索条 ===== -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,10"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="QueryBox"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="输入搜索词，回车开始搜索"
                             VerticalContentAlignment="Center"
                             KeyUp="QueryBox_KeyUp"/>
                    <Button Grid.Column="1"
                            Content="×"
                            Style="{StaticResource TextButtonStyle}"
                            Command="{Binding ClearCommand}"
                            Visibility="{Binding HasQuery, Converter={StaticResource BoolToVis}}"
                            FontSize="16"
                            Padding="4,0"
                            Margin="-28,0,0,0"/>
                </Grid>

                <TextBox Grid.Column="1"
                         Text="{Binding Collection, UpdateSourceTrigger=PropertyChanged}"
                         Width="110"
                         ToolTip="集合名（可选，留空=搜索全部集合）。集合是把文档分组，导入时可指定"
                         Margin="0,0,8,0"/>

                <ComboBox Grid.Column="2"
                          SelectedValue="{Binding TopK}"
                          Width="72"
                          Margin="0,0,8,0">
                    <ComboBoxItem Content="5"/>
                    <ComboBoxItem Content="10" IsSelected="True"/>
                    <ComboBoxItem Content="20"/>
                    <ComboBoxItem Content="50"/>
                </ComboBox>

                <TextBox Grid.Column="3"
                         Text="{Binding MinScore, UpdateSourceTrigger=PropertyChanged}"
                         Width="64"
                         ToolTip="最低相似度（可选，0-1；如 0.3 表示只保留相似度 ≥0.3 的结果）"
                         VerticalContentAlignment="Center"
                         Margin="0,0,8,0"/>

                <Button Grid.Column="4"
                        Content="搜索"
                        Command="{Binding SearchCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,6,0"/>

                <Button Grid.Column="5"
                        Content="清空"
                        Command="{Binding ClearCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"/>
            </Grid>
        </Border>

        <!-- ===== 结果统计条 ===== -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="6"
                Padding="12,6"
                Margin="0,0,0,8"
                Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource CaptionText}">
                    <Run Text="共 "/><Run Text="{Binding LastResponse.Total, Mode=OneWay}"/><Run Text=" 条结果"/>
                </TextBlock>
                <TextBlock Style="{StaticResource CaptionText}" Margin="16,0,0,0">
                    <Run Text="耗时 "/><Run Text="{Binding LastResponse.ElapsedMs, Mode=OneWay, StringFormat={}{0:F0}}"/><Run Text="ms"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ===== 结果列表 + 详情 ===== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1.6*"/>
            </Grid.ColumnDefinitions>

            <!-- 结果列表 + 骨架屏 -->
            <Grid Grid.Column="0">
                <!-- 骨架屏（加载中显示） -->
                <StackPanel Margin="0,0,0,8"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <Border Background="{StaticResource BorderBrush}"
                            CornerRadius="8" Height="90" Margin="0,0,0,8"
                            Effect="{StaticResource ShadowSm}">
                        <StackPanel Margin="12">
                            <cc:SkeletonControl CornerRadius="4" Height="14" Width="120" Margin="0,0,0,8"/>
                            <cc:SkeletonControl CornerRadius="4" Height="14" Margin="0,0,0,6"/>
                            <cc:SkeletonControl CornerRadius="4" Height="12" Width="80"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource BorderBrush}"
                            CornerRadius="8" Height="80" Margin="0,0,0,8"
                            Effect="{StaticResource ShadowSm}">
                        <StackPanel Margin="12">
                            <cc:SkeletonControl CornerRadius="4" Height="14" Width="100" Margin="0,0,0,8"/>
                            <cc:SkeletonControl CornerRadius="4" Height="14" Margin="0,0,0,6"/>
                            <cc:SkeletonControl CornerRadius="4" Height="12" Width="60"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource BorderBrush}"
                            CornerRadius="8" Height="80"
                            Effect="{StaticResource ShadowSm}">
                        <StackPanel Margin="12">
                            <cc:SkeletonControl CornerRadius="4" Height="14" Width="90" Margin="0,0,0,8"/>
                            <cc:SkeletonControl CornerRadius="4" Height="14" Margin="0,0,0,6"/>
                            <cc:SkeletonControl CornerRadius="4" Height="12" Width="70"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 实际结果列表 + 空态引导（叠放） -->
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  BorderThickness="0">
                        <!-- ListBox 支持选中 → 绑定 SelectedHit，点击卡片即可看详情 -->
                        <ListBox ItemsSource="{Binding Hits}"
                                 ItemTemplate="{StaticResource HitCardTemplate}"
                                 SelectedItem="{Binding SelectedHit}"
                                 SelectionMode="Single"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 Focusable="False">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </ScrollViewer>

                    <!-- 空态引导：无结果且非忙碌时显示，告诉用户下一步该干嘛 -->
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="24"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowEmptyGuide, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="🔍" FontSize="40" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding EmptyGuideText, Mode=OneWay}"
                                       Style="{StaticResource BodyText}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- 分隔线 -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Center"
                          Background="{StaticResource BorderBrush}"/>

            <!-- 详情区 -->
            <Border Grid.Column="2"
                    Padding="12,0,0,0"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="详情"
                               Style="{StaticResource SubtitleText}"
                               Margin="0,0,0,12"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- 选中文档详情 -->
                            <Border Background="{StaticResource SurfaceBrush}"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,0,0,8"
                                    Visibility="{Binding HasSelectedHit, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,8">
                                        <Run Text="文档 "/><Run Text="{Binding SelectedHit.Source, Mode=OneWay}"/>
                                    </TextBlock>

                                    <!-- 评分进度条 -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="相似度"
                                                   Style="{StaticResource SmallText}"
                                                   Margin="0,0,8,0"/>
                                        <ProgressBar Grid.Column="1"
                                                     Value="{Binding SelectedHit.Score, Mode=OneWay}"
                                                     Maximum="1.0"
                                                     Height="6"
                                                     Foreground="{StaticResource PrimaryBrush}"/>
                                    </Grid>

                                    <!-- 元数据 -->
                                    <TextBlock Style="{StaticResource SmallText}" Margin="0,0,0,4">
                                        <Run Text="格式: "/><Run Text="{Binding SelectedHit.Format, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource SmallText}" Margin="0,0,0,4">
                                        <Run Text="标题: "/><Run Text="{Binding SelectedHit.Heading, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource SmallText}">
                                        <Run Text="匹配类型: "/><Run Text="{Binding SelectedHit.MatchType, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- 完整内容 -->
                            <TextBlock x:Name="DetailContentText"
                                       Text="{Binding SelectedHit.Content, Mode=OneWay}"
                                       Style="{StaticResource BodyText}"
                                       TextWrapping="Wrap"
                                       xml:space="preserve"/>

                            <!-- 空态 -->
                            <TextBlock Text="选择左侧一条结果查看详情"
                                       Style="{StaticResource SmallText}"
                                       HorizontalAlignment="Center"
                                       Margin="0,20,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
