<UserControl x:Class="DocMind.Views.QualityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DocMind.ViewModels"
             xmlns:m="clr-namespace:DocMind.Models"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具条 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBox DockPanel.Dock="Left" Text="{Binding Collection, UpdateSourceTrigger=PropertyChanged}"
                     Width="140" ToolTip="集合（可选）" Padding="6"
                     VerticalContentAlignment="Center" Margin="0,0,8,0" />
            <Button DockPanel.Dock="Right" Content="刷新" Command="{Binding RefreshCommand}" Padding="10,4" />
            <StackPanel Orientation="Horizontal" />
        </DockPanel>

        <!-- 概览卡片 -->
        <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,0,8,0">
            <Border Padding="10" Margin="0,0,6,0" Background="#F0F4F8" CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="文档总数" Foreground="#7C8B9A" FontSize="11" />
                    <TextBlock Text="{Binding Stats.TotalDocuments}" FontSize="22" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Padding="10" Margin="0,0,6,0" Background="#F0F4F8" CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="Chunk 总数" Foreground="#7C8B9A" FontSize="11" />
                    <TextBlock Text="{Binding Stats.TotalChunks}" FontSize="22" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Padding="10" Margin="0,0,6,0" Background="#F0F4F8" CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="重复率" Foreground="#7C8B9A" FontSize="11" />
                    <TextBlock Text="{Binding Report.DuplicateRate, StringFormat=\{0:P2\}}" FontSize="22" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Padding="10" Background="#F0F4F8" CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="元数据缺失率" Foreground="#7C8B9A" FontSize="11" />
                    <TextBlock Text="{Binding Report.MissingMetadataRate, StringFormat=\{0:P2\}}" FontSize="22" FontWeight="Bold" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 集合分布 + 警告 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock DockPanel.Dock="Top" Text="集合分布"
                           FontWeight="Bold" Margin="0,0,0,6" />
                <ListBox ItemsSource="{Binding Collections}" BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:CollectionStats}">
                            <DockPanel Margin="2">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" DockPanel.Dock="Top" />
                                <TextBlock FontSize="11" Foreground="#666">
                                    <Run Text="docs " /><Run Text="{Binding Documents}" />
                                    <Run Text=" · chunks " /><Run Text="{Binding Chunks}" />
                                    <Run Text=" · " /><Run Text="{Binding SizeBytes, StringFormat=\{0:N0\} B}" />
                                </TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <DockPanel Grid.Column="1">
                <TextBlock DockPanel.Dock="Top" Text="警告"
                           FontWeight="Bold" Foreground="#C53030" Margin="0,0,0,6" />
                <ListBox ItemsSource="{Binding Warnings}" BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#C53030" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>

        <!-- 状态栏 -->
        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock DockPanel.Dock="Left" Text="●" Foreground="#2B6CB0" Margin="0,0,4,0" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="#4A5560" />
            <ProgressBar DockPanel.Dock="Right"
                        IsIndeterminate="True" Width="120" Height="14"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                        Margin="8,0,0,0" />
        </DockPanel>
    </Grid>
</UserControl>
