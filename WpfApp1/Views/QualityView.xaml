<UserControl x:Class="DocMind.Views.QualityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DocMind.ViewModels"
             xmlns:m="clr-namespace:DocMind.Models"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 工具条 -->
            <RowDefinition Height="Auto"/>   <!-- 概览卡片 -->
            <RowDefinition Height="*"/>      <!-- 分布 + 警告 -->
        </Grid.RowDefinitions>

        <!-- ===== 工具条 ===== -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,10"
                Margin="0,0,0,12">
            <DockPanel>
                <TextBox DockPanel.Dock="Left"
                         Text="{Binding Collection, UpdateSourceTrigger=PropertyChanged}"
                         Width="140"
                         ToolTip="集合名（可选，留空=全部集合）。集合是把文档分组：导入时给文件指定分组，搜索/看板可按分组过滤"
                         Margin="0,0,8,0"/>
                <Button DockPanel.Dock="Right"
                        Content="刷新"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"/>
                <TextBlock DockPanel.Dock="Left"
                           Text="集合过滤"
                           Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <StackPanel Orientation="Horizontal"/>
            </DockPanel>
        </Border>

        <!-- ===== 概览卡片 ===== -->
        <UniformGrid Grid.Row="1" Rows="1" Columns="4"
                     Margin="0,0,0,16">

            <!-- 文档总数 -->
            <Border Padding="16,14" Margin="0,0,8,0"
                    Background="{StaticResource BackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Effect="{StaticResource ShadowSm}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📄" FontSize="20" Margin="0,0,8,0"/>
                        <TextBlock Text="文档总数" Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Stats.TotalDocuments, Mode=OneWay}"
                               Style="{StaticResource TitleText}"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Chunk 总数 -->
            <Border Padding="16,14" Margin="0,0,8,0"
                    Background="{StaticResource BackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Effect="{StaticResource ShadowSm}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🧩" FontSize="20" Margin="0,0,8,0"/>
                        <TextBlock Text="Chunk 总数" Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Stats.TotalChunks, Mode=OneWay}"
                               Style="{StaticResource TitleText}"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- 格式分布：知识库内出现的文档格式种数（真实数据） -->
            <Border Padding="16,14" Margin="0,0,8,0"
                    Background="{StaticResource BackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Effect="{StaticResource ShadowSm}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔁" FontSize="20" Margin="0,0,8,0"/>
                        <TextBlock Text="格式分布" Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Report.FormatDistribution.Count, Mode=OneWay, StringFormat={}{0} 种}"
                               Style="{StaticResource TitleText}"
                               Foreground="{StaticResource WarningBrush}"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- 质量警告：后端 quality 接口基于真实库内数据计算 -->
            <Border Padding="16,14" Margin="0,0,0,0"
                    Background="{StaticResource BackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Effect="{StaticResource ShadowSm}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠" FontSize="20" Margin="0,0,8,0"/>
                        <TextBlock Text="质量警告" Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Report.Warnings.Count, Mode=OneWay}"
                               Style="{StaticResource TitleText}"
                               Foreground="{StaticResource DangerBrush}"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ===== 集合分布 + 警告 ===== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 集合分布 -->
            <Border Grid.Column="0"
                    Background="{StaticResource BackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12"
                    Effect="{StaticResource ShadowSm}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="集合分布"
                               Style="{StaticResource SubtitleText}"
                               Margin="0,0,0,12"/>

                    <ListBox ItemsSource="{Binding Collections}"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:CollectionStats}">
                                <Border Background="{StaticResource SurfaceBrush}"
                                        CornerRadius="6"
                                        Padding="10,8"
                                        Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Text="{Binding Name, Mode=OneWay}"
                                                   FontWeight="SemiBold"
                                                   Style="{StaticResource BodyText}"/>

                                        <StackPanel Grid.Row="1" Orientation="Horizontal"
                                                    Margin="0,4,0,0">
                                            <TextBlock Style="{StaticResource SmallText}">
                                                <Run Text="文档 " FontWeight="SemiBold"/>
                                                <Run Text="{Binding Documents, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource SmallText}" Margin="16,0,0,0">
                                                <Run Text="Chunks " FontWeight="SemiBold"/>
                                                <Run Text="{Binding Chunks, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource SmallText}" Margin="16,0,0,0">
                                                <Run Text="{Binding SizeBytes, Mode=OneWay, StringFormat={}{0:N0} B}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 警告 -->
            <Border Grid.Column="2"
                    Background="{StaticResource DangerLightBrush}"
                    BorderBrush="{StaticResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12"
                    Effect="{StaticResource ShadowSm}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="⚠" FontSize="16" Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="警告"
                                   Style="{StaticResource SubtitleText}"
                                   Foreground="{StaticResource DangerBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Warnings}"
                             BorderThickness="0"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource DangerLightBrush}"
                                        CornerRadius="4"
                                        Padding="8,6"
                                        Margin="0,0,0,4">
                                    <TextBlock Text="{Binding}"
                                               Style="{StaticResource CaptionText}"
                                               Foreground="{StaticResource DangerBrush}"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 空态 -->
                    <TextBlock Text="暂无警告"
                               Style="{StaticResource SmallText}"
                               HorizontalAlignment="Center"
                               Margin="0,20,0,0"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
