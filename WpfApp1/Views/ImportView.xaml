<UserControl x:Class="DocMind.Views.ImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DocMind.ViewModels"
             xmlns:m="clr-namespace:DocMind.Models"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             AllowDrop="True" Drop="View_Drop" DragOver="View_DragOver">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 路径选择条 -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding SelectedPath, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="拖拽文件 / 文件夹到此处，或点「选择」"
                     IsReadOnly="True" Padding="6" VerticalContentAlignment="Center"
                     AllowDrop="True" />
            <Button Grid.Column="1" Content="选择" Command="{Binding PickPathCommand}" Margin="8,0,4,0" Padding="10,4" />
            <TextBox Grid.Column="2" Text="{Binding Collection, UpdateSourceTrigger=PropertyChanged}"
                     Width="120" ToolTip="集合" Padding="6" Margin="4,0,8,0" />
            <CheckBox Grid.Column="3" Content="递归" IsChecked="{Binding Recursive}" Margin="4,0,8,0" VerticalAlignment="Center" />
            <StackPanel Grid.Column="4" Orientation="Horizontal">
                <Button Content="导入" Command="{Binding ImportCommand}" Margin="0,0,4,0" Padding="10,4" />
                <Button Content="重置" Command="{Binding ResetCommand}" Padding="10,4" />
            </StackPanel>
        </Grid>

        <!-- 进度条 -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar Grid.Column="0" Value="{Binding ProgressPercent}" Maximum="100" Height="16"
                         IsIndeterminate="{Binding IsBusy}" />
            <TextBlock Grid.Column="1" Text="{Binding ProgressPercent, StringFormat=\{0\}%}" Margin="8,0,0,0" VerticalAlignment="Center" />
        </Grid>

        <!-- 结果三栏：导入 / 跳过 / 失败 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 导入成功 -->
            <DockPanel Grid.Column="0" Margin="0,0,4,0">
                <TextBlock DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,4">
                    <Run Text="导入成功 (" /><Run Text="{Binding Results.Count}" /><Run Text=")" />
                </TextBlock>
                <ListBox ItemsSource="{Binding Results}" BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:IngestResult}">
                            <StackPanel Margin="2">
                                <TextBlock Text="{Binding Document.Name}" FontWeight="Bold" />
                                <TextBlock FontSize="11" Foreground="#666">
                                    <Run Text="chunks " /><Run Text="{Binding ChunksAdded}" />
                                    <Run Text=" · dup " /><Run Text="{Binding DuplicatesSkipped}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- 跳过 -->
            <DockPanel Grid.Column="1" Margin="4,0,4,0">
                <TextBlock DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,4">
                    <Run Text="跳过 (" /><Run Text="{Binding Skipped.Count}" /><Run Text=")" />
                </TextBlock>
                <ListBox ItemsSource="{Binding Skipped}" BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- 失败 -->
            <DockPanel Grid.Column="2" Margin="4,0,0,0">
                <TextBlock DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,4" Foreground="#C53030">
                    <Run Text="失败 (" /><Run Text="{Binding Failed.Count}" /><Run Text=")" />
                </TextBlock>
                <ListBox ItemsSource="{Binding Failed}" BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="#C53030" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>

        <!-- 状态栏 -->
        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock DockPanel.Dock="Left" Text="●" Foreground="#2B6CB0" Margin="0,0,4,0" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="#4A5560" />
        </DockPanel>
    </Grid>
</UserControl>
