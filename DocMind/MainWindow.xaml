<Window x:Class="DocMind.MainWindow" x:Name="WindowRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DocMind.ViewModels"
        xmlns:v="clr-namespace:DocMind.Views"
        xmlns:h="clr-namespace:DocMind.Helpers"
        xmlns:cc="clr-namespace:DocMind.Controls"
        mc:Ignorable="d"
        Title="{Binding Title}"
        MinWidth="900" MinHeight="600"
        Width="1100" Height="720"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Icon="/托盘图标D 单.png"
        SnapsToDevicePixels="True"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding NavigateToSearchCommand}"/>
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding NavigateToChatCommand}"/>
        <KeyBinding Key="I" Modifiers="Control" Command="{Binding NavigateToImportCommand}"/>
        <KeyBinding Key="C" Modifiers="Control+Shift" Command="{Binding NavigateToConvertCommand}"/>
        <KeyBinding Key="Q" Modifiers="Control+Shift" Command="{Binding NavigateToQualityCommand}"/>
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding NavigateToSettingsCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <!-- DataTemplates: ViewModel → View -->
        <DataTemplate DataType="{x:Type vm:SearchViewModel}">
            <v:SearchView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ChatViewModel}">
            <v:ChatView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ImportViewModel}">
            <v:ImportView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConvertViewModel}">
            <v:ConvertView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QualityViewModel}">
            <v:QualityView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DocumentsViewModel}">
            <v:DocumentsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GraphViewModel}">
            <v:GraphView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <v:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DebugLogViewModel}">
            <v:DebugLogView/>
        </DataTemplate>

        <h:BooleanToSidebarWidthConverter x:Key="SidebarWidthConverter"/>
    </Window.Resources>

    <!-- 根容器 — 模拟窗口内容区，带圆角 -->
    <Border x:Name="WindowBorder"
            Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            SnapsToDevicePixels="True"
            Margin="0">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>   <!-- 自定义标题栏 -->
                <RowDefinition Height="*"/>    <!-- 主体区域 -->
                <RowDefinition Height="28"/>   <!-- 状态栏 -->
            </Grid.RowDefinitions>

            <!-- =====================================================================
                 自定义标题栏 (Row 0)
                 ===================================================================== -->
            <Border x:Name="TitleBarBorder"
                    Grid.Row="0"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Background="{StaticResource SidebarBackgroundBrush}">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧: 品牌 + 连接状态 (可拖动) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                x:Name="BrandPanel">
                        <TextBlock Text="DocMind" Style="{StaticResource SubtitleText}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   FontWeight="Bold"/>
                        <!-- 版本号 -->
                        <TextBlock Text="v1.0"
                                   Style="{StaticResource SmallText}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>
                        <Ellipse Width="6" Height="6"
                                 Fill="{Binding BackendStatusBrush, Mode=OneWay}"
                                 Margin="16,0,6,0"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding BackendStatusText, Mode=OneWay}"
                                   Style="{StaticResource SmallText}"
                                   VerticalAlignment="Center"/>
                        <!-- 离线时的一键启动/重连操作 -->
                        <Button Content="启动服务"
                                Command="{Binding StartBackendCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                FontSize="11"
                                Padding="8,2"
                                Height="22"
                                Margin="8,0,0,0"
                                Visibility="{Binding CanStartBackend, Converter={StaticResource BoolToVis}}"
                                ToolTip="尝试启动本地 Python 后端服务并重连"/>

                        <!-- 跨页面全局后台任务胶囊指示器 -->
                        <Button Command="{Binding FocusBackgroundTaskCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                FontSize="11"
                                Padding="8,2"
                                Height="22"
                                Margin="12,0,0,0"
                                Visibility="{Binding HasBackgroundTask, Converter={StaticResource BoolToVis}}"
                                ToolTip="点击快速跳转至进行中的后台任务">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource PrimaryBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding BackgroundTaskSummary, Mode=OneWay}"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 右侧: 窗口控制按钮 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="⚙"
                                Command="{Binding NavigateToSettingsCommand}"
                                ToolTip="设置"
                                Style="{StaticResource IconButtonStyle}"
                                Width="32" Height="32"/>
                        <Button x:Name="MinimizeButton"
                                Content="─"
                                ToolTip="最小化"
                                Style="{StaticResource IconButtonStyle}"
                                Width="36" Height="32"
                                Margin="4,0,0,0"
                                Click="MinimizeButton_Click"/>
                        <Button x:Name="MaximizeButton"
                                Content="□"
                                ToolTip="最大化"
                                Style="{StaticResource IconButtonStyle}"
                                Width="36" Height="32"
                                Margin="2,0,0,0"
                                Click="MaximizeButton_Click"/>
                        <Button x:Name="CloseButton"
                                Content="✕"
                                ToolTip="关闭"
                                Width="36" Height="32"
                                Margin="2,0,-4,0"
                                Cursor="Hand"
                                Background="Transparent"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                BorderThickness="0"
                                Click="CloseButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Root" Background="{TemplateBinding Background}"
                                                        CornerRadius="6" Padding="8,0">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Root" Property="Background" Value="{StaticResource DangerBrush}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Root" Property="Background" Value="{StaticResource DangerLightBrush}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- =====================================================================
                 主体区域 (Row 1) — 侧栏 | 内容 | 详情
                 ===================================================================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding SidebarWidth, Mode=OneWay}"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 侧栏 (Col 0) -->
                <Border Grid.Column="0"
                        Background="{StaticResource SidebarBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,1,0"
                        SnapsToDevicePixels="True">
                    <Grid Margin="0,6,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 导航项 -->
                        <ListBox Grid.Row="0"
                                 ItemsSource="{Binding NavigationItemsView}"
                                 SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                                 Style="{StaticResource NavigationListBoxStyle}"
                                 ItemContainerStyle="{StaticResource SidebarItemStyle}">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Border Margin="8,10,6,3"
                                                    Padding="4,0,0,2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, Source={x:Reference WindowRoot}}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                            </Border>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:NavigationItem}">
                                    <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                                        <!-- emoji 回退图标 -->
                                        <TextBlock Text="{Binding Icon}"
                                                   FontSize="16"
                                                   Width="22" Height="22"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IconSource}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- PNG 图标 -->
                                        <Image Source="{Binding IconSource}"
                                               Width="22" Height="22"
                                               VerticalAlignment="Center">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IconSource}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <!-- 标题 -->
                                        <TextBlock Text="{Binding Title, Mode=OneWay}"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,0,0"
                                                   FontSize="14"
                                                   FontWeight="Medium">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, Source={x:Reference WindowRoot}}"
                                                                     Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 折叠按钮 -->
                        <Button Grid.Row="1"
                                Command="{Binding ToggleSidebarCommand}"
                                Style="{StaticResource IconButtonStyle}"
                                Height="32" Margin="0,0,0,6"
                                HorizontalAlignment="Center"
                                ToolTip="{Binding SidebarToggleTooltip}">
                            <TextBlock Text="{Binding SidebarToggleIcon, Mode=OneWay}"
                                       FontSize="10"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- 侧栏分割线 -->
                <GridSplitter Grid.Column="1"
                              Width="1"
                              Background="{StaticResource BorderBrush}"
                              IsEnabled="False"/>

                <!-- 内容区域 (Col 2) — 带淡入过渡，子 View 自行管理详情面板 -->
                <cc:TransitioningContentControl Grid.Column="2"
                                                Content="{Binding CurrentPage}"
                                                Margin="20,16,20,16"
                                                Focusable="False"/>
            </Grid>

            <!-- =====================================================================
                 状态栏 (Row 2)
                 ===================================================================== -->
            <Border Grid.Row="2"
                    Background="{StaticResource SidebarBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 后端连接信息 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="5" Height="5"
                                 Fill="{Binding BackendStatusBrush, Mode=OneWay}"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding BackendUrl, Mode=OneWay}"
                                   Style="{StaticResource SmallText}"
                                   Margin="6,0,16,0"/>
                    </StackPanel>

                    <!-- 当前页面状态 -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding CurrentStatusText, Mode=OneWay}"
                               Style="{StaticResource SmallText}"
                               VerticalAlignment="Center"/>

                    <!-- 忙碌指示器 -->
                    <ProgressBar Grid.Column="2"
                                 IsIndeterminate="True"
                                 Width="80" Height="4"
                                 MinHeight="4"
                                 Visibility="{Binding CurrentIsBusy, Converter={StaticResource BoolToVis}}"
                                 VerticalAlignment="Center"
                                 Margin="8,0,0,0"/>
                </Grid>
            </Border>

            <!-- Toast 通知覆盖层（跨全屏拉伸显示） -->
            <cc:ToastControl x:Name="ToastLayer"
                             Grid.Row="0" Grid.RowSpan="3"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch"
                             IsHitTestVisible="True"
                             Panel.ZIndex="9999"/>
        </Grid>
    </Border>
</Window>