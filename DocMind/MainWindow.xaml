<Window x:Class="DocMind.MainWindow" x:Name="WindowRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DocMind.ViewModels"
        xmlns:v="clr-namespace:DocMind.Views"
        xmlns:h="clr-namespace:DocMind.Helpers"
        xmlns:cc="clr-namespace:DocMind.Controls"
        mc:Ignorable="d"
        Title="{Binding Title}"
        MinWidth="960" MinHeight="620"
        Width="1100" Height="720"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Icon="/托盘图标D 单.png"
        SnapsToDevicePixels="True"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding NavigateToSearchCommand}"/>
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding NavigateToChatCommand}"/>
        <KeyBinding Key="I" Modifiers="Control" Command="{Binding NavigateToImportCommand}"/>
        <KeyBinding Key="C" Modifiers="Control+Shift" Command="{Binding NavigateToConvertCommand}"/>
        <KeyBinding Key="Q" Modifiers="Control+Shift" Command="{Binding NavigateToQualityCommand}"/>
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding NavigateToSettingsCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <!-- DataTemplates: ViewModel → View -->
        <DataTemplate DataType="{x:Type vm:SearchViewModel}">
            <v:SearchView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ChatViewModel}">
            <v:ChatView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ImportViewModel}">
            <v:ImportView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConvertViewModel}">
            <v:ConvertView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QualityViewModel}">
            <v:QualityView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DocumentsViewModel}">
            <v:DocumentsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GraphViewModel}">
            <v:GraphView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <v:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DebugLogViewModel}">
            <v:DebugLogView/>
        </DataTemplate>

        <h:BooleanToSidebarWidthConverter x:Key="SidebarWidthConverter"/>
    </Window.Resources>

    <!-- 根容器 — 模拟窗口内容区，带圆角 -->
    <Border x:Name="WindowBorder"
            Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CornerLg}"
            SnapsToDevicePixels="True"
            Margin="0">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>   <!-- 自定义标题栏 -->
                <RowDefinition Height="Auto"/> <!-- 批次 4：全局离线恢复横幅 -->
                <RowDefinition Height="*"/>    <!-- 主体区域 -->
                <RowDefinition Height="28"/>   <!-- 状态栏 -->
            </Grid.RowDefinitions>

            <!-- =====================================================================
                 自定义标题栏 (Row 0)
                 ===================================================================== -->
            <Border x:Name="TitleBarBorder"
                    Grid.Row="0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Background="{DynamicResource SidebarBackgroundBrush}">
                <Grid Margin="16,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧: 品牌 + 连接状态 (可拖动) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                x:Name="BrandPanel">
                        <Border Background="{DynamicResource PrimaryLightBrush}"
                                CornerRadius="{DynamicResource CornerSm}"
                                Padding="6,2"
                                VerticalAlignment="Center">
                            <TextBlock Text="DocMind"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <!-- 版本号 -->
                        <Border Style="{DynamicResource BadgeStyle}"
                                VerticalAlignment="Center"
                                Margin="6,0,0,0">
                            <TextBlock Text="v1.0"
                                       Style="{DynamicResource ChipTextStyle}"
                                       FontSize="{StaticResource FontSizeMicro}"/>
                        </Border>
                        <Border Style="{DynamicResource StatusPillStyle}"
                                Background="{DynamicResource SurfaceBrush}"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                ToolTip="{Binding BackendStatusText, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6"
                                         Fill="{Binding BackendStatusBrush, Mode=OneWay}"
                                         Margin="0,0,6,0"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding BackendStatusText, Mode=OneWay}"
                                           Style="{DynamicResource ChipTextStyle}"
                                           FontSize="{StaticResource FontSizeMicro}"/>
                            </StackPanel>
                        </Border>
                        <!-- 离线时的一键启动/重连操作 -->
                        <Button Content="启动服务"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Command="{Binding StartBackendCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                FontSize="{StaticResource FontSizeSmall}"
                                Padding="8,2"
                                Height="22"
                                MinHeight="22"
                                Margin="8,0,0,0"
                                Visibility="{Binding CanStartBackend, Converter={StaticResource BoolToVis}}"
                                ToolTip="尝试启动本地 Python 后端服务并重连"/>

                        <!-- 跨页面全局后台任务胶囊指示器 -->
                        <Button Command="{Binding FocusBackgroundTaskCommand}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource SecondaryButtonStyle}"
                                FontSize="{StaticResource FontSizeSmall}"
                                Padding="8,2"
                                Height="22"
                                MinHeight="22"
                                Margin="12,0,0,0"
                                Visibility="{Binding HasBackgroundTask, Converter={StaticResource BoolToVis}}"
                                ToolTip="点击快速跳转至进行中的后台任务">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource PrimaryBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding BackgroundTaskSummary, Mode=OneWay}"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 右侧: 窗口控制按钮 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button WindowChrome.IsHitTestVisibleInChrome="True"
                                Command="{Binding NavigateToSettingsCommand}"
                                ToolTip="设置"
                                Style="{StaticResource IconButtonStyle}"
                                Width="32" Height="32">
                            <Path Data="{StaticResource IconSettings}" Style="{StaticResource IconSmStyle}"/>
                        </Button>
                        <Button x:Name="MinimizeButton"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="最小化"
                                Style="{StaticResource IconButtonStyle}"
                                Width="36" Height="32"
                                Margin="4,0,0,0"
                                Click="MinimizeButton_Click">
                            <Path Data="{StaticResource IconMinimize}" Style="{StaticResource IconSmStyle}"/>
                        </Button>
                        <Button x:Name="MaximizeButton"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="最大化"
                                Style="{StaticResource IconButtonStyle}"
                                Width="36" Height="32"
                                Margin="2,0,0,0"
                                Click="MaximizeButton_Click">
                            <Path Data="{StaticResource IconMaximize}" Style="{StaticResource IconSmStyle}"/>
                        </Button>
                        <Button x:Name="CloseButton"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="关闭"
                                Width="36" Height="32"
                                Margin="2,0,-4,0"
                                Cursor="Hand"
                                Background="Transparent"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                BorderThickness="0"
                                Click="CloseButton_Click">
                            <Path Data="{StaticResource IconClose}" Style="{StaticResource IconSmStyle}" Stroke="{DynamicResource TextSecondaryBrush}"/>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Root" Background="{TemplateBinding Background}"
                                                        CornerRadius="{StaticResource CornerMd}" Padding="8,0">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Root" Property="Background" Value="{StaticResource DangerBrush}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Root" Property="Background" Value="{StaticResource DangerLightBrush}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════
                 批次 4：全局离线恢复横幅
                 ═══════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="1"
                    Background="{DynamicResource DangerLightBrush}"
                    BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,8"
                    Visibility="{Binding ShowOfflineBanner, Converter={StaticResource BoolToVis}}">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding RefreshBackendCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="10,4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconRefresh}" Style="{StaticResource IconSmStyle}" Margin="0,0,6,0"/>
                                <TextBlock Text="重新检测"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding StartBackendCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="10,4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconRocket}" Style="{StaticResource IconSmStyle}" Stroke="White" Margin="0,0,6,0"/>
                                <TextBlock Text="一键重启后端"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenDebugLogCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="10,4">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconList}" Style="{StaticResource IconSmStyle}" Margin="0,0,6,0"/>
                                <TextBlock Text="查看日志"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconWarning}" Style="{StaticResource IconSmStyle}" Stroke="{DynamicResource DangerBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="后端服务离线" FontWeight="Bold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource DangerBrush}"/>
                        </StackPanel>
                        <TextBlock Text="无法连接到后端服务，部分功能暂不可用。请检查后重启。" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- =====================================================================
                 主体区域 (Row 2) — 双轨侧栏 (Rail + Drawer) | 内容画卷 (Canvas)
                 ===================================================================== -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <!-- Col 0: 主导航极窄轨 (54px) -->
                    <ColumnDefinition Width="54"/>
                    <!-- Col 1: 工作区二级侧栏抽屉 (Drawer) — 宽度由 Border 动画驱动 -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Col 2: 主工作区画卷 (Canvas) -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ═══════════════════════════════════════════════════════════════
                     Col 0: 主导航极窄轨 (Rail, 54px)
                     ═══════════════════════════════════════════════════════════════ -->
                <Border Grid.Column="0"
                        Background="{DynamicResource RailBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderLightBrush}"
                        BorderThickness="0,0,1,0"
                        SnapsToDevicePixels="True">
                    <Grid Margin="0,8,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 顶部灵动品牌图标 -->
                        <Border Grid.Row="0" Width="36" Height="36" CornerRadius="{StaticResource CornerMd}"
                                Background="{DynamicResource PrimaryLightBrush}"
                                HorizontalAlignment="Center" Margin="0,0,0,12"
                                ToolTip="DocMind 本地向量知识库">
                            <Path Data="{StaticResource IconBrain}"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  Stroke="{DynamicResource PrimaryBrush}"
                                  StrokeThickness="1.5"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Fill="Transparent"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- 主导航图标列表 (纯图标，带 ToolTip) -->
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding NavigationItems}"
                                 SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                                 Style="{DynamicResource NavigationListBoxStyle}"
                                 ItemContainerStyle="{DynamicResource RailItemStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:NavigationItem}">
                                    <Grid ToolTip="{Binding Title}" Width="40" Height="40">
                                        <Path x:Name="NavIcon"
                                              Data="{StaticResource IconChat}"
                                              Style="{StaticResource NavIconStyle}"
                                              Stroke="{DynamicResource TextSecondaryBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Title}" Value="搜索">
                                            <Setter TargetName="NavIcon" Property="Data" Value="{StaticResource IconSearch}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Title}" Value="知识图谱">
                                            <Setter TargetName="NavIcon" Property="Data" Value="{StaticResource IconGraph}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Title}" Value="文档库">
                                            <Setter TargetName="NavIcon" Property="Data" Value="{StaticResource IconFolder}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Title}" Value="导入">
                                            <Setter TargetName="NavIcon" Property="Data" Value="{StaticResource IconImport}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Title}" Value="转换">
                                            <Setter TargetName="NavIcon" Property="Data" Value="{StaticResource IconConvert}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Title}" Value="质量看板">
                                            <Setter TargetName="NavIcon" Property="Data" Value="{StaticResource IconDashboard}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Title}" Value="设置">
                                            <Setter TargetName="NavIcon" Property="Data" Value="{StaticResource IconSettings}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Title}" Value="调试日志">
                                            <Setter TargetName="NavIcon" Property="Data" Value="{StaticResource IconList}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 底部控制按钮：抽屉折叠/展开 + 设置 -->
                        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <!-- 折叠/展开抽屉：图标随开合旋转 180° -->
                            <Button Command="{Binding ToggleDrawerCommand}"
                                    Style="{DynamicResource IconButtonStyle}"
                                    Width="36" Height="36"
                                    Margin="0,2"
                                    ToolTip="{Binding DrawerToggleTooltip}">
                                <Path Data="{StaticResource IconPanelLeft}"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="0"/>
                                    </Path.RenderTransform>
                                    <Path.Style>
                                        <Style TargetType="Path" BasedOn="{StaticResource IconSmStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDrawerOpen}" Value="False">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation
                                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                    To="180"
                                                                    Duration="0:0:0.2">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation
                                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                    To="0"
                                                                    Duration="0:0:0.2">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══════════════════════════════════════════════════════════════
                     Col 1: 工作区二级侧栏抽屉 (Drawer) — 对话页显示会话历史
                     ═══════════════════════════════════════════════════════════════ -->
                <Border x:Name="DrawerHost"
                        Grid.Column="1"
                        Background="{DynamicResource DrawerBackgroundBrush}"
                        BorderBrush="{DynamicResource ElevatedBorderBrush}"
                        BorderThickness="0,0,1,0"
                        SnapsToDevicePixels="True"
                        ClipToBounds="True"
                        Width="0">
                    <Border.Style>
                        <!-- 对话页且展开时滑出 240px；收起/离开对话页滑回 0 -->
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsChatActive}" Value="True"/>
                                        <Condition Binding="{Binding IsDrawerOpen}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <MultiDataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetProperty="Width"
                                                    To="240"
                                                    Duration="0:0:0.2">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </MultiDataTrigger.EnterActions>
                                    <MultiDataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetProperty="Width"
                                                    To="0"
                                                    Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </MultiDataTrigger.ExitActions>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid Margin="12,12,12,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 抽屉头部：新建会话主操作 -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Command="{Binding ChatViewModel.NewChatCommand}"
                                    Style="{DynamicResource PrimaryButtonStyle}"
                                    Height="34"
                                    MinHeight="34"
                                    Padding="12,6"
                                    HorizontalContentAlignment="Center"
                                    ToolTip="开启新会话">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconPlus}" Style="{StaticResource IconSmStyle}" Stroke="{DynamicResource TextInverseBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="新建对话" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1"
                                    Command="{Binding ToggleDrawerCommand}"
                                    Style="{DynamicResource IconButtonStyle}"
                                    Width="32" Height="34"
                                    Margin="6,0,0,0"
                                    ToolTip="收起侧边栏">
                                <Path Data="{StaticResource IconPanelLeft}" Style="{StaticResource IconSmStyle}" Width="14" Height="14"/>
                            </Button>
                        </Grid>

                        <!-- 会话历史标题与搜索框 -->
                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <TextBox Text="{Binding ChatViewModel.SessionSearchFilter, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="26,5,22,5"
                                     Height="32"
                                     FontSize="{StaticResource FontSizeCaption}"
                                     VerticalContentAlignment="Center"
                                     Background="{DynamicResource CardBrush}"
                                     BorderBrush="{DynamicResource BorderLightBrush}"
                                     BorderThickness="1"/>
                            <Path Data="{StaticResource IconSearch}"
                                  Style="{StaticResource IconSmStyle}"
                                  Width="12" Height="12"
                                  Stroke="{DynamicResource TextMutedBrush}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"
                                  Margin="8,0,0,0"
                                  IsHitTestVisible="False"/>
                            <TextBlock Text="搜索会话…"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       Margin="28,0,0,0"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ChatViewModel.SessionSearchFilter}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ChatViewModel.SessionSearchFilter}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- 历史会话列表 -->
                        <ListBox Grid.Row="2"
                                 ItemsSource="{Binding ChatViewModel.FilteredSessions}"
                                 SelectedItem="{Binding ChatViewModel.SelectedSession, Mode=TwoWay}"
                                 Style="{DynamicResource NavigationListBoxStyle}"
                                 ItemContainerStyle="{DynamicResource DrawerSessionItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,8">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ChatSessionItem}">
                                    <Grid Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="2,0,0,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6"
                                                         Fill="{DynamicResource DocMindEmeraldBrush}"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding DisplayTitle}"
                                                           FontSize="{StaticResource FontSizeCaption}"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="165"
                                                           ToolTip="{Binding Title}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Tag}"
                                                       FontSize="{StaticResource FontSizeMicro}"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       Margin="12,2,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <!-- 仅在悬停/选中时显示的删除按钮 -->
                                        <Button Grid.Column="1"
                                                x:Name="DeleteSessionBtn"
                                                Command="{Binding DataContext.ChatViewModel.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                CommandParameter="{Binding}"
                                                Width="22" Height="22"
                                                VerticalAlignment="Center"
                                                Margin="2,0,0,0"
                                                ToolTip="删除此会话">
                                            <Path Data="{StaticResource IconClose}" Style="{StaticResource IconSmStyle}" Stroke="{DynamicResource TextSecondaryBrush}"/>
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                                    <Setter Property="Opacity" Value="0"/>
                                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Opacity" Value="0.75"/>
                                                            <Setter Property="IsHitTestVisible" Value="True"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Opacity" Value="0.75"/>
                                                            <Setter Property="IsHitTestVisible" Value="True"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Opacity" Value="1"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 抽屉底部安全与留存提示 -->
                        <Border Grid.Row="3" Margin="0,4,0,4" Padding="0,4,0,2" Height="28"
                                BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,1,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconLock}" Style="{StaticResource IconSmStyle}" Width="12" Height="12" Margin="0,0,4,0"/>
                                <TextBlock Text="本地私有存储 · 永久留存"
                                           FontSize="{StaticResource FontSizeMicro}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ═══════════════════════════════════════════════════════════════
                     Col 2: 主工作区画卷 (Content Canvas)
                     ═══════════════════════════════════════════════════════════════ -->
                <!-- 画布底色：防深色页面首帧露白 -->
                <Border Grid.Column="2" Background="{DynamicResource CanvasBackgroundBrush}">
                    <cc:TransitioningContentControl Content="{Binding CurrentView}"
                                                    Margin="0"
                                                    Focusable="False"/>
                </Border>
            </Grid>

            <!-- =====================================================================
                 状态栏 (Row 3)
                 ===================================================================== -->
            <Border Grid.Row="3"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="16,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 后端连接信息 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="5" Height="5"
                                 Fill="{Binding BackendStatusBrush, Mode=OneWay}"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding BackendUrl, Mode=OneWay}"
                                   Style="{StaticResource SmallText}"
                                   Margin="6,0,16,0"/>
                    </StackPanel>

                    <!-- 当前页面状态 -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding CurrentStatusText, Mode=OneWay}"
                               Style="{StaticResource SmallText}"
                               VerticalAlignment="Center"/>

                    <!-- 忙碌指示器：小胶囊，避免裸进度条贴边 -->
                    <Border Grid.Column="2"
                            Style="{DynamicResource StatusPillStyle}"
                            Background="{DynamicResource PrimaryLightBrush}"
                            Visibility="{Binding CurrentIsBusy, Converter={StaticResource BoolToVis}}"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0"
                            Padding="8,2">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6"
                                     Fill="{DynamicResource PrimaryBrush}"
                                     Margin="0,0,6,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="处理中"
                                       Style="{DynamicResource ChipTextStyle}"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       FontSize="{StaticResource FontSizeMicro}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Toast 通知悬浮层（右下角悬浮堆叠，绝不遮挡或撑满整个窗体） -->
            <cc:ToastControl x:Name="ToastLayer"
                             Grid.Row="0" Grid.RowSpan="3"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Bottom"
                             Margin="0,0,20,38"
                             MaxWidth="380"
                             Panel.ZIndex="9999"/>
        </Grid>
    </Border>
</Window>
