<UserControl x:Class="DocMind.Controls.PdfCitationViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="500">
    <Grid Background="{DynamicResource SurfaceBrush}">
        <!-- 1. WebView2 PDF.js 核心视口 -->
        <wv2:WebView2 x:Name="PdfWebView"
                      DefaultBackgroundColor="Transparent"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"/>

        <!-- 2. 初始化失败或运行时缺失提示遮罩 -->
        <Border x:Name="ErrorOverlay"
                Visibility="Collapsed"
                Background="{DynamicResource SurfaceBrush}"
                Padding="24"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="320">
                <TextBlock Text="⚠️ 无法加载 PDF 阅览器"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>
                <TextBlock x:Name="ErrorDetailText"
                           Text="未检测到 WebView2 运行时或文件无法读取。"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,0,0,16"/>
                <Button Content="使用系统默认程序打开"
                        Click="OpenExternalButton_Click"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        HorizontalAlignment="Center"
                        Padding="12,6"/>
            </StackPanel>
        </Border>

        <!-- 3. 加载中遮罩 -->
        <Border x:Name="LoadingOverlay"
                Visibility="Visible"
                Background="{DynamicResource SurfaceBrush}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="140" Height="4" Margin="0,0,0,12"/>
                <TextBlock Text="正在准备原著阅览环境..."
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
