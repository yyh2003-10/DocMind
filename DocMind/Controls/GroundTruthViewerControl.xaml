<UserControl x:Class="DocMind.Controls.GroundTruthViewerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DocMind.Controls"
             xmlns:m="clr-namespace:DocMind.Models"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="450">
    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. 抽屉头部 (标题 + 评分徽标 + 半屏切换 + 关闭) -->
            <RowDefinition Height="Auto"/>
            <!-- 2. 出处元数据卡片 (文档名、章节、页码) -->
            <RowDefinition Height="Auto"/>
            <!-- 3. 主体内容区 (PDF阅读器 OR 纯文本切片) -->
            <RowDefinition Height="*"/>
            <!-- 4. 底部快捷操作栏 -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. 抽屉头部 -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- web 来源标题 -->
                <TextBlock Visibility="{Binding SelectedSource.IsWebSource, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                           Text="🌐 网页检索结果"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryBrush}"
                           VerticalAlignment="Center"/>
                <!-- 本地来源标题 -->
                <TextBlock Visibility="{Binding SelectedSource.IsWebSource, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InvertBoolVis}}"
                           Text="📖 原著知识查证"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 评分徽标 (本地来源) -->
            <Border Grid.Column="1"
                    Visibility="{Binding SelectedSource.IsWebSource, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InvertBoolVis}}"
                    Background="{DynamicResource PrimaryLightBrush}"
                    CornerRadius="4"
                    Padding="6,2"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedSource.ScoreBadgeText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryBrush}"/>
            </Border>

            <!-- 搜索引擎标签 (Web来源) -->
            <Border Grid.Column="1"
                    Visibility="{Binding SelectedSource.IsWebSource, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                    Background="{DynamicResource PrimaryLightBrush}"
                    CornerRadius="4"
                    Padding="6,2"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedSource.SourceName, RelativeSource={RelativeSource AncestorType=UserControl}, TargetNullValue=Web, StringFormat=来源: {0}}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryBrush}"/>
            </Border>

            <!-- 半屏沉浸展开 / 还原切换按钮 -->
            <Button Grid.Column="2"
                    x:Name="ToggleExpandButton"
                    Content="⛶"
                    Click="ToggleExpandButton_Click"
                    Style="{DynamicResource IconButtonStyle}"
                    Width="26" Height="26"
                    Margin="0,0,4,0"
                    ToolTip="切换半屏沉浸式阅读"/>

            <!-- 关闭按钮 -->
            <Button Grid.Column="3"
                    Content="✕"
                    Command="{Binding CloseSourceDrawerCommand}"
                    Style="{DynamicResource IconButtonStyle}"
                    Width="26" Height="26"
                    ToolTip="关闭原著查证 (Esc)"/>
        </Grid>

        <!-- 2. 出处元数据卡片 -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10,8"
                Margin="0,0,0,10">
            <StackPanel>
                <!-- 本地来源元数据 -->
                <StackPanel Visibility="{Binding SelectedSource.IsWebSource, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InvertBoolVis}}">
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="原著：" Style="{DynamicResource SmallText}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding SelectedSource.DisplayTitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   Style="{DynamicResource SmallText}"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding SelectedSource.Heading, RelativeSource={RelativeSource AncestorType=UserControl}, TargetNullValue=正文章节, StringFormat=章节：{0}}"
                                   Style="{DynamicResource SmallText}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{Binding SelectedSource.Page, RelativeSource={RelativeSource AncestorType=UserControl}, TargetNullValue=—, StringFormat=第 P{0} 页}"
                                   Style="{DynamicResource SmallText}"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   FontWeight="SemiBold"
                                   Margin="6,0,0,0"/>
                    </Grid>
                </StackPanel>

                <!-- Web 来源元数据 -->
                <StackPanel Visibility="{Binding SelectedSource.IsWebSource, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding SelectedSource.DisplayTitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Style="{DynamicResource SmallText}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding SelectedSource.Url, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Style="{DynamicResource SmallText}"
                               Foreground="{DynamicResource PrimaryBrush}"
                               TextDecorations="Underline"
                               TextWrapping="Wrap"
                               Cursor="Hand"
                               MouseLeftButtonDown="OpenWebUrl_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 3. 主体内容区 (PDF 原著视图 或 降级纯文本切片) -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <!-- 模式 1: PDF 原著嵌入式阅览器 (带精准黄色高亮) -->
            <Border x:Name="PdfViewerContainer"
                    Visibility="Collapsed"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True">
                <local:PdfCitationViewer x:Name="InnerPdfViewer"/>
            </Border>

            <!-- 模式 2: 非 PDF 格式降级纯文本切片 -->
            <Border x:Name="TextViewerContainer"
                    Visibility="Visible"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8">
                <TextBox Text="{Binding SelectedSourceSnippet, Mode=OneWay}"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Background="Transparent"
                         BorderThickness="0"
                         FontSize="13"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         Cursor="IBeam"/>
            </Border>
        </Grid>

        <!-- 4. 底部快捷操作栏 -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Row="0" Grid.Column="0"
                    Content="📋 复制摘要"
                    Command="{Binding CopySourceSnippetCommand}"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    Padding="8,6"
                    Margin="0,0,4,6"
                    ToolTip="复制当前切片正文到剪贴板"/>

            <!-- 本地来源：全文检索 -->
            <Button Grid.Row="0" Grid.Column="1"
                    Visibility="{Binding SelectedSource.IsWebSource, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InvertBoolVis}}"
                    Content="🔍 全文检索"
                    Command="{Binding SearchSourceInSearchPageCommand}"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    Padding="8,6"
                    Margin="4,0,0,6"
                    ToolTip="跳转至搜索页检索此文档的更多分块"/>

            <!-- Web 来源：在浏览器打开 -->
            <Button Grid.Row="0" Grid.Column="1"
                    Visibility="{Binding SelectedSource.IsWebSource, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                    Content="🌐 在浏览器中打开"
                    Command="{Binding OpenWebSourceCommand}"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    Padding="8,6"
                    Margin="4,0,0,6"
                    ToolTip="在默认浏览器中打开此网页"/>

            <!-- 本地来源：文件定位 + 打开文件 -->
            <Button Grid.Row="1" Grid.Column="0"
                    Visibility="{Binding SelectedSource.IsWebSource, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InvertBoolVis}}"
                    Content="📂 文件定位"
                    Command="{Binding RevealSourceInExplorerCommand}"
                    Style="{DynamicResource TextButtonStyle}"
                    FontSize="11"
                    Padding="6,4"
                    Margin="0,0,4,0"
                    ToolTip="在 Windows 文件资源管理器中选中并定位原文件"/>

            <Button Grid.Row="1" Grid.Column="1"
                    Visibility="{Binding SelectedSource.IsWebSource, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InvertBoolVis}}"
                    Content="📄 打开文件"
                    Command="{Binding OpenSourceFileCommand}"
                    Style="{DynamicResource TextButtonStyle}"
                    FontSize="11"
                    Padding="6,4"
                    Margin="4,0,0,0"
                    ToolTip="使用系统默认程序打开此原文件"/>
        </Grid>
    </Grid>
</UserControl>
