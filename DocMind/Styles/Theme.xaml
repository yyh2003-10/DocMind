<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ===================================================================
         DocMind Design System · Light Theme
         Deep Indigo primary · warm neutrals · layered elevation
         =================================================================== -->

    <!-- ==================== 1. 语义配色 ==================== -->
    <!-- Primary — Deep Indigo (关联知识深度与思考) -->
    <Color x:Key="PrimaryColor">#4F46E5</Color>
    <Color x:Key="PrimaryLight">#EEF2FF</Color>
    <Color x:Key="PrimaryHover">#4338CA</Color>
    <Color x:Key="PrimaryActive">#3730A3</Color>
    <Color x:Key="PrimarySubtle">#C7D2FE</Color>

    <!-- Semantic — Apple system colors -->
    <Color x:Key="SuccessColor">#34C759</Color>
    <Color x:Key="SuccessLight">#E9F9EE</Color>
    <Color x:Key="WarningColor">#FF9500</Color>
    <Color x:Key="WarningLight">#FFF4E6</Color>
    <Color x:Key="DangerColor">#FF3B30</Color>
    <Color x:Key="DangerHoverColor">#DC2626</Color>
    <Color x:Key="DangerActiveColor">#B91C1C</Color>
    <Color x:Key="DangerLight">#FFECEA</Color>
    <Color x:Key="InfoColor">#5AC8FA</Color>
    <Color x:Key="InfoLight">#E6F9FF</Color>

    <!-- Neutrals — Apple gray scale -->
    <Color x:Key="BackgroundColor">#FFFFFF</Color>
    <Color x:Key="SurfaceColor">#F2F2F7</Color>
    <Color x:Key="CardColor">#FFFFFF</Color>
    <Color x:Key="SidebarBackgroundColor">#F2F2F7</Color>
    <Color x:Key="BorderColor">#E5E5EA</Color>
    <Color x:Key="BorderLightColor">#F2F2F7</Color>
    <Color x:Key="HoverColor">#EBEDF0</Color>
    <Color x:Key="HoverCardColor">#F5F3FF</Color>
    <Color x:Key="SelectedColor">#EEF2FF</Color>

    <!-- Text — Apple label hierarchy -->
    <Color x:Key="TextPrimaryColor">#1D1D1F</Color>
    <Color x:Key="TextSecondaryColor">#8E8E93</Color>
    <Color x:Key="TextTertiaryColor">#AEAEB2</Color>
    <Color x:Key="TextMutedColor">#C7C7CC</Color>
    <Color x:Key="TextInverseColor">#FFFFFF</Color>
    <Color x:Key="LinkColor">#4F46E5</Color>
    <Color x:Key="AccentColor">#4F46E5</Color>

    <!-- ==================== Brushes ==================== -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLight}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHover}"/>
    <SolidColorBrush x:Key="PrimaryActiveBrush" Color="{StaticResource PrimaryActive}"/>
    <SolidColorBrush x:Key="PrimarySubtleBrush" Color="{StaticResource PrimarySubtle}"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="SuccessLightBrush" Color="{StaticResource SuccessLight}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="WarningLightBrush" Color="{StaticResource WarningLight}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHoverColor}"/>
    <SolidColorBrush x:Key="DangerActiveBrush" Color="{StaticResource DangerActiveColor}"/>
    <SolidColorBrush x:Key="DangerLightBrush" Color="{StaticResource DangerLight}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="InfoLightBrush" Color="{StaticResource InfoLight}"/>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}"/>
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}"/>
    <SolidColorBrush x:Key="HoverCardBrush" Color="{StaticResource HoverCardColor}"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="{StaticResource SelectedColor}"/>

    <!-- DocMind Flow 2.0 双轨与画卷系统 -->
    <SolidColorBrush x:Key="RailBackgroundBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="DrawerBackgroundBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FloatingCardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FloatingCardBorderBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="DocMindEmeraldBrush" Color="#059669"/>
    <SolidColorBrush x:Key="DocMindEmeraldLightBrush" Color="#ECFDF5"/>
    <SolidColorBrush x:Key="DocMindCyanBrush" Color="#0EA5E9"/>
    <SolidColorBrush x:Key="DocMindCyanLightBrush" Color="#F0F9FF"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextInverseBrush" Color="{StaticResource TextInverseColor}"/>
    <SolidColorBrush x:Key="LinkBrush" Color="{StaticResource LinkColor}"/>
    <SolidColorBrush x:Key="BodyBrush" Color="{StaticResource TextPrimaryColor}"/>

    <!-- ==================== 1.5 对话气泡配色 ==================== -->
    <!-- 用户消息：品牌靛蓝淡染胶囊（区别于通用 IM 灰，强化 DocMind 身份） -->
    <SolidColorBrush x:Key="UserBubbleBrush" Color="#E0E7FF"/>
    <SolidColorBrush x:Key="UserBubbleTextBrush" Color="#1E1B4B"/>
    <SolidColorBrush x:Key="UserBubbleBorderBrush" Color="#C7D2FE"/>

    <!-- 对话内 Markdown 排版配色 -->
    <SolidColorBrush x:Key="ChatCodeBlockBrush" Color="#F6F6F8"/>
    <SolidColorBrush x:Key="ChatCodeBlockBorderBrush" Color="#E5E5EA"/>
    <SolidColorBrush x:Key="ChatCodeInlineBrush" Color="#EFEFF2"/>
    <SolidColorBrush x:Key="ChatQuoteBrush" Color="{StaticResource TextSecondaryColor}"/>

    <!-- 骨架屏脉冲色（SkeletonControl 动画低/高色） -->
    <Color x:Key="SkeletonFromColor">#E9E9EB</Color>
    <Color x:Key="SkeletonToColor">#F7F7F9</Color>

    <!-- ==================== 2. 间距体系 ==================== -->
    <sys:Double x:Key="SpaceXs">4</sys:Double>
    <sys:Double x:Key="SpaceSm">8</sys:Double>
    <sys:Double x:Key="SpaceMd">12</sys:Double>
    <sys:Double x:Key="SpaceLg">16</sys:Double>
    <sys:Double x:Key="SpaceXl">20</sys:Double>
    <sys:Double x:Key="SpaceXxl">24</sys:Double>
    <sys:Double x:Key="SpaceXxxl">32</sys:Double>
    <!-- 控件高度三档：Compact 芯片 / Default 表单工具条 / Primary 主 CTA -->
    <sys:Double x:Key="ControlHeightCompact">28</sys:Double>
    <sys:Double x:Key="ControlHeightDefault">36</sys:Double>
    <sys:Double x:Key="ControlHeightPrimary">40</sys:Double>
    <!-- 动效三档（毫秒）：Hover/Pressed / 展开收起 / 页面切换 -->
    <sys:Double x:Key="MotionFastMs">120</sys:Double>
    <sys:Double x:Key="MotionNormalMs">180</sys:Double>
    <sys:Double x:Key="MotionSlowMs">240</sys:Double>

    <!-- ==================== 3. 圆角体系 ==================== -->
    <CornerRadius x:Key="CornerSm">4</CornerRadius>
    <CornerRadius x:Key="CornerMd">8</CornerRadius>
    <CornerRadius x:Key="CornerLg">12</CornerRadius>
    <CornerRadius x:Key="CornerXl">16</CornerRadius>
    <CornerRadius x:Key="CornerCapsule">18</CornerRadius>
    <CornerRadius x:Key="CornerPill">999</CornerRadius>

    <!-- ==================== 4. 阴影效果 — 强化层级 ==================== -->
    <DropShadowEffect x:Key="ShadowSm" BlurRadius="3" ShadowDepth="1"
                      Color="#000000" Opacity="0.08" RenderingBias="Performance"/>
    <DropShadowEffect x:Key="ShadowMd" BlurRadius="12" ShadowDepth="2"
                      Color="#000000" Opacity="0.12" RenderingBias="Performance"/>
    <DropShadowEffect x:Key="ShadowLg" BlurRadius="28" ShadowDepth="8"
                      Color="#000000" Opacity="0.16" RenderingBias="Performance"/>
    <DropShadowEffect x:Key="ShadowCard" BlurRadius="6" ShadowDepth="1"
                      Color="#000000" Opacity="0.06" RenderingBias="Performance"/>
    <DropShadowEffect x:Key="ShadowFloating" BlurRadius="24" ShadowDepth="3"
                      Color="#1E1B4B" Opacity="0.20" RenderingBias="Performance"/>
    <!-- 按钮悬停阴影（品牌色染色） -->
    <DropShadowEffect x:Key="ShadowButtonHover" BlurRadius="12" ShadowDepth="2"
                      Color="#4F46E5" Opacity="0.20" Direction="270" RenderingBias="Performance"/>

    <!-- ==================== 5. 字体体系 ==================== -->
    <Style TargetType="TextElement">
        <Setter Property="FontFamily" Value="SF Pro Display, Segoe UI Variable Display, Segoe UI, Microsoft YaHei, sans-serif"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="SF Pro Display, Segoe UI Variable Display, Segoe UI, Microsoft YaHei, sans-serif"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>
    <Style TargetType="Control">
        <Setter Property="FontFamily" Value="SF Pro Display, Segoe UI Variable Display, Segoe UI, Microsoft YaHei, sans-serif"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>
    <Style x:Key="SubtitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14.5"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>
    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>
    <Style x:Key="SmallText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
    </Style>
    <Style x:Key="MonoText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="SF Mono, Cascadia Code, JetBrains Mono, Consolas, monospace"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- ==================== 6. 卡片样式 ==================== -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource CornerLg}"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- 工具条卡片：顶部操作区统一容器 -->
    <Style x:Key="ToolbarBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource CornerLg}"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- 可交互结果卡：悬停抬升 + 绽放边 + 轻阴影，选中加粗描边 -->
    <Style x:Key="InteractiveCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource CornerLg}"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform Y="0"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource HoverCardBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                <Setter Property="Effect" Value="{StaticResource ShadowMd}"/>
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                From="0" To="-1.5"
                                Duration="0:0:0.18">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                To="0"
                                Duration="0:0:0.18">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                         Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Effect" Value="{StaticResource ShadowCard}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 可选中卡片列表项：左侧品牌指示条 + 悬停/选中态（文档库等列表） -->
    <Style x:Key="SelectableCardItemStyle" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualStyleCompact}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="ActiveIndicator"
                                Width="3"
                                CornerRadius="4"
                                Background="{DynamicResource PrimaryBrush}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                Margin="0,6"
                                Opacity="0"
                                Visibility="Collapsed"/>
                        <Border x:Name="Card"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,10"
                                Margin="6,0,0,0"
                                SnapsToDevicePixels="True"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform Y="0"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource HoverCardBrush}"/>
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource PrimarySubtleBrush}"/>
                            <Setter TargetName="Card" Property="Effect" Value="{StaticResource ShadowCard}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="Card"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                            From="0" To="-1"
                                            Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="Card"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                            To="0"
                                            Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource HoverCardBrush}"/>
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="ActiveIndicator" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="ActiveIndicator"
                                            Storyboard.TargetProperty="Opacity"
                                            From="0" To="1"
                                            Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 内容区卡片：列表/详情/图表等 -->
    <Style x:Key="SectionCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource CornerLg}"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- 统计/指标卡片：概览数字网格 -->
    <Style x:Key="StatCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource CornerLg}"/>
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ==================== 7. 按钮样式 ==================== -->
    <!-- Primary：填充主色 + 悬停外绽品牌光晕 + 按压 0.97 微缩 -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextInverseBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="24,10"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="MinWidth" Value="80"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Margin="-6">
                        <!-- 外绽光晕：悬停从中心展开的品牌淡底 -->
                        <Border x:Name="Bloom"
                                Background="{StaticResource PrimaryLightBrush}"
                                CornerRadius="12"
                                Margin="1"
                                Opacity="0"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="0.55" ScaleY="0.55"/>
                            </Border.RenderTransform>
                        </Border>
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                Margin="6"
                                SnapsToDevicePixels="True"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                            <Setter TargetName="Root" Property="Effect" Value="{StaticResource ShadowButtonHover}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="Bloom"
                                            Storyboard.TargetProperty="Opacity"
                                            From="0" To="0.9"
                                            Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation
                                            Storyboard.TargetName="Bloom"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                            From="0.55" To="1"
                                            Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation
                                            Storyboard.TargetName="Bloom"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                            From="0.55" To="1"
                                            Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="Bloom"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation
                                            Storyboard.TargetName="Bloom"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                            To="0.55"
                                            Duration="0:0:0.12"/>
                                        <DoubleAnimation
                                            Storyboard.TargetName="Bloom"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                            To="0.55"
                                            Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                            <Setter TargetName="Root" Property="Effect" Value="{StaticResource ShadowButtonHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource PrimaryActiveBrush}"/>
                            <Setter TargetName="Root" Property="Effect" Value="{x:Null}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="Root"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                            To="0.97"
                                            Duration="0:0:0.12"/>
                                        <DoubleAnimation
                                            Storyboard.TargetName="Root"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                            To="0.97"
                                            Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="Root"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                            To="1"
                                            Duration="0:0:0.12"/>
                                        <DoubleAnimation
                                            Storyboard.TargetName="Root"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                            To="1"
                                            Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource PrimarySubtleBrush}"/>
                            <Setter TargetName="Root" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="MinWidth" Value="60"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bloom"
                                Background="{StaticResource PrimaryLightBrush}"
                                CornerRadius="8"
                                Opacity="0"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="0.7" ScaleY="0.7"/>
                            </Border.RenderTransform>
                        </Border>
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="Bloom"
                                            Storyboard.TargetProperty="Opacity"
                                            From="0" To="0.85"
                                            Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation
                                            Storyboard.TargetName="Bloom"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                            From="0.7" To="1"
                                            Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation
                                            Storyboard.TargetName="Bloom"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                            From="0.7" To="1"
                                            Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bloom" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="Bloom" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.7" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="Bloom" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.7" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource BorderBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.97" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.97" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.42"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

