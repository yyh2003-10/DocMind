<Application x:Class="DocMind.App"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:local="clr-namespace:DocMind"
xmlns:helpers="clr-namespace:DocMind.Helpers">
    <Application.Resources>
        <ResourceDictionary>
            <helpers:LogLevelToBrushConverter x:Key="LogLevelToBrush"/>
            <helpers:BoolInvertConverter x:Key="BoolInvertConverter"/>
            <helpers:NullToVisibilityConverter x:Key="NullToVis"/>
            <helpers:BoolToVisibilityInvertConverter x:Key="InvertBoolVis"/>
            <helpers:ZeroToVisibilityConverter x:Key="ZeroToVis"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
