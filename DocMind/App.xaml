<Application x:Class="DocMind.App"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:local="clr-namespace:DocMind"
xmlns:helpers="clr-namespace:DocMind.Helpers">
    <Application.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
            <BooleanToVisibilityConverter x:Key="B2V"/>
            <helpers:LogLevelToBrushConverter x:Key="LogLevelToBrush"/>
            <helpers:BoolInvertConverter x:Key="BoolInvertConverter"/>
            <helpers:NullToVisibilityConverter x:Key="NullToVis"/>
            <helpers:NullToVisibilityConverter x:Key="StringToVis"/>
            <helpers:BoolToVisibilityInvertConverter x:Key="InvertBoolVis"/>
            <helpers:ZeroToVisibilityConverter x:Key="ZeroToVis"/>
            <helpers:SourceHighlightConverter x:Key="SourceHighlight"/>
            <ResourceDictionary.MergedDictionaries>
                <!-- Icons 必须先于 Theme 合并：Theme 内的样式（如 EmptyStateIconStyle）
                     以 StaticResource BasedOn 引用 Icons 里的 IconMdStyle，
                     合并顺序颠倒会在解析 Theme 时抛“无法找到资源”XamlParseException -->
                <ResourceDictionary Source="Styles/Icons.xaml"/>
                <ResourceDictionary Source="Styles/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
