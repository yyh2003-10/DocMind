<UserControl x:Class="DocMind.Views.ConvertView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DocMind.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 输入选择 -->
            <RowDefinition Height="Auto"/>   <!-- 输出 + 格式 -->
            <RowDefinition Height="Auto"/>   <!-- 忙碌进度条 -->
            <RowDefinition Height="*"/>      <!-- 预览区 -->
        </Grid.RowDefinitions>

        <!-- ===== 输入选择卡片 ===== -->
        <Border Grid.Row="0"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="16,14"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="源文件:"
                           Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>

                <TextBox Grid.Column="1"
                         Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="选择要转换的源文件（PDF / DOCX / XLSX / PPTX / MD / HTML …）"
                         Style="{StaticResource ReadOnlyTextBoxStyle}"
                         VerticalContentAlignment="Center"
                         MinHeight="36"/>

                <Button Grid.Column="2"
                        Content="📁 选择文件…"
                        Command="{Binding PickInputCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Padding="14,6"
                        MinHeight="36"
                        Margin="12,0,0,0"/>
            </Grid>
        </Border>

        <!-- ===== 输出 + 格式卡片 ===== -->
        <Border Grid.Row="1"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="16,14"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 第一行：输出位置 -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="输出位置:"
                               Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>

                    <TextBox Grid.Column="1"
                             Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="输出文件位置（留空仅预览，不落盘）"
                             VerticalContentAlignment="Center"
                             MinHeight="36"/>

                    <Button Grid.Column="2"
                            Content="另存为…"
                            Command="{Binding PickOutputCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="14,6"
                            MinHeight="36"
                            Margin="12,0,0,0"/>
                </Grid>

                <!-- 第二行：目标格式 + 操作按钮 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="目标格式:"
                               Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding SupportedFormats}"
                              SelectedItem="{Binding Format}"
                              VerticalAlignment="Center"/>

                    <!-- 右侧操作按钮组 -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button Content="⚡ 开始转换"
                                Command="{Binding ConvertCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="20,6"
                                MinHeight="36"
                                Margin="0,0,8,0"/>
                        <Button Content="重置"
                                Command="{Binding ResetCommand}"
                                Style="{StaticResource TextButtonStyle}"
                                Padding="12,6"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ===== 忙碌进度条（转换进行中时显示） ===== -->
        <Border Grid.Row="2"
                Background="{StaticResource CardBrush}"
                CornerRadius="10"
                Padding="12,8"
                Margin="0,0,0,12"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ProgressBar Grid.Column="0"
                             IsIndeterminate="True"
                             MinHeight="8"
                             VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="转换中…"
                           Style="{StaticResource CaptionText}"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ===== 预览区 ===== -->
        <Border Grid.Row="3"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="预览"
                               Style="{StaticResource SubtitleText}"
                               DockPanel.Dock="Left"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="📥 一键导入知识库"
                                Command="{Binding ImportToKnowledgeBaseCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="10,3"
                                Margin="0,0,8,0"
                                Visibility="{Binding CanImportToKnowledgeBase, Converter={StaticResource BoolToVis}}"
                                ToolTip="将转换落盘后的文件直接载入【导入】页面加入知识库"/>
                        <Border Background="{StaticResource SurfaceBrush}"
                                CornerRadius="4"
                                Padding="8,2"
                                Visibility="{Binding HasInputPath, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource SmallText}">
                                <Run Text="{Binding Format, Mode=OneWay, StringFormat={}.{0}}"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </DockPanel>

                <Border Background="{StaticResource SurfaceBrush}"
                        CornerRadius="6"
                        Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding PreviewContent, Mode=OneWay}"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 TextWrapping="Wrap"
                                 FontFamily="Cascadia Code, Consolas, monospace"
                                 FontSize="13"
                                 Background="Transparent"/>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
