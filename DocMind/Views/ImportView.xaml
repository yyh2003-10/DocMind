<UserControl x:Class="DocMind.Views.ImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DocMind.ViewModels"
             xmlns:m="clr-namespace:DocMind.Models"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             AllowDrop="True"
             Drop="View_Drop"
             DragOver="View_DragOver">

    <Grid Margin="{StaticResource PageContentMargin}">
        <Grid.RowDefinitions>
            <!-- 页首 -->
            <RowDefinition Height="Auto"/>
            <!-- 路径选择 + 拖拽区域 -->
            <RowDefinition Height="Auto"/>
            <!-- 选中项信息 + 预览 -->
            <RowDefinition Height="Auto"/>
            <!-- 进度条 -->
            <RowDefinition Height="Auto"/>
            <!-- 结果三栏 -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== 页首：标题 + 副文案 + 右侧主操作区 ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Style="{StaticResource PageHeaderTextAreaStyle}"
                       HorizontalAlignment="Left" MaxWidth="520" VerticalAlignment="Center">
                <TextBlock Text="导入文档" Style="{StaticResource PageHeaderText}"/>
                <TextBlock Text="本地离线解析、切片与向量嵌入，支持拖拽文件或目录"
                           Style="{StaticResource PageHeaderCaptionText}"
                           ToolTip="本地离线解析、切片与向量嵌入，支持拖拽文件或目录"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Command="{Binding ImportCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    VerticalAlignment="Center"
                    Padding="20,6"
                    MinHeight="36"
                    ToolTip="开始导入（Ctrl+I）">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconUpload}"
                          Style="{StaticResource IconSmStyle}"
                          Margin="0,0,8,0"/>
                    <TextBlock Text="开始导入"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ===== 路径选择卡片 ===== -->
        <Border Grid.Row="1" Style="{StaticResource ToolbarBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 第一行：文件/目录路径选择 + 目标分组下拉选择/新建 -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="230"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding SelectedPath, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="拖拽文件/文件夹到此处，或点击「选择…」"
                             Style="{StaticResource ReadOnlyTextBoxStyle}"
                             VerticalContentAlignment="Center"
                             Margin="0,0,8,0"/>

                    <Button Grid.Column="1"
                            Command="{Binding PickPathCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="14,6"
                            MinHeight="36"
                            Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconUpload}" Style="{StaticResource IconSmStyle}" Margin="0,0,6,0"/>
                            <TextBlock Text="选择…"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Grid.Column="2"
                               Text="目标分组:"
                               Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <Grid Grid.Column="3">
                        <!-- 下拉选择已有知识库分组（含「＋ 新建分组…」哨兵项） -->
                        <ComboBox ItemsSource="{Binding AvailableCollections}"
                                  SelectedItem="{Binding SelectedCollectionItem, UpdateSourceTrigger=PropertyChanged}"
                                  Visibility="{Binding IsCreatingCollection, Converter={StaticResource InvertBoolVis}}"
                                  ToolTip="选择导入目标知识库分组，或选「＋ 新建分组…」创建新分组"
                                  VerticalContentAlignment="Center"/>

                        <!-- 内联新建分组：输入名称 + 确认/取消 -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsCreatingCollection, Converter={StaticResource BoolToVis}}">
                            <TextBox Text="{Binding NewCollectionName, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="输入新分组名称（导入时后端会自动创建不存在的分组）"
                                     VerticalContentAlignment="Center"
                                     Width="140"
                                     KeyDown="NewCollectionName_KeyDown"/>
                            <Button Command="{Binding ConfirmCreateCollectionCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="8,4"
                                    MinWidth="32"
                                    MinHeight="36"
                                    Margin="4,0,0,0"
                                    ToolTip="确认新建该分组">
                                <Path Data="{StaticResource IconCheck}" Style="{StaticResource IconSmStyle}" Stroke="{DynamicResource SuccessBrush}"/>
                            </Button>
                            <Button Command="{Binding CancelCreateCollectionCommand}"
                                    Style="{StaticResource TextButtonStyle}"
                                    Padding="8,4"
                                    MinWidth="32"
                                    MinHeight="36"
                                    Margin="2,0,0,0"
                                    ToolTip="取消新建">
                                <Path Data="{StaticResource IconClose}" Style="{StaticResource IconSmStyle}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- 第二行：导入选项 + 批量操作按钮组 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0"
                              Content="递归子目录"
                              IsChecked="{Binding Recursive}"
                              Margin="0,0,20,0"
                              VerticalAlignment="Center"/>

                    <CheckBox Grid.Column="1"
                              Content="覆盖已有数据（强制重新摄入）"
                              IsChecked="{Binding Force}"
                              ToolTip="强制重新摄入已存在的文件（覆盖旧向量与分块数据）"
                              Margin="0,0,16,0"
                              VerticalAlignment="Center"/>

                    <!-- 右侧操作按钮组（主操作「开始导入」已上移至页首右侧） -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button Content="取消"
                                Command="{Binding CancelImportCommand}"
                                Style="{StaticResource DangerButtonStyle}"
                                Padding="16,6"
                                MinHeight="36"
                                Margin="0,0,8,0"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

                        <Button Content="重置"
                                Command="{Binding ResetCommand}"
                                Style="{StaticResource TextButtonStyle}"
                                Padding="12,6"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ===== 选中项信息 + 预览（选择/拖拽后显示） ===== -->
        <Border Grid.Row="2"
                Visibility="{Binding HasSelectedPath, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerMd}"
                Padding="16,10"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{Binding SelectedPathSummary, Mode=OneWay}"
                           Style="{StaticResource SmallText}"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding SelectedPathPreview, Mode=OneWay}"
                           Style="{StaticResource CaptionText}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap"
                           MaxHeight="96"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- ===== 进度条 ===== -->
        <Border Grid.Row="3"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="{StaticResource CornerMd}"
                Padding="12,8"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ProgressBar Grid.Column="0"
                             Value="{Binding ProgressPercent, Mode=OneWay}"
                             Maximum="100"
                             MinHeight="8"
                             VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding ProgressPercent, Mode=OneWay, StringFormat={}{0}%}"
                           Style="{StaticResource CaptionText}"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 空态拖拽引导（IsBusy=False 且 HasResults=False 时显示） -->
        <Border x:Name="DropZone"
                Grid.Row="4"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="2"
                CornerRadius="{StaticResource CornerLg}"
                Background="{DynamicResource SurfaceBrush}"
                DragEnter="DropZone_DragEnter"
                DragLeave="DropZone_DragLeave"
                Drop="View_Drop">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsBusy}" Value="False"/>
                                <Condition Binding="{Binding HasResults}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="64" Height="64"
                        Background="{DynamicResource PrimaryLightBrush}"
                        CornerRadius="{StaticResource CornerPill}"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,12">
                    <Path Data="{StaticResource IconUpload}" Style="{StaticResource IconSmStyle}" Width="28" Height="28" Stroke="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="拖拽文件或文件夹到此处"
                           Style="{StaticResource SubtitleText}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4"/>
                <TextBlock Text="或点击上方「选择…」浏览"
                           Style="{StaticResource CaptionText}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ===== 正在导入中动态看板（IsBusy=True 时显示，彻底消除白屏与空态误导） ===== -->
        <Border Grid.Row="4"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerLg}"
                Background="{DynamicResource CardBrush}"
                Padding="32,24">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 动态标题与处理步骤 -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Path Data="{StaticResource IconBolt}" Style="{StaticResource IconSmStyle}" Stroke="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="正在执行知识库导入与本地索引…"
                                   FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding CurrentProcessingItem, Mode=OneWay}"
                               Style="{StaticResource BodyText}"
                               Foreground="{DynamicResource PrimaryBrush}"
                               HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <!-- 主进度条与百分比 -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar Grid.Column="0"
                                 Value="{Binding ProgressPercent, Mode=OneWay}"
                                 Maximum="100"
                                 Height="12"
                                 VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding ProgressPercent, Mode=OneWay, StringFormat={}{0}%}"
                               Style="{StaticResource SubtitleText}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryBrush}"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- 耗时统计与后端状态 -->
                <DockPanel Grid.Row="2" Margin="0,0,0,20">
                    <TextBlock Text="{Binding ElapsedTimeText, Mode=OneWay}"
                               Style="{StaticResource CaptionText}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               DockPanel.Dock="Left"/>
                    <TextBlock Text="{Binding StatusMessage, Mode=OneWay}"
                               Style="{StaticResource CaptionText}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Right"
                               DockPanel.Dock="Right"/>
                </DockPanel>

                <!-- 取消按钮 -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Button Command="{Binding CancelImportCommand}"
                            Style="{StaticResource DangerButtonStyle}"
                            Padding="16,6">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconClose}" Style="{StaticResource IconSmStyle}" Margin="0,0,6,0"/>
                            <TextBlock Text="取消本次导入"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 本地离线说明提示 -->
                <TextBlock Grid.Row="4"
                           Text="提示：文档解析、切片与 ONNX 向量嵌入均在本地离线计算，请稍候…"
                           Style="{StaticResource SmallText}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 结果区：健康摘要 + 三栏列表 -->
        <DockPanel Grid.Row="4">
        <!-- 导入健康摘要（完成后，顶部） -->
        <Border DockPanel.Dock="Top"
                Visibility="{Binding HasHealthSummary, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerLg}"
                Padding="14,12"
                Margin="0,0,0,12">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="导入健康"
                               FontWeight="SemiBold"
                               DockPanel.Dock="Left"/>
                    <TextBlock Text="{Binding HealthSummaryText, Mode=OneWay}"
                               Style="{StaticResource CaptionText}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Right"/>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding HealthWarnings}"
                              Margin="0,8,0,0"
                              Visibility="{Binding HasHealthWarnings, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       Style="{StaticResource SmallText}"
                                       Foreground="{DynamicResource WarningBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button HorizontalAlignment="Left"
                        Margin="0,10,0,0"
                        Padding="12,6"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Visibility="{Binding HasSuggestQuery, Converter={StaticResource BoolToVis}}"
                        Command="{Binding CopySuggestQueryCommand}"
                        ToolTip="把建议问题复制到剪贴板，去「对话」页试问一句">
                    <TextBlock>
                        <Run Text="试问一句："/><Run Text="{Binding SuggestQuery, Mode=OneWay}"/>
                    </TextBlock>
                </Button>
            </StackPanel>
        </Border>

        <!-- 结果三栏（IsBusy=False 且 HasResults=True 时显示） -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsBusy}" Value="False"/>
                                <Condition Binding="{Binding HasResults}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 导入成功 -->
            <DockPanel Grid.Column="0" Margin="0,0,6,0">
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource SuccessLightBrush}"
                        CornerRadius="{StaticResource CornerMd}"
                        Padding="12,8"
                        Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconCheck}" Style="{StaticResource IconSmStyle}" Stroke="{DynamicResource SuccessBrush}" Margin="0,0,8,0"/>
                        <TextBlock Style="{StaticResource SubtitleText}"
                                   Foreground="{DynamicResource SuccessBrush}">
                            <Run Text="导入成功 ("/>
                            <Run Text="{Binding Results.Count, Mode=OneWay}"/>
                            <Run Text=")"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding Results}" BorderThickness="1"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.CanContentScroll="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:IngestResult}">
                            <StackPanel Margin="4,4">
                                <TextBlock Text="{Binding Source, Mode=OneWay}"
                                           FontWeight="SemiBold"
                                           Style="{StaticResource BodyText}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Style="{StaticResource SmallText}">
                                        <Run Text="chunks "/><Run Text="{Binding ChunkCount, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource SmallText}" Margin="12,0,0,0">
                                        <Run Text="size "/><Run Text="{Binding SizeBytes, Mode=OneWay, StringFormat={}{0:N0} B}"/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource SmallText}" Margin="12,0,0,0"
                                               Foreground="{DynamicResource TextMutedBrush}">
                                        <Run Text="{Binding Format, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                            <!-- AI 自动整理结果（tags / summary / 归类分组） -->
                                <StackPanel Margin="0,6,0,0" Visibility="{Binding HasCuration, Converter={StaticResource BoolToVisConverter}}">
                                    <Border Background="{DynamicResource PrimaryLightBrush}"
                                            CornerRadius="{StaticResource CornerMd}" Padding="8,6" Margin="0,0,0,4">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                <Path Data="{StaticResource IconAi}" Style="{StaticResource IconSmStyle}" Stroke="{DynamicResource PrimaryBrush}" Margin="0,0,6,0"/>
                                                <TextBlock Text="AI 整理" Style="{StaticResource SmallText}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryBrush}"/>
                                            </StackPanel>
                                            <!-- 标签 -->
                                            <ItemsControl ItemsSource="{Binding CurationTags}" Margin="0,0,0,4">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource SurfaceBrush}"
                                                                CornerRadius="{StaticResource CornerSm}" Padding="6,2" Margin="0,0,4,2">
                                                            <TextBlock Text="{Binding}" Style="{StaticResource SmallText}"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <!-- 摘要 -->
                                            <TextBlock Text="{Binding CurationSummary}" Style="{StaticResource SmallText}"
                                                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Visibility="{Binding CurationSummary, Converter={StaticResource StringToVis}}"/>
                                            <!-- 归类分组 -->
                                            <TextBlock Style="{StaticResource SmallText}" Margin="0,2,0,0"
                                                       Visibility="{Binding CurationCollection, Converter={StaticResource StringToVis}}">
                                                <Run Text="归类到: "/><Run Text="{Binding CurationCollection}" FontWeight="SemiBold"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- 跳过 -->
            <DockPanel Grid.Column="1" Margin="6,0,6,0">
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="{StaticResource CornerMd}"
                        Padding="12,8"
                        Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconSkip}" Style="{StaticResource IconSmStyle}" Margin="0,0,8,0"/>
                        <TextBlock Style="{StaticResource SubtitleText}">
                            <Run Text="跳过 ("/>
                            <Run Text="{Binding Skipped.Count, Mode=OneWay}"/>
                            <Run Text=")"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding Skipped}" BorderThickness="1"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.CanContentScroll="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       Style="{StaticResource CaptionText}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="4,4"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- 失败 -->
            <DockPanel Grid.Column="2" Margin="6,0,0,0">
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource DangerLightBrush}"
                        CornerRadius="{StaticResource CornerMd}"
                        Padding="12,8"
                        Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconCross}" Style="{StaticResource IconSmStyle}" Stroke="{DynamicResource DangerBrush}" Margin="0,0,8,0"/>
                        <TextBlock Style="{StaticResource SubtitleText}"
                                   Foreground="{DynamicResource DangerBrush}">
                            <Run Text="失败 ("/>
                            <Run Text="{Binding Failed.Count, Mode=OneWay}"/>
                            <Run Text=")"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding Failed}" BorderThickness="1"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.CanContentScroll="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{DynamicResource DangerBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="4,4"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
        </DockPanel>
    </Grid>
</UserControl>
