<UserControl x:Class="DocMind.Views.ImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DocMind.ViewModels"
             xmlns:m="clr-namespace:DocMind.Models"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             AllowDrop="True"
             Drop="View_Drop"
             DragOver="View_DragOver">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <!-- 路径选择 + 拖拽区域 -->
            <RowDefinition Height="Auto"/>
            <!-- 选中项信息 + 预览 -->
            <RowDefinition Height="Auto"/>
            <!-- 进度条 -->
            <RowDefinition Height="Auto"/>
            <!-- 结果三栏 -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== 路径选择卡片 ===== -->
        <Border Grid.Row="0"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="16,14"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 第一行：文件/目录路径选择 + 目标集合名称 -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding SelectedPath, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="拖拽文件/文件夹到此处，或点击「选择…」"
                             Style="{StaticResource ReadOnlyTextBoxStyle}"
                             VerticalContentAlignment="Center"
                             Margin="0,0,8,0"/>

                    <Button Grid.Column="1"
                            Content="📁 选择…"
                            Command="{Binding PickPathCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="14,6"
                            MinHeight="36"
                            Margin="0,0,16,0"/>

                    <TextBlock Grid.Column="2"
                               Text="目标集合:"
                               Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <TextBox Grid.Column="3"
                             Text="{Binding Collection, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="目标集合名称（默认 default）"
                             VerticalContentAlignment="Center"/>
                </Grid>

                <!-- 第二行：导入选项 + 批量操作按钮组 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0"
                              Content="递归子目录"
                              IsChecked="{Binding Recursive}"
                              Margin="0,0,20,0"
                              VerticalAlignment="Center"/>

                    <CheckBox Grid.Column="1"
                              Content="覆盖已有数据（强制重新摄入）"
                              IsChecked="{Binding Force}"
                              ToolTip="强制重新摄入已存在的文件（覆盖旧向量与分块数据）"
                              Margin="0,0,16,0"
                              VerticalAlignment="Center"/>

                    <!-- 右侧操作按钮组 -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button Content="开始导入"
                                Command="{Binding ImportCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="20,6"
                                MinHeight="36"
                                Margin="0,0,8,0"/>

                        <Button Content="取消"
                                Command="{Binding CancelImportCommand}"
                                Style="{StaticResource DangerButtonStyle}"
                                Padding="16,6"
                                MinHeight="36"
                                Margin="0,0,8,0"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

                        <Button Content="重置"
                                Command="{Binding ResetCommand}"
                                Style="{StaticResource TextButtonStyle}"
                                Padding="12,6"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ===== 选中项信息 + 预览（选择/拖拽后显示） ===== -->
        <Border Grid.Row="1"
                Visibility="{Binding HasSelectedPath, Converter={StaticResource BoolToVis}}"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,10"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{Binding SelectedPathSummary, Mode=OneWay}"
                           Style="{StaticResource SmallText}"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding SelectedPathPreview, Mode=OneWay}"
                           Style="{StaticResource CaptionText}"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextWrapping="Wrap"
                           MaxHeight="96"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- ===== 进度条 ===== -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="8"
                Padding="12,8"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ProgressBar Grid.Column="0"
                             Value="{Binding ProgressPercent, Mode=OneWay}"
                             Maximum="100"
                             MinHeight="8"
                             VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding ProgressPercent, Mode=OneWay, StringFormat={}{0}%}"
                           Style="{StaticResource CaptionText}"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 空态拖拽引导（HasResults=false 时显示） -->
        <Border Grid.Row="3"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="2"
                CornerRadius="12"
                Background="{StaticResource SurfaceBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasResults}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="📂" FontSize="48" HorizontalAlignment="Center"/>
                <TextBlock Text="拖拽文件或文件夹到此处"
                           Style="{StaticResource SubtitleText}"
                           Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,4"/>
                <TextBlock Text="或点击「选择」按钮浏览"
                           Style="{StaticResource CaptionText}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 结果三栏（HasResults=true 时显示） -->
        <Grid Grid.Row="3">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasResults}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 导入成功 -->
            <DockPanel Grid.Column="0" Margin="0,0,6,0">
                <Border DockPanel.Dock="Top"
                        Background="{StaticResource SuccessLightBrush}"
                        CornerRadius="8"
                        Padding="12,8"
                        Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✓" Foreground="{StaticResource SuccessBrush}"
                                   FontSize="18" FontWeight="Bold" Margin="0,0,8,0"/>
                        <TextBlock Style="{StaticResource SubtitleText}"
                                   Foreground="{StaticResource SuccessBrush}">
                            <Run Text="导入成功 ("/>
                            <Run Text="{Binding Results.Count, Mode=OneWay}"/>
                            <Run Text=")"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding Results}" BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:IngestResult}">
                            <StackPanel Margin="4,4">
                                <TextBlock Text="{Binding Source, Mode=OneWay}"
                                           FontWeight="SemiBold"
                                           Style="{StaticResource BodyText}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Style="{StaticResource SmallText}">
                                        <Run Text="chunks "/><Run Text="{Binding ChunkCount, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource SmallText}" Margin="12,0,0,0">
                                        <Run Text="size "/><Run Text="{Binding SizeBytes, Mode=OneWay, StringFormat={}{0:N0} B}"/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource SmallText}" Margin="12,0,0,0"
                                               Foreground="{StaticResource TextMutedBrush}">
                                        <Run Text="{Binding Format, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- 跳过 -->
            <DockPanel Grid.Column="1" Margin="6,0,6,0">
                <Border DockPanel.Dock="Top"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="8"
                        Padding="12,8"
                        Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⏭" FontSize="18" Margin="0,0,8,0"/>
                        <TextBlock Style="{StaticResource SubtitleText}">
                            <Run Text="跳过 ("/>
                            <Run Text="{Binding Skipped.Count, Mode=OneWay}"/>
                            <Run Text=")"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding Skipped}" BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       Style="{StaticResource CaptionText}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="4,4"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- 失败 -->
            <DockPanel Grid.Column="2" Margin="6,0,0,0">
                <Border DockPanel.Dock="Top"
                        Background="{StaticResource DangerLightBrush}"
                        CornerRadius="8"
                        Padding="12,8"
                        Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✗" Foreground="{StaticResource DangerBrush}"
                                   FontSize="18" FontWeight="Bold" Margin="0,0,8,0"/>
                        <TextBlock Style="{StaticResource SubtitleText}"
                                   Foreground="{StaticResource DangerBrush}">
                            <Run Text="失败 ("/>
                            <Run Text="{Binding Failed.Count, Mode=OneWay}"/>
                            <Run Text=")"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding Failed}" BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource DangerBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="4,4"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
