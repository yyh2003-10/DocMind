<UserControl x:Class="DocMind.Views.QualityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DocMind.ViewModels"
             xmlns:m="clr-namespace:DocMind.Models"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,10,12">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- 工具条 (Row 0) -->
                <RowDefinition Height="Auto"/>   <!-- 概览卡片 (Row 1) -->
                <RowDefinition Height="Auto"/>   <!-- 图表区 (Row 2) -->
                <RowDefinition Height="Auto"/>   <!-- 分布 + 警告 (Row 3) -->
            </Grid.RowDefinitions>

            <!-- ===== 工具条 ===== -->
            <Border Grid.Row="0"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14,12"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="集合过滤:"
                               Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <TextBox Grid.Column="1"
                             Text="{Binding Collection, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="集合名（可选，留空=全部集合）。可按分组过滤统计指标"
                             VerticalContentAlignment="Center"/>

                    <Button Grid.Column="3"
                            Content="🔄 刷新看板"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="16,6"
                            MinHeight="36"/>
                </Grid>
            </Border>

            <!-- ===== 概览卡片 ===== -->
            <UniformGrid Grid.Row="1" Rows="1" Columns="4"
                         Margin="0,0,0,16">

                <!-- 文档总数 -->
                <Border Padding="16,14" Margin="0,0,10,0"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📄" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock Text="文档总数" Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Stats.TotalDocuments, Mode=OneWay}"
                                   Style="{StaticResource TitleText}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Chunk 总数 -->
                <Border Padding="16,14" Margin="0,0,10,0"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧩" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Chunk 总数" Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Stats.TotalChunks, Mode=OneWay}"
                                   Style="{StaticResource TitleText}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 格式分布 -->
                <Border Padding="16,14" Margin="0,0,10,0"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔁" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock Text="格式分布" Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Report.FormatDistribution.Count, Mode=OneWay, StringFormat={}{0} 种}"
                                   Style="{StaticResource TitleText}"
                                   Foreground="{StaticResource WarningBrush}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 质量警告 -->
                <Border Padding="16,14" Margin="0"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock Text="质量警告" Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Report.Warnings.Count, Mode=OneWay}"
                                   Style="{StaticResource TitleText}"
                                   Foreground="{StaticResource DangerBrush}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ===== 图表区：格式分布饼图 + 集合文档数柱状图 ===== -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 格式分布饼图 -->
                <Border Grid.Column="0"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="格式分布" FontSize="15" FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>
                        <lvc:PieChart Series="{Binding FormatSeries}"
                                      Height="210"
                                      TooltipPosition="Top"/>
                    </DockPanel>
                </Border>

                <!-- 集合文档数柱状图 -->
                <Border Grid.Column="2"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="集合文档数" FontSize="15" FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>
                        <lvc:CartesianChart Series="{Binding CollectionSeries}"
                                            Height="210"
                                            TooltipPosition="Top"/>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ===== 集合分布 + 警告 ===== -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 集合分布 -->
                <Border Grid.Column="0"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16"
                        MinHeight="220">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="集合分布"
                                   Style="{StaticResource SubtitleText}"
                                   Margin="0,0,0,12"/>

                        <ListBox ItemsSource="{Binding Collections}"
                                 BorderThickness="0"
                                 MaxHeight="300"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:CollectionStats}">
                                    <Border Background="{StaticResource SurfaceBrush}"
                                            CornerRadius="6"
                                            Padding="10,8"
                                            Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0"
                                                       Text="{Binding Name, Mode=OneWay}"
                                                       FontWeight="SemiBold"
                                                       Style="{StaticResource BodyText}"/>

                                            <StackPanel Grid.Row="1" Orientation="Horizontal"
                                                        Margin="0,4,0,0">
                                                <TextBlock Style="{StaticResource SmallText}">
                                                    <Run Text="文档 " FontWeight="SemiBold"/>
                                                    <Run Text="{Binding Documents, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource SmallText}" Margin="16,0,0,0">
                                                    <Run Text="Chunks " FontWeight="SemiBold"/>
                                                    <Run Text="{Binding Chunks, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource SmallText}" Margin="16,0,0,0">
                                                    <Run Text="{Binding SizeBytes, Mode=OneWay, StringFormat={}{0:N0} B}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- 警告 -->
                <Border Grid.Column="2"
                        Background="{StaticResource DangerLightBrush}"
                        BorderBrush="{StaticResource DangerBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14"
                        MinHeight="220">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="⚠" FontSize="16" Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="质量警告"
                                       Style="{StaticResource SubtitleText}"
                                       Foreground="{StaticResource DangerBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <ListBox ItemsSource="{Binding Warnings}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 MaxHeight="300"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardBrush}"
                                            BorderBrush="{StaticResource DangerBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,8"
                                            Margin="0,0,0,6">
                                        <TextBlock Text="{Binding}"
                                                   Style="{StaticResource CaptionText}"
                                                   Foreground="{StaticResource DangerBrush}"
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 暂无警告空态 -->
                        <TextBlock Text="暂无质量警告，数据状态良好 ✨"
                                   Style="{StaticResource SmallText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,20,0,0"
                                   Visibility="{Binding HasWarnings, Converter={StaticResource InvertBoolVis}}"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
