<UserControl x:Class="DocMind.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	             xmlns:vm="clr-namespace:DocMind.ViewModels"
	             xmlns:helpers="clr-namespace:DocMind.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <!-- 卡片区段的统一图标样式 -->
    <UserControl.Resources>
        <Style x:Key="SectionIcon" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 设置内容（可滚动） ===== -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      Padding="0,0,10,12">
            <StackPanel MaxWidth="760">
                <!-- 页面标题 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="设置" Style="{StaticResource TitleText}"/>
                    <TextBlock Text="配置客户端与后端行为"
                               Style="{StaticResource CaptionText}"
                               VerticalAlignment="Bottom"
                               Margin="12,0,0,4"/>
                </StackPanel>

                <!-- ===== 网络连接 ===== -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="🌐" Style="{StaticResource SectionIcon}"/>
                            <TextBlock Text="后端连接" Style="{StaticResource SubtitleText}"/>
                        </StackPanel>

                        <TextBlock Text="后端地址" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding BackendUrl, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="例如 http://127.0.0.1:8765"
                                 Margin="0,0,0,16"/>

                        <TextBlock Text="启动超时（秒）" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding StartupTimeoutSec, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="后端进程启动等待时间"
                                 Margin="0,0,0,16"/>

                        <Button Content="🔄 重启后端服务"
                                Command="{Binding RestartBackendCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Left"
                                Padding="12,6"
                                ToolTip="强力清理可能残留的旧进程，释放 8765 端口并重新拉起最新后端"/>
                    </StackPanel>
                </Border>

                <!-- ===== 性能 ===== -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="⚡" Style="{StaticResource SectionIcon}"/>
                            <TextBlock Text="性能" Style="{StaticResource SubtitleText}"/>
                        </StackPanel>

                        <TextBlock Text="任务轮询间隔（毫秒）" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding PollIntervalMs, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="100-10000ms，值越小实时性越高但负载越大"/>
                    </StackPanel>
                </Border>

                <!-- ===== 模型与分块 ===== -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="🧠" Style="{StaticResource SectionIcon}"/>
                            <TextBlock Text="模型与分块" Style="{StaticResource SubtitleText}"/>
                        </StackPanel>

                        <TextBlock Text="嵌入模型" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding SupportedEmbedModels}"
                                  SelectedItem="{Binding EmbedModel}"
                                  ToolTip="向量化用模型；更换模型后需在后端重启后到「文档库」页重建索引"
                                  Margin="0,0,0,12"/>

                        <TextBlock Text="本地模型目录（可选）" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding EmbedModelPath, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="填本地 ONNX 模型目录（含 model.onnx / model_optimized.onnx + tokenizer.json）；留空则用上面的模型联网下载"
                                 Margin="0,0,0,12"/>
                        <TextBlock Style="{StaticResource SmallText}"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   Margin="0,0,0,12">
                            留空 = 使用上方下拉的推荐模型（首次自动下载，之后用本地缓存）；填本地目录 = 完全离线使用自己的模型。
                        </TextBlock>

                        <TextBlock Style="{StaticResource SmallText}"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   Margin="0,0,0,12">
                            以下参数修改后重启客户端生效（注入后端环境变量），留空使用后端默认值。
                        </TextBlock>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="分块最大 token 数" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding ChunkMaxTokens, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="默认 1500；越大分块越粗"
                                         Margin="0,0,0,12"/>
                                <TextBlock Text="分块最小字符数" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding ChunkMinChars, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="默认 50；低于此长度的块被丢弃"
                                         Margin="0,0,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="分块重叠字符数" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding ChunkOverlapChars, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="默认 200；相邻块重叠量，越大上下文越连贯"
                                         Margin="0,0,0,12"/>
                                <TextBlock Text="分块最大字符数" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding ChunkMaxChars, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="默认 4000；单块字符上限"
                                         Margin="0,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== GPU 加速 ===== -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="🔌" Style="{StaticResource SectionIcon}"/>
                            <TextBlock Text="GPU 加速" Style="{StaticResource SubtitleText}"/>
                            <TextBlock Text="  ✓"
                                       Visibility="{Binding GpuWarning.GpuAvailable, Converter={StaticResource BoolToVis}}"
                                       Foreground="{StaticResource SuccessBrush}"
                                       FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="正在检测 GPU 环境..."
                                   Visibility="{Binding GpuWarning.IsDiagnosing, Converter={StaticResource BoolToVis}}"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>

                        <!-- 诊断完成后 -->
                        <StackPanel Visibility="{Binding GpuWarning.HasDiagnosis, Converter={StaticResource BoolToVis}}">
                            <TextBlock FontSize="12" Margin="0,0,0,4">
                                <Run Text="状态：" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Run Text="{Binding GpuWarning.GpuStatusText, Mode=OneWay}" FontWeight="SemiBold"
                                     Foreground="{Binding GpuWarning.GpuStatusBrush, Mode=OneWay}"/>
                            </TextBlock>

                            <TextBlock FontSize="12" Margin="0,0,0,4"
                                       Visibility="{Binding GpuWarning.GpuDeviceName, Converter={StaticResource NullToVis}}">
                                <Run Text="GPU 设备：" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Run Text="{Binding GpuWarning.GpuDeviceName, Mode=OneWay}"/>
                            </TextBlock>

                            <TextBlock FontSize="12" Margin="0,0,0,4"
                                       Visibility="{Binding GpuWarning.DriverInfo, Converter={StaticResource NullToVis}}">
                                <Run Text="驱动信息：" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Run Text="{Binding GpuWarning.DriverInfo, Mode=OneWay}"/>
                            </TextBlock>

                            <TextBlock FontSize="12" Margin="0,0,0,8"
                                       Visibility="{Binding GpuWarning.GpuAvailable, Converter={StaticResource InvertBoolVis}}">
                                <Run Text="CUDA 运行时：" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Run Text="{Binding GpuWarning.CudaRuntimeInfo, Mode=OneWay}"/>
                            </TextBlock>

                            <!-- 警告 -->
                            <ItemsControl ItemsSource="{Binding GpuWarning.Warnings}"
                                          Margin="0,0,0,8"
                                          Visibility="{Binding GpuWarning.Warnings.Count, Converter={StaticResource ZeroToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="11"
                                                   Foreground="{StaticResource WarningBrush}"
                                                   Margin="0,2" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 已启用 GPU 时的展开/收起按钮 -->
                            <Button Content="{Binding GpuWarning.AdvancedOptionsToggleText}"
                                    Command="{Binding GpuWarning.ToggleAdvancedOptionsCommand}"
                                    Visibility="{Binding GpuWarning.GpuAvailable, Converter={StaticResource BoolToVis}}"
                                    Style="{StaticResource TextButtonStyle}"
                                    HorizontalAlignment="Left" Margin="0,4,0,8"/>

                            <!-- 包列表与安装方案区域（未启用 GPU 或用户主动展开时显示） -->
                            <StackPanel Visibility="{Binding GpuWarning.CanShowInstallSection, Converter={StaticResource BoolToVis}}">
                                <!-- 已安装包 -->
                                <Border Background="{StaticResource CardBrush}"
                                        CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="已安装包" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                        <ItemsControl ItemsSource="{Binding GpuWarning.InstalledPackagesDisplay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,1">
                                                        <TextBlock FontSize="11" Margin="0,0,6,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Installed}" Value="True">
                                                                            <Setter Property="Text" Value="✓"/>
                                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Installed}" Value="False">
                                                                            <Setter Property="Text" Value="✗"/>
                                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Name}" FontSize="11"
                                                                   Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding Version}" FontSize="11"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- 安装方案 -->
                                <TextBlock Text="安装方案" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding GpuWarning.AvailablePaths}"
                                          SelectedValue="{Binding GpuWarning.SelectedPath}"
                                          SelectedValuePath="Id"
                                          Margin="0,0,0,12">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Label}" FontSize="12" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Description}" FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- 操作按钮 -->
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="一键安装"
                                            Command="{Binding GpuWarning.InstallGpuCommand}"
                                            IsEnabled="{Binding GpuWarning.CanInstall}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Padding="16,6" Margin="0,0,8,0"/>
                                    <Button Content="重新诊断"
                                            Command="{Binding GpuWarning.DiagnoseCommand}"
                                            IsEnabled="{Binding GpuWarning.IsDiagnosing, Converter={StaticResource BoolInvertConverter}}"
                                            Style="{StaticResource TextButtonStyle}" Padding="8,6" Margin="0,0,8,0"/>
                                    <Button Content="重启后端"
                                            Command="{Binding GpuWarning.RestartBackendCommand}"
                                            IsEnabled="{Binding GpuWarning.CanRestart}"
                                            Style="{StaticResource TextButtonStyle}" Padding="8,6" Margin="0,0,8,0"/>
                                    <Button Content="不再提示"
                                            Command="{Binding GpuWarning.DismissGpuWarningCommand}"
                                            Style="{StaticResource TextButtonStyle}" Padding="8,6"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- 安装日志（只要有日志输出即展示，带清空按钮） -->
                            <Border Visibility="{Binding GpuWarning.HasInstallLog, Converter={StaticResource BoolToVis}}"
                                    Margin="0,12,0,0" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="6">
                                <StackPanel>
                                    <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                        <TextBlock Text="安装日志" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <Button DockPanel.Dock="Right" Content="清空日志"
                                                Command="{Binding GpuWarning.ClearLogCommand}"
                                                IsEnabled="{Binding GpuWarning.CanClearLog}"
                                                Style="{StaticResource TextButtonStyle}" FontSize="11" Padding="4,2"/>
                                    </DockPanel>
                                    <TextBox IsReadOnly="True" Text="{Binding GpuWarning.InstallLog, Mode=OneWay}"
                                             FontFamily="Cascadia Mono,Consolas,Courier New" FontSize="11"
                                             MaxHeight="180" VerticalScrollBarVisibility="Auto"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding GpuWarning.StatusMessage}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11" Margin="0,6,0,0"
                                       Visibility="{Binding GpuWarning.StatusMessage, Converter={StaticResource NullToVis}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== 大模型对话 ===== -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="🤖" Style="{StaticResource SectionIcon}"/>
                            <TextBlock Text="大模型对话" Style="{StaticResource SubtitleText}"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource SmallText}"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   Margin="0,0,0,12">
                            配置后可在「对话」页使用 RAG 问答。支持 OpenAI 兼容 API（DeepSeek / Qwen / OpenAI）、Anthropic Claude、Google Gemini 和本地 Ollama。
                        </TextBlock>

                        <TextBlock Text="提供商标识" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                        <ComboBox SelectedValue="{Binding LlmProvider}"
                                  SelectedValuePath="Content"
                                  Margin="0,0,0,12">
                            <ComboBoxItem Content="none" IsSelected="True"/>
                            <ComboBoxItem Content="openai"/>
                            <ComboBoxItem Content="anthropic"/>
                            <ComboBoxItem Content="gemini"/>
                            <ComboBoxItem Content="ollama"/>
                        </ComboBox>

                        <TextBlock Text="API Key" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox Grid.Column="0"
                                         helpers:PasswordBoxHelper.BoundPassword="{Binding LlmApiKey, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="对应提供商的 API Key；Ollama 无需填写。保存时加密存储；留空 = 保留已配置的 Key，点击「清除」可删除"
                                         Margin="0,0,0,12"/>
                            <Button Grid.Column="1"
                                    Content="清除"
                                    Command="{Binding ClearApiKeyCommand}"
                                    IsEnabled="{Binding HasSavedApiKey}"
                                    Margin="8,0,0,12"
                                    Padding="12,4"
                                    ToolTip="清除已配置的 API Key（保存后生效：本地与后端均删除）。仅留空输入框保存不会清除，会保留原 Key"/>
                            <Button Grid.Column="2"
                                    Content="测试连接"
                                    Command="{Binding TestConnectionCommand}"
                                    IsEnabled="{Binding IsTestingConnection, Converter={StaticResource BoolInvertConverter}}"
                                    Margin="8,0,0,12"
                                    Padding="12,4"
                                    ToolTip="用当前输入值测试（无需先保存）：先测后端可达，再向所选提供商发一条最小消息验证 Key 与地址"/>
                        </Grid>

                        <TextBlock Text="API 基础地址（可选）" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding LlmBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="留空用各提供商官方地址。OpenAI 兼容示例 https://api.deepseek.com/v1；Ollama 默认 http://localhost:11434"
                                 Margin="0,0,0,12"/>

                        <TextBlock Text="模型名" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- 可编辑下拉：候选来自「获取模型列表」，也允许手输任意模型名 -->
                            <ComboBox Grid.Column="0"
                                      IsEditable="True"
                                      Text="{Binding LlmModel, UpdateSourceTrigger=PropertyChanged}"
                                      ItemsSource="{Binding LlmModels}"
                                      ToolTip="点击「获取模型列表」自动拉取当前提供商可用模型（Ollama 列本地已装模型）；也可手动输入，如 deepseek-chat、gpt-4o-mini、claude-sonnet-4-5、gemini-2.5-flash、llama3.2"
                                      Margin="0,0,0,12"/>
                            <Button Grid.Column="1"
                                    Content="获取模型列表"
                                    Command="{Binding RefreshLlmModelsCommand}"
                                    IsEnabled="{Binding IsFetchingModels, Converter={StaticResource BoolInvertConverter}}"
                                    Margin="8,0,0,12"
                                    Padding="12,4"
                                    VerticalAlignment="Top"
                                    ToolTip="用当前输入的提供商/Key/地址拉取可用模型（无需先保存）：Ollama 列出本地已安装模型；云端调各家模型列表接口"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="温度（0-2）" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding LlmTemperature, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="默认 0.7；越低越确定，越高越有创造性"
                                         Margin="0,0,0,12"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="最大 Token 数" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding LlmMaxTokens, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="默认 2048；单次回答最大 token 数"
                                         Margin="0,0,0,12"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="检索引用数（RAG Top-K）" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding RagTopK, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="默认 5；从知识库检索的文档片段数"
                                 Margin="0,0,0,12"/>

                        <TextBlock Text="系统提示词（可选）" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding RagSystemPrompt, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="72"
                                 MaxHeight="160"
                                 VerticalScrollBarVisibility="Auto"
                                 ToolTip="自定义 RAG 系统提示词（人设/回答风格/输出格式）；留空使用内置默认：基于检索资料回答、标注 [N] 来源、不知道就说不知道"
                                 Margin="0,0,0,12"/>
                        <TextBlock Style="{StaticResource SmallText}"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   Margin="0,0,0,12">
                            留空 = 使用内置默认提示词（基于资料回答并标注来源）。自定义后仍建议要求模型注明来源编号。
                        </TextBlock>

                        <TextBlock Text="历史 Token 预算" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding RagMaxHistoryTokens, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="多轮对话历史的总 token 上限（默认 4096）。从最新消息向前保留，超出的早期对话会被省略；0 = 不按 token 截断。防止长对话超出模型上下文窗口"
                                 Margin="0,0,0,12"/>
                    </StackPanel>
                </Border>

                <!-- ===== 启动选项 ===== -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="🚀" Style="{StaticResource SectionIcon}"/>
                            <TextBlock Text="启动选项" Style="{StaticResource SubtitleText}"/>
                        </StackPanel>

                        <!-- 自动拉起后端 -->
                        <CheckBox IsChecked="{Binding AutoStartBackend}"
                                  Margin="0,0,0,8">
                            <TextBlock Text="启动客户端时自动拉起后端"
                                       Style="{StaticResource BodyText}"/>
                        </CheckBox>
                        <TextBlock Style="{StaticResource SmallText}"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   Margin="0,0,0,12">
                            取消勾选则仅连接外部已运行的后端（手动 doc2mind serve）
                        </TextBlock>

                        <!-- 退出联动终止 -->
                        <CheckBox IsChecked="{Binding StopBackendOnExit}"
                                  Margin="0,0,0,8">
                            <TextBlock Text="退出客户端时联动终止后端"
                                       Style="{StaticResource BodyText}"/>
                        </CheckBox>
                        <TextBlock Style="{StaticResource SmallText}"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   Margin="0,0,0,12">
                            取消勾选则退出后保留后端继续运行
                        </TextBlock>

                        <!-- 后端命令路径 -->
                        <TextBlock Text="后端命令路径（可选）" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding BackendCommand, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="绝对路径优先；空走自动探测 doc2mind / python -m doc2mind"
                                 Margin="0,0,0,16"/>

                        <!-- 自动导入 -->
                        <TextBlock Text="启动时自动导入的目录（可选）" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding AutoIngestPath, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="空表示不自动导入；填目录或文件路径"
                                 Margin="0,0,0,12"/>
                        <TextBlock Text="目标集合名" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding AutoIngestCollection, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="默认 default"
                                 Margin="0,0,0,12"/>
                        <CheckBox IsChecked="{Binding AutoIngestRecursive}"
                                  Margin="0,0,0,0">
                            <TextBlock Text="目录时递归子目录"
                                       Style="{StaticResource BodyText}"/>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- ===== 文件监控 ===== -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="👁️" Style="{StaticResource SectionIcon}"/>
                            <TextBlock Text="文件监控自动摄入" Style="{StaticResource SubtitleText}"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource SmallText}"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   Margin="0,0,0,12">
                            监控本地目录中的文档（.md, .txt, .pdf, .docx 等），检测到新增或修改后自动摄入知识库。
                        </TextBlock>

                        <!-- 添加监控目录行 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Text="{Binding NewWatchPath, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="输入或浏览要监控的本地目录完整路径"
                                     Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="📁 浏览" Command="{Binding BrowseWatchPathCommand}"
                                    Width="Auto" Padding="12,6" Margin="0,0,8,0"/>
                            <Button Grid.Column="2" Content="➕ 添加" Command="{Binding AddWatchPathCommand}"
                                    Width="Auto" Padding="12,6"/>
                        </Grid>

                        <!-- 监控目录列表 -->
                        <TextBlock Text="已配置监控的目录列表：" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                        <ListBox ItemsSource="{Binding WatchPaths}"
                                 SelectedItem="{Binding SelectedWatchPath}"
                                 MinHeight="80" MaxHeight="150"
                                 Background="{StaticResource BackgroundBrush}"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 BorderThickness="1"
                                 Margin="0,0,0,10">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="1" Content="🗑️"
                                                Command="{Binding DataContext.RemoveWatchPathCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4,2"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="去抖等待时间（秒）" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBox Grid.Column="1" Text="{Binding WatchDebounceSeconds, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="文件修改后等待写入完成的去抖时长（默认 5.0 秒）"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== 外观 ===== -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="🎨" Style="{StaticResource SectionIcon}"/>
                            <TextBlock Text="外观" Style="{StaticResource SubtitleText}"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="主题"
                                       Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="☀ 浅色"
                                        Command="{Binding SetLightThemeCommand}"
                                        Width="Auto" MinWidth="64"
                                        Padding="14,7"
                                        Margin="0,0,8,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Padding" Value="14,7"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedTheme}" Value="Light">
                                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextInverseBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="🌙 深色"
                                        Command="{Binding SetDarkThemeCommand}"
                                        Width="Auto" MinWidth="64"
                                        Padding="14,7">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Padding" Value="14,7"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedTheme}" Value="Dark">
                                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextInverseBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== 关于 ===== -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="ℹ" Style="{StaticResource SectionIcon}"/>
                            <TextBlock Text="关于" Style="{StaticResource SubtitleText}"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource BodyText}">
                            <Run Text="DocMind "/>
                            <Run Text="v1.0.0"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0">
                            <Run Text="后端 "/><Run Text="{Binding BackendUrl, Mode=OneWay}"/>
                        </TextBlock>

                        <!-- GPU 加速状态 -->
                        <TextBlock Style="{StaticResource SmallText}"
                                   Margin="0,8,0,0"
                                   Foreground="{Binding GpuWarning.GpuStatusBrush}">
                            <Run Text="GPU 加速："/>
                            <Run Text="{Binding GpuWarning.GpuStatusText, Mode=OneWay}"/>
                        </TextBlock>

                        <TextBlock Style="{StaticResource SmallText}"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0">
                            提示：修改后端连接后保存配置，重启客户端使通信变更加载最新配置。
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== 底部工具条 ===== -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,10,0,0"
                Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="保存"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,8,0"/>
                    <Button Content="恢复上次保存"
                            Command="{Binding RevertCommand}"
                            Style="{StaticResource TextButtonStyle}"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage, Mode=OneWay}"
                           Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center"
                           Margin="12,0,12,0"/>

                <Border Grid.Column="2"
                        CornerRadius="10"
                        Background="{StaticResource WarningLightBrush}"
                        Padding="12,5"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6"
                                 Fill="{StaticResource WarningBrush}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,6,0"/>
                        <TextBlock Text="有未保存的修改"
                                   Style="{StaticResource SmallText}"
                                   Foreground="{StaticResource WarningBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>