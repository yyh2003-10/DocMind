<UserControl x:Class="DocMind.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DocMind.ViewModels"
             xmlns:helpers="clr-namespace:DocMind.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="980"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <UserControl.Resources>
        <!-- 分区通用图标样式 -->
        <Style x:Key="SectionIcon" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 左侧分类 Tab 导航项样式 -->
        <Style x:Key="SettingsNavTabStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource PrimaryBrush}"
                                BorderThickness="0"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="3,0,0,0"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 主体区域：左侧分类侧栏 + 右侧配置面板 ===== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- =========================================================
                 左侧垂直分类导航栏
                 ========================================================= -->
            <Border Grid.Column="0"
                    Background="{StaticResource SidebarBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="14,16,14,16">
                <DockPanel>
                    <!-- 导航栏顶部标题 -->
                    <StackPanel DockPanel.Dock="Top" Margin="2,0,0,18">
                        <TextBlock Text="⚙️ 偏好设置" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="模块化分类与系统调优" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- 5 大分类导航列表 -->
                    <StackPanel VerticalAlignment="Top">
                        <!-- 1. AI 模型与对话 -->
                        <RadioButton Style="{StaticResource SettingsNavTabStyle}"
                                     GroupName="SettingsCategoryGroup"
                                     IsChecked="{Binding IsAiModelsSelected, Mode=OneWay}"
                                     Command="{Binding SelectCategoryCommand}" CommandParameter="AiModels">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🤖" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="AI 模型与对话" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="本地感知 / 云端模型" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </RadioButton>

                        <!-- 2. 知识库与检索 -->
                        <RadioButton Style="{StaticResource SettingsNavTabStyle}"
                                     GroupName="SettingsCategoryGroup"
                                     IsChecked="{Binding IsKnowledgeBaseSelected, Mode=OneWay}"
                                     Command="{Binding SelectCategoryCommand}" CommandParameter="KnowledgeBase">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📚" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="知识库与检索" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="嵌入向量 / 切片 / RAG" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </RadioButton>

                        <!-- 3. 界面与外观 -->
                        <RadioButton Style="{StaticResource SettingsNavTabStyle}"
                                     GroupName="SettingsCategoryGroup"
                                     IsChecked="{Binding IsAppearanceSelected, Mode=OneWay}"
                                     Command="{Binding SelectCategoryCommand}" CommandParameter="Appearance">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎨" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="界面与外观" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="浅色 / 深色 / 跟随系统" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </RadioButton>

                        <!-- 4. 算力与体检 -->
                        <RadioButton Style="{StaticResource SettingsNavTabStyle}"
                                     GroupName="SettingsCategoryGroup"
                                     IsChecked="{Binding IsHardwareSelected, Mode=OneWay}"
                                     Command="{Binding SelectCategoryCommand}" CommandParameter="Hardware">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔌" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="算力与体检" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="GPU 加速 / 环境自愈" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </RadioButton>

                        <!-- 5. 服务与关于 -->
                        <RadioButton Style="{StaticResource SettingsNavTabStyle}"
                                     GroupName="SettingsCategoryGroup"
                                     IsChecked="{Binding IsAboutServiceSelected, Mode=OneWay}"
                                     Command="{Binding SelectCategoryCommand}" CommandParameter="AboutService">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🌐" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="服务与关于" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="FastAPI 后端 / 存储 / 版本" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- =========================================================
                 右侧模块化内容面板
                 ========================================================= -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="24,18,24,20">
                <Grid MaxWidth="800" HorizontalAlignment="Left">

                    <!-- =========================================================
                         面板 1: 🤖 AI 模型与对话
                         ========================================================= -->
                    <StackPanel Visibility="{Binding IsAiModelsSelected, Converter={StaticResource BoolToVis}}">
                        <!-- 模块标题 -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="🤖 AI 模型与对话配置" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="支持开箱即用的本地 LM Studio / Ollama 感知绑定，以及 DeepSeek / 阿里通义 / 智谱等主流云端服务商。"
                                       FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- 🌟 本地 AI 环境智能感知卡片 -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🌟 本地 AI 环境智能感知" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text=" (开箱即用，零配置绑定)" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right" Content="🔄 重新探测"
                                            Command="{Binding DetectLocalAiCommand}"
                                            IsEnabled="{Binding IsDetectingLocalAi, Converter={StaticResource BoolInvertConverter}}"
                                            Style="{StaticResource TextButtonStyle}" FontSize="11" Padding="6,2"/>
                                </DockPanel>

                                <!-- 正在探测 -->
                                <TextBlock Text="⏳ 正在扫描本地 Ollama / LM Studio 及模型资产..."
                                           Visibility="{Binding IsDetectingLocalAi, Converter={StaticResource BoolToVis}}"
                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>

                                <!-- 探测结果与快捷应用按钮 -->
                                <StackPanel Visibility="{Binding HasLocalAiDetected, Converter={StaticResource BoolToVis}}">
                                    <!-- 资产概览条 -->
                                    <WrapPanel Margin="0,0,0,10">
                                        <!-- LM Studio 状态 -->
                                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,8,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="● " FontSize="10">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLmStudioRunning}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="LM Studio (1234): " FontSize="11" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding LmStudioStatusText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Ollama 状态 -->
                                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,8,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="● " FontSize="10">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOllamaRunning}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="Ollama (11434): " FontSize="11" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding OllamaStatusText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- 本地 GGUF 资产 -->
                                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,8,4"
                                                Visibility="{Binding LocalGgufCountText, Converter={StaticResource NullToVis}}">
                                            <TextBlock Text="{Binding LocalGgufCountText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </Border>
                                    </WrapPanel>

                                    <!-- 快捷应用方案按钮条 -->
                                    <WrapPanel>
                                        <Button Content="⚡ 一键套用 LM Studio 极速本地方案"
                                                Command="{Binding ApplyLmStudioPresetCommand}"
                                                IsEnabled="{Binding IsLmStudioRunning}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Padding="12,6" Margin="0,0,8,4" FontSize="11"
                                                ToolTip="自动绑定 LM Studio 地址与模型，显卡全速推理，向量走轻量 CPU 引擎"/>
                                        <Button Content="🟢 一键套用 Ollama 一体化本地方案"
                                                Command="{Binding ApplyOllamaPresetCommand}"
                                                IsEnabled="{Binding IsOllamaRunning}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="12,6" Margin="0,0,8,4" FontSize="11"
                                                ToolTip="自动绑定 Ollama 服务与已下载模型，内置 CUDA 引擎加速"/>
                                    </WrapPanel>
                                </StackPanel>

                                <!-- 未发现任何本地服务时的提示 -->
                                <TextBlock Text="💡 未检测到运行中的 LM Studio 或 Ollama 服务。若需使用本地大模型，可先启动它们并开启 Local Server 后点击「重新探测」。"
                                           Visibility="{Binding HasLocalAiDetected, Converter={StaticResource InvertBoolVis}}"
                                           FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- 服务商预设与连接配置卡片 -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="🔑" Style="{StaticResource SectionIcon}"/>
                                    <TextBlock Text="服务商与 API 密钥配置" Style="{StaticResource SubtitleText}"/>
                                </StackPanel>

                                <!-- 快捷服务商预设 -->
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="快捷服务商预设 (一键填入地址与推荐模型)" Style="{StaticResource CaptionText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Button DockPanel.Dock="Right"
                                            Content="🔗 前往申请/管理此服务商 API Key ↗"
                                            Command="{Binding OpenPresetConsoleUrlCommand}"
                                            Visibility="{Binding HasPresetConsoleUrl, Converter={StaticResource BoolToVis}}"
                                            Style="{StaticResource TextButtonStyle}"
                                            FontSize="11"
                                            Foreground="{StaticResource PrimaryBrush}"
                                            HorizontalAlignment="Right"
                                            ToolTip="在默认浏览器中打开该服务商的 API 密钥管理控制台"/>
                                </DockPanel>
                                <ComboBox ItemsSource="{Binding AvailablePresets}"
                                          SelectedItem="{Binding SelectedPreset}"
                                          Margin="0,0,0,12">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextTertiaryBrush}" FontSize="11"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 接口类型 -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="接口类型" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                                        <ComboBox SelectedValue="{Binding LlmProvider}"
                                                  SelectedValuePath="Content"
                                                  ToolTip="选预设后会自动填好。使用 Anthropic Claude / Google Gemini 时需手动选择">
                                            <ComboBoxItem Content="none" IsSelected="True"/>
                                            <ComboBoxItem Content="openai"/>
                                            <ComboBoxItem Content="anthropic"/>
                                            <ComboBoxItem Content="gemini"/>
                                            <ComboBoxItem Content="ollama"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- API 基础地址 -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="API 基础地址（Base URL）" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding LlmBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="留空用各提供商官方地址。OpenAI 兼容示例 https://api.deepseek.com/v1；Ollama 默认 http://localhost:11434"/>
                                    </StackPanel>
                                </Grid>

                                <!-- API Key -->
                                <TextBlock Text="API Key 密钥" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox Grid.Column="0"
                                                 helpers:PasswordBoxHelper.BoundPassword="{Binding LlmApiKey, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="对应提供商的 API Key；Ollama / 本地 LM Studio 无需填写。保存时加密存储；留空 = 保留已配置的 Key，点击「清除」可删除"/>
                                    <Button Grid.Column="1"
                                            Content="清除"
                                            Command="{Binding ClearApiKeyCommand}"
                                            IsEnabled="{Binding HasSavedApiKey}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="8,0,0,0"
                                            Padding="12,4"
                                            ToolTip="清除已配置的 API Key（保存后生效：本地与后端均删除）。仅留空输入框保存不会清除，会保留原 Key"/>
                                    <Button Grid.Column="2"
                                            Content="测试连接"
                                            Command="{Binding TestConnectionCommand}"
                                            IsEnabled="{Binding IsTestingConnection, Converter={StaticResource BoolInvertConverter}}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="8,0,0,0"
                                            Padding="12,4"
                                            ToolTip="用当前输入值测试（无需先保存）：先测后端可达，再向所选提供商发一条最小消息验证 Key 与地址"/>
                                </Grid>

                                <!-- 模型名 -->
                                <TextBlock Text="模型名称" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                              IsEditable="True"
                                              Text="{Binding LlmModel, UpdateSourceTrigger=PropertyChanged}"
                                              ItemsSource="{Binding LlmModels}"
                                              ToolTip="点击「获取模型列表」自动拉取当前提供商可用模型（Ollama 列本地已装模型）；也可手动输入，如 deepseek-chat、gpt-4o-mini、claude-sonnet-4-5、llama-3.2-1b-instruct"/>
                                    <Button Grid.Column="1"
                                            Content="获取模型列表"
                                            Command="{Binding RefreshLlmModelsCommand}"
                                            IsEnabled="{Binding IsFetchingModels, Converter={StaticResource BoolInvertConverter}}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="8,0,0,0"
                                            Padding="12,4"
                                            VerticalAlignment="Top"
                                            ToolTip="用当前输入的提供商/Key/地址拉取可用模型（无需先保存）：Ollama 列出本地已安装模型；云端调各家模型列表接口"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- =========================================================
                         面板 2: 📚 知识库与检索
                         ========================================================= -->
                    <StackPanel Visibility="{Binding IsKnowledgeBaseSelected, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="📚 知识库与检索调优" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="管理本地嵌入向量模型、语义切片策略、召回精度（Top-K）与目录自动监控。"
                                       FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- 嵌入模型卡片 -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="🧠" Style="{StaticResource SectionIcon}"/>
                                    <TextBlock Text="文档嵌入向量模型" Style="{StaticResource SubtitleText}"/>
                                </StackPanel>

                                <TextBlock Text="文档语言与推荐模型" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding EmbedModelOptions}"
                                          SelectedValue="{Binding EmbedModel}"
                                          SelectedValuePath="ModelId"
                                          ToolTip="按文档语言选择即可；第二行小字是实际模型名。更换后需在「文档库」页重建索引"
                                          Margin="0,0,0,12">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2">
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding ModelId}" FontSize="11"
                                                           Foreground="{StaticResource TextTertiaryBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Text="本地模型目录（可选，完全离线使用）" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding EmbedModelPath, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="填本地 ONNX 模型目录（含 model.onnx / model_optimized.onnx + tokenizer.json）；留空则用上面的模型联网下载"
                                         Margin="0,0,0,6"/>
                                <TextBlock Style="{StaticResource SmallText}"
                                           Foreground="{StaticResource TextTertiaryBrush}">
                                    留空 = 使用上方下拉的推荐模型（首次自动下载，之后用本地缓存）；填本地目录 = 完全离线使用自己的模型。
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- 对话与检索高级参数 -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="🎚" Style="{StaticResource SectionIcon}"/>
                                    <TextBlock Text="RAG 检索与回答调优" Style="{StaticResource SubtitleText}"/>
                                </StackPanel>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="对话温度 (Temperature: 0~1.5)" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding LlmTemperature, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="默认 0.7；越低回答越严谨确定，越高越发散有创造性"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="单次最大生成 Token 数" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding LlmMaxTokens, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="默认 2048；单次回答最大 token 上限"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="检索引用数（RAG Top-K）" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding RagTopK, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="默认 5；从知识库检索召回的最相关切片数"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="多轮对话历史 Token 预算" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding RagMaxHistoryTokens, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="多轮对话历史的总 token 上限（默认 4096）。防止长对话超出模型上下文窗口"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="自定义专家系统提示词 (System Prompt)" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding RagSystemPrompt, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="68"
                                         MaxHeight="140"
                                         VerticalScrollBarVisibility="Auto"
                                         ToolTip="自定义 RAG 系统提示词（人设/回答风格/输出格式）；留空使用内置默认：基于检索资料回答、标注 [N] 来源"
                                         Margin="0,0,0,6"/>
                                <TextBlock Style="{StaticResource SmallText}"
                                           Foreground="{StaticResource TextTertiaryBrush}">
                                    留空 = 使用内置默认专家提示词（包含透彻剖析、多维溯源、实战代码与避坑预警）。
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- 文档分块高级参数 -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="✂️" Style="{StaticResource SectionIcon}"/>
                                    <TextBlock Text="文档分块切片参数 (Chunking)" Style="{StaticResource SubtitleText}"/>
                                </StackPanel>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="分块最大 Token 数" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding ChunkMaxTokens, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="默认 1500；越大分块越粗" Margin="0,0,0,12"/>
                                        <TextBlock Text="分块最小字符数" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding ChunkMinChars, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="默认 50；低于此长度的碎片被丢弃"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="分块重叠字符数" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding ChunkOverlapChars, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="默认 200；相邻块重叠量，越大上下文越连贯" Margin="0,0,0,12"/>
                                        <TextBlock Text="分块最大字符数" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding ChunkMaxChars, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="默认 4000；单块字符上限"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 文件监控自动摄入 -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="👁️" Style="{StaticResource SectionIcon}"/>
                                    <TextBlock Text="文件监控自动摄入" Style="{StaticResource SubtitleText}"/>
                                </StackPanel>

                                <TextBlock Style="{StaticResource SmallText}"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           Margin="0,0,0,12">
                                    监控本地目录中的文档（.md, .txt, .pdf, .docx, .xlsx 等），检测到新增或修改后自动摄入知识库。
                                </TextBlock>

                                <!-- 添加监控目录行 -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0" Text="{Binding NewWatchPath, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="输入或浏览要监控的本地目录完整路径"
                                             Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Content="📁 浏览" Command="{Binding BrowseWatchPathCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Width="Auto" Padding="12,6" Margin="0,0,8,0"/>
                                    <Button Grid.Column="2" Content="➕ 添加" Command="{Binding AddWatchPathCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Width="Auto" Padding="12,6"/>
                                </Grid>

                                <!-- 监控目录列表 -->
                                <TextBlock Text="已配置监控的目录列表：" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                                <ListBox ItemsSource="{Binding WatchPaths}"
                                         SelectedItem="{Binding SelectedWatchPath}"
                                         MinHeight="70" MaxHeight="140"
                                         Background="{StaticResource SurfaceBrush}"
                                         BorderBrush="{StaticResource BorderBrush}"
                                         BorderThickness="1"
                                         Margin="0,0,0,10">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <Button Grid.Column="1" Content="🗑️"
                                                        Command="{Binding DataContext.RemoveWatchPathCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4,2"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="去抖等待时间（秒）" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding WatchDebounceSeconds, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="文件修改后等待写入完成的去抖时长（默认 5.0 秒）"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- =========================================================
                         面板 3: 🎨 界面与外观
                         ========================================================= -->
                    <StackPanel Visibility="{Binding IsAppearanceSelected, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="🎨 界面外观与个性化" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="定制属于您的视觉色彩与交互主题。"
                                       FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="🖼️" Style="{StaticResource SectionIcon}"/>
                                    <TextBlock Text="主题色彩模式" Style="{StaticResource SubtitleText}"/>
                                </StackPanel>

                                <TextBlock Style="{StaticResource SmallText}"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           Margin="0,0,0,16">
                                    选择您喜欢的主题风格，即时生效。
                                </TextBlock>

                                <!-- 主题选择大卡片组 -->
                                <UniformGrid Columns="2" Margin="0,0,0,10">
                                    <!-- 浅色主题卡片 -->
                                    <Button Command="{Binding SetLightThemeCommand}"
                                            Margin="0,0,8,0" Padding="16,14" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Root" Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <TextBlock Text="☀️" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                                    <TextBlock Text="浅色模式 (Light)" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center"/>
                                                                    <TextBlock Text="清爽明亮，专注阅读" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTheme}" Value="Light">
                                                        <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- 深色主题卡片 -->
                                    <Button Command="{Binding SetDarkThemeCommand}"
                                            Margin="8,0,0,0" Padding="16,14" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Root" Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <TextBlock Text="🌙" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                                    <TextBlock Text="深色极客 (Dark)" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center"/>
                                                                    <TextBlock Text="沉浸护眼，极客质感" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTheme}" Value="Dark">
                                                        <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- =========================================================
                         面板 4: 🔌 算力与体检
                         ========================================================= -->
                    <StackPanel Visibility="{Binding IsHardwareSelected, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="🔌 硬件算力与系统体检" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="GPU 硬件加速诊断、CUDA 环境配置与全链路自检自愈报告。"
                                       FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- GPU 加速卡片 -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🔌" Style="{StaticResource SectionIcon}"/>
                                        <TextBlock Text="GPU 硬件加速 (CUDA / TensorRT)" Style="{StaticResource SubtitleText}"/>
                                        <TextBlock Text="  ✓"
                                                   Visibility="{Binding GpuWarning.GpuAvailable, Converter={StaticResource BoolToVis}}"
                                                   Foreground="{StaticResource SuccessBrush}"
                                                   FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right" Content="重新诊断"
                                            Command="{Binding GpuWarning.DiagnoseCommand}"
                                            IsEnabled="{Binding GpuWarning.IsDiagnosing, Converter={StaticResource BoolInvertConverter}}"
                                            Style="{StaticResource TextButtonStyle}" Padding="6,2" FontSize="11"/>
                                </DockPanel>

                                <TextBlock Text="⏳ 正在检测 GPU 运行环境..."
                                           Visibility="{Binding GpuWarning.IsDiagnosing, Converter={StaticResource BoolToVis}}"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>

                                <!-- 诊断完成后状态 -->
                                <StackPanel Visibility="{Binding GpuWarning.HasDiagnosis, Converter={StaticResource BoolToVis}}">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                            <TextBlock FontSize="12" Margin="0,0,0,4">
                                                <Run Text="加速状态：" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <Run Text="{Binding GpuWarning.GpuStatusText, Mode=OneWay}" FontWeight="SemiBold"
                                                     Foreground="{Binding GpuWarning.GpuStatusBrush, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="12" Margin="0,0,0,4"
                                                       Visibility="{Binding GpuWarning.GpuDeviceName, Converter={StaticResource NullToVis}}">
                                                <Run Text="显卡设备：" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <Run Text="{Binding GpuWarning.GpuDeviceName, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontSize="12" Margin="0,0,0,4"
                                                       Visibility="{Binding GpuWarning.DriverInfo, Converter={StaticResource NullToVis}}">
                                                <Run Text="驱动版本：" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <Run Text="{Binding GpuWarning.DriverInfo, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="12" Margin="0,0,0,4"
                                                       Visibility="{Binding GpuWarning.GpuAvailable, Converter={StaticResource InvertBoolVis}}">
                                                <Run Text="CUDA 运行时：" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <Run Text="{Binding GpuWarning.CudaRuntimeInfo, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 警告项 -->
                                    <ItemsControl ItemsSource="{Binding GpuWarning.Warnings}"
                                                  Margin="0,0,0,8"
                                                  Visibility="{Binding GpuWarning.Warnings.Count, Converter={StaticResource ZeroToVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="11"
                                                           Foreground="{StaticResource WarningBrush}"
                                                           Margin="0,2" TextWrapping="Wrap"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 已启用 GPU 时的展开/收起按钮 -->
                                    <Button Content="{Binding GpuWarning.AdvancedOptionsToggleText}"
                                            Command="{Binding GpuWarning.ToggleAdvancedOptionsCommand}"
                                            Visibility="{Binding GpuWarning.GpuAvailable, Converter={StaticResource BoolToVis}}"
                                            Style="{StaticResource TextButtonStyle}"
                                            HorizontalAlignment="Left" Margin="0,2,0,8"/>

                                    <!-- 包列表与安装方案区域（未启用 GPU 或用户主动展开时显示） -->
                                    <StackPanel Visibility="{Binding GpuWarning.CanShowInstallSection, Converter={StaticResource BoolToVis}}">
                                        <!-- 已安装包 -->
                                        <Border Background="{StaticResource SurfaceBrush}"
                                                CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="已检测 Python GPU 支持包：" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                                <ItemsControl ItemsSource="{Binding GpuWarning.InstalledPackagesDisplay}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                                                <TextBlock FontSize="11" Margin="0,0,6,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Installed}" Value="True">
                                                                                    <Setter Property="Text" Value="✓"/>
                                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Installed}" Value="False">
                                                                                    <Setter Property="Text" Value="✗"/>
                                                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding Name}" FontSize="11"
                                                                           Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                <TextBlock Text="{Binding Version}" FontSize="11"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- 安装方案 -->
                                        <TextBlock Text="选择安装方案：" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding GpuWarning.AvailablePaths}"
                                                  SelectedValue="{Binding GpuWarning.SelectedPath}"
                                                  SelectedValuePath="Id"
                                                  Margin="0,0,0,10">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Label}" FontSize="12" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="11"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <!-- 操作按钮条 -->
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <Button Content="🚀 一键安装 GPU 加速"
                                                    Command="{Binding GpuWarning.InstallGpuCommand}"
                                                    IsEnabled="{Binding GpuWarning.CanInstall}"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Padding="14,6" Margin="0,0,8,0"/>
                                            <Button Content="🔄 重启后端"
                                                    Command="{Binding GpuWarning.RestartBackendCommand}"
                                                    IsEnabled="{Binding GpuWarning.CanRestart}"
                                                    Style="{StaticResource SecondaryButtonStyle}" Padding="10,6" Margin="0,0,8,0"/>
                                            <Button Content="不再提示"
                                                    Command="{Binding GpuWarning.DismissGpuWarningCommand}"
                                                    Style="{StaticResource TextButtonStyle}" Padding="6,6"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 安装日志 -->
                                    <Border Visibility="{Binding GpuWarning.HasInstallLog, Converter={StaticResource BoolToVis}}"
                                            Margin="0,10,0,0" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="6" Padding="8">
                                        <StackPanel>
                                            <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                                <TextBlock Text="安装输出日志" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                <Button DockPanel.Dock="Right" Content="清空日志"
                                                        Command="{Binding GpuWarning.ClearLogCommand}"
                                                        IsEnabled="{Binding GpuWarning.CanClearLog}"
                                                        Style="{StaticResource TextButtonStyle}" FontSize="11" Padding="4,2"/>
                                            </DockPanel>
                                            <TextBox IsReadOnly="True" Text="{Binding GpuWarning.InstallLog, Mode=OneWay}"
                                                     FontFamily="Cascadia Mono,Consolas,Courier New" FontSize="11"
                                                     MaxHeight="160" VerticalScrollBarVisibility="Auto"
                                                     Background="Transparent" BorderThickness="0"
                                                     Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 系统环境体检与自愈诊断 (Doctor) -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <TextBlock Text="🩺" Style="{StaticResource SectionIcon}"/>
                                        <TextBlock Text="系统环境自检与自愈诊断" Style="{StaticResource SubtitleText}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right" Content="🩺 执行全面体检"
                                            Command="{Binding RunDoctorCommand}"
                                            IsEnabled="{Binding IsRunningDoctor, Converter={StaticResource BoolInvertConverter}}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            FontSize="11"
                                            Padding="10,4"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"/>
                                </DockPanel>

                                <TextBlock Style="{StaticResource SmallText}"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           Margin="0,0,0,12">
                                    一键全面检测 Python 环境、SQLite 向量数据库、嵌入模型缓存、GPU 硬件加速、OCR 模块、大模型连通性与清华/HF镜像网络。
                                </TextBlock>

                                <!-- 体检中提示 -->
                                <TextBlock Text="⏳ 正在检测全系统各项环境与网络连通性，请稍候..."
                                           Visibility="{Binding IsRunningDoctor, Converter={StaticResource BoolToVis}}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,4,0,8"/>

                                <!-- 诊断报告结果 -->
                                <StackPanel Visibility="{Binding HasDoctorReport, Converter={StaticResource BoolToVis}}">
                                    <!-- 得分与摘要卡片 -->
                                    <Border Background="{StaticResource SurfaceBrush}"
                                            CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="健康评分" Style="{StaticResource SmallText}" Foreground="{StaticResource TextTertiaryBrush}"/>
                                                <TextBlock Text="{Binding DoctorScoreText}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DoctorReport.Summary}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- 检测项列表 -->
                                    <ItemsControl ItemsSource="{Binding DoctorReport.Checks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="0,0,0,1"
                                                        Padding="0,6" Margin="0,2">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="70"/>
                                                            <ColumnDefinition Width="150"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding BadgeText}"
                                                                   FontWeight="SemiBold" FontSize="11"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                                   FontWeight="Medium" FontSize="12"
                                                                   VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="{Binding Message}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding FixSuggestion}" FontSize="11"
                                                                       Foreground="{StaticResource WarningBrush}"
                                                                       TextWrapping="Wrap" Margin="0,2,0,0"
                                                                       Visibility="{Binding FixSuggestion, Converter={StaticResource NullToVis}}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- =========================================================
                         面板 5: 🌐 服务与关于
                         ========================================================= -->
                    <StackPanel Visibility="{Binding IsAboutServiceSelected, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="🌐 后端服务与关于信息" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="FastAPI 后端进程生命周期、连接端口管理与应用系统信息。"
                                       FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- 后端连接与进程卡片 -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🌐" Style="{StaticResource SectionIcon}"/>
                                        <TextBlock Text="后端服务生命周期管理" Style="{StaticResource SubtitleText}"/>
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right"
                                            Content="🔄 强力重启后端服务"
                                            Command="{Binding RestartBackendCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="10,4" FontSize="11"
                                            ToolTip="强力清理可能残留的旧进程，释放 8765 端口并重新拉起最新后端"/>
                                </DockPanel>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="后端 HTTP 地址" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding BackendUrl, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="例如 http://127.0.0.1:8765"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="启动等待超时（秒）" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding StartupTimeoutSec, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="后端进程启动等待时间"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="任务状态轮询间隔 (毫秒)" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding PollIntervalMs, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="100-10000ms，值越小实时性越高"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="后端命令路径（可选）" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding BackendCommand, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="绝对路径优先；空走自动探测 doc2mind / python -m doc2mind"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 启动与退出策略 -->
                                <TextBlock Text="进程生命周期策略" Style="{StaticResource CaptionText}" Margin="0,0,0,8"/>
                                <StackPanel Margin="4,0,0,8">
                                    <CheckBox IsChecked="{Binding AutoStartBackend}" Margin="0,0,0,6">
                                        <TextBlock Text="启动客户端时自动拉起后端服务" Style="{StaticResource BodyText}"/>
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding StopBackendOnExit}">
                                        <TextBlock Text="退出客户端时联动终止后端进程" Style="{StaticResource BodyText}"/>
                                    </CheckBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 关于卡片 -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="ℹ️" Style="{StaticResource SectionIcon}"/>
                                    <TextBlock Text="关于 DocMind" Style="{StaticResource SubtitleText}"/>
                                </StackPanel>

                                <TextBlock Style="{StaticResource BodyText}">
                                    <Run Text="DocMind 智能向量知识库工具 " FontWeight="Bold"/>
                                    <Run Text="v1.0.1"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0">
                                    <Run Text="后端端点: "/><Run Text="{Binding BackendUrl, Mode=OneWay}"/>
                                </TextBlock>

                                <TextBlock Style="{StaticResource SmallText}"
                                           Margin="0,6,0,0"
                                           Foreground="{Binding GpuWarning.GpuStatusBrush}">
                                    <Run Text="GPU 硬件加速："/>
                                    <Run Text="{Binding GpuWarning.GpuStatusText, Mode=OneWay}"/>
                                </TextBlock>

                                <TextBlock Style="{StaticResource SmallText}"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0">
                                    DocMind 采用 100% 本地私有化知识库引擎，支持 PDF、Word、Excel、PPT、Markdown 等全格式解析与秒级向量检索，数据完全存储在本地，安全无泄漏风险。
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- ===== 底部固定工具条 ===== -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,10,16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="💾 保存所有修改"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="16,6"
                            Margin="0,0,10,0"/>
                    <Button Content="↺ 恢复上次保存"
                            Command="{Binding RevertCommand}"
                            Style="{StaticResource TextButtonStyle}"
                            Padding="10,6"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage, Mode=OneWay}"
                           Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center"
                           Margin="14,0,14,0"/>

                <Border Grid.Column="2"
                        CornerRadius="10"
                        Background="{StaticResource WarningLightBrush}"
                        Padding="12,5"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6"
                                 Fill="{StaticResource WarningBrush}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,6,0"/>
                        <TextBlock Text="有未保存的修改"
                                   Style="{StaticResource SmallText}"
                                   Foreground="{StaticResource WarningBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
