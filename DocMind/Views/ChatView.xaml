<UserControl x:Class="DocMind.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DocMind.ViewModels"
             xmlns:m="clr-namespace:DocMind.Models"
             xmlns:cc="clr-namespace:DocMind.Controls"
             xmlns:helpers="clr-namespace:DocMind.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:NullToVisibilityConverter x:Key="NullToVis"/>
        <helpers:NullToVisibilityConverter x:Key="StringToVis"/>
        <helpers:ThinkingStepIconConverter x:Key="ThinkingStepIconConverter"/>

        <!-- 消息时间/元信息 -->
        <Style x:Key="ChatMetaText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <!-- 引用来源行 -->
        <Style x:Key="SourceLineText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>

        <!-- 气泡内操作按钮：助手消息默认品牌蓝；用户灰底气泡内改用深色文字保证对比度 -->
        <Style x:Key="BubbleActionButtonStyle" TargetType="Button" BasedOn="{StaticResource TextButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUser}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource UserBubbleTextBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 紧凑药丸型 ComboBox（用于输入舱模型选择与工具条） -->
        <Style x:Key="CompactPillComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,0,22,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- 场景探索卡片样式 (Prompt Showcase Card) -->
        <Style x:Key="PromptShowcaseCardStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Border x:Name="Bloom"
                                    Background="{DynamicResource PrimaryLightBrush}"
                                    CornerRadius="12"
                                    Opacity="0"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="0.75" ScaleY="0.75"/>
                                </Border.RenderTransform>
                            </Border>
                            <Border x:Name="CardBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{StaticResource CornerLg}"
                                    Padding="12,10"
                                    Margin="2"
                                    SnapsToDevicePixels="True"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <ContentPresenter/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource CardBrush}"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="CardBorder" Property="Effect" Value="{StaticResource ShadowBrandGlow}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Bloom" Storyboard.TargetProperty="Opacity" From="0" To="0.75" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Bloom" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.75" To="1" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Bloom" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.75" To="1" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Bloom" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14"/>
                                            <DoubleAnimation Storyboard.TargetName="Bloom" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.75" Duration="0:0:0.14"/>
                                            <DoubleAnimation Storyboard.TargetName="Bloom" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.75" Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.97" Duration="0:0:0.06"/>
                                            <DoubleAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.97" Duration="0:0:0.06"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 消息气泡模板（现代简约风：
             助手=无气泡纯文本流 + 可折叠轻量思考过程 + 搜索摘要 + 富文本引用 + 悬浮操作工具栏与Token统计；
             用户=浅灰纯色胶囊） -->
        <DataTemplate x:Key="MessageBubbleTemplate" DataType="{x:Type vm:ChatMessage}">
            <Grid x:Name="BubbleRoot" Margin="0,0,0,16">
                <Grid.Resources>
                    <BooleanToVisibilityConverter x:Key="B2V"/>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 助手头像（左侧，DocMind 智脑标识微标） -->
                <Border Grid.Column="0"
                        Width="28" Height="28"
                        CornerRadius="{StaticResource CornerLg}"
                        Margin="0,3,10,0"
                        VerticalAlignment="Top"
                        Background="{DynamicResource DocMindEmeraldLightBrush}"
                        BorderThickness="0"
                        Visibility="{Binding IsAssistant, Converter={StaticResource B2V}}"
                        ToolTip="DocMind 文献引擎">
                    <Image Source="/Assets/DocMind.png" Width="17" Height="17"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <!-- 对话流：助手=无气泡纯文本流（Markdown 直接铺排）；用户=浅灰纯色胶囊 -->
                <Border Grid.Column="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <!-- 默认（助手消息）：无气泡纯文本流，让 Markdown、代码块与表格在画布上畅通呼吸 -->
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter Property="MaxWidth" Value="860"/>
                            <Setter Property="Margin" Value="0,0,10,0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0,2,0,0"/>
                            <Style.Triggers>
                                <!-- 用户消息：右对齐 + 浅灰纯色胶囊（轻阴影增强层次，避免全平） -->
                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="MaxWidth" Value="680"/>
                                    <Setter Property="Margin" Value="40,0,0,0"/>
                                    <Setter Property="Background" Value="{DynamicResource UserBubbleBrush}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="CornerRadius" Value="18,18,4,18"/>
                                    <Setter Property="Padding" Value="14,9"/>
                                    <Setter Property="Effect" Value="{StaticResource ShadowSm}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel>
                        <!-- 1. 思考过程区（现代简约：可折叠轻量条目，无重卡片边框；
                             头部动态状态「思考中 (用时 3.2 秒)...」/「已思考（用时 5 秒）」+ 步骤轨道 + 模型原生推理链） -->
                        <StackPanel Visibility="{Binding HasThinking, Converter={StaticResource B2V}}"
                                    Margin="0,0,0,8">
                            <!-- 折叠切换头部按钮 -->
                            <Button Click="ToggleThinking_Click"
                                    HorizontalAlignment="Left"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Cursor="Hand"
                                    ToolTip="展开/收起思考过程与模型推理链">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ThinkingIconText, Mode=OneWay}"
                                               FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding ThinkingHeaderText, Mode=OneWay}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <Path Data="{StaticResource IconChevronDown}" Style="{StaticResource IconSmStyle}"
                                          Stroke="{DynamicResource TextTertiaryBrush}"
                                          Margin="6,0,0,0" VerticalAlignment="Center"
                                          Visibility="{Binding IsThinkingExpanded, Converter={StaticResource BoolToVis}}"/>
                                    <Path Data="{StaticResource IconChevronRight}" Style="{StaticResource IconSmStyle}"
                                          Stroke="{DynamicResource TextTertiaryBrush}"
                                          Margin="6,0,0,0" VerticalAlignment="Center"
                                          Visibility="{Binding IsThinkingExpanded, Converter={StaticResource InvertBoolVis}}"/>
                                </StackPanel>
                            </Button>

                            <!-- 展开内容区（左缩进，弱化容器感） -->
                            <StackPanel Visibility="{Binding IsThinkingExpanded, Converter={StaticResource BoolToVis}}"
                                        Margin="10,6,0,0">
                                <!-- A) 全链路步骤 pill（GLM 风格紧凑胶囊：图标 + 短摘要，点击展开详情；完成行收敛替换进行中行） -->
                                <ItemsControl ItemsSource="{Binding ThinkingStepPills}"
                                              Visibility="{Binding HasThinkingSteps, Converter={StaticResource B2V}}"
                                              Margin="10,0,0,4">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ThinkingStep}">
                                            <StackPanel>
                                                <Border x:Name="PillBorder"
                                                        Background="{DynamicResource BorderLightBrush}"
                                                        CornerRadius="{DynamicResource CornerSm}"
                                                        Padding="8,3"
                                                        Margin="0,2"
                                                        HorizontalAlignment="Left"
                                                        Cursor="Hand">
                                                    <Border.InputBindings>
                                                        <MouseBinding Gesture="LeftClick" Command="{Binding ToggleCommand}"/>
                                                    </Border.InputBindings>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Icon}"
                                                                   FontSize="11"
                                                                   Margin="0,0,5,0"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Summary}"
                                                                   FontSize="11.5"
                                                                   VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsBadged}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Path Data="{StaticResource IconChevronRight}" Style="{StaticResource IconSmStyle}"
                                                       Stroke="{DynamicResource TextTertiaryBrush}"
                                                       Margin="5,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsBadged}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource WarningLightBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                                <!-- 点击 pill 展开的完整详情（文件名列表、降级原因等） -->
                                                <TextBlock Text="{Binding Detail}"
                                                           FontSize="11"
                                                           Margin="10,0,0,2"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- B) 模型原生推理链（DeepSeek-R1 / Qwen3 reasoning_content 轻底色流式块） -->
                                <Border Visibility="{Binding HasThinkingText, Converter={StaticResource B2V}}"
                                        Background="{DynamicResource BorderLightBrush}"
                                        BorderThickness="0"
                                        CornerRadius="{DynamicResource CornerSm}"
                                        Padding="10,8"
                                        Margin="0,4,0,0">
                                    <TextBlock Text="{Binding ThinkingText, Mode=OneWay}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               LineHeight="18"
                                               FontFamily="Consolas, 'Cascadia Code', 'Segoe UI', sans-serif"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- 2. 搜索与来源摘要（轻量淡蓝底胶囊） -->
                        <Border Visibility="{Binding HasWebSources, Converter={StaticResource B2V}}"
                                Background="{DynamicResource PrimaryLightBrush}"
                                BorderThickness="0"
                                CornerRadius="{DynamicResource CornerSm}"
                                Padding="8,4"
                                Margin="0,0,0,6"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconSearch}" Style="{StaticResource IconSmStyle}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SearchSummaryText, Mode=OneWay}"
                                           FontSize="11.5"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- 3. 消息内容：用户消息纯文本（支持划词高亮与复制），助手消息 Markdown 渲染 -->
                        <Grid>
                            <!-- 用户消息：只读 TextBox（支持鼠标自由划词高亮、双击选词与 Ctrl+C 复制，透明无框） -->
                            <TextBox Text="{Binding Content, Mode=OneWay}"
                                     IsReadOnly="True"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     TextWrapping="Wrap"
                                     Cursor="IBeam"
                                     FontSize="15"
                                     FontWeight="Normal"
                                     Foreground="{DynamicResource UserBubbleTextBrush}"
                                     SelectionBrush="{DynamicResource UserBubbleTextBrush}"
                                     SelectionOpacity="0.35">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <!-- 助手消息：Markdig 渲染的 FlowDocument(代码块/列表/表格/可点击链接/交互角标) -->
                            <FlowDocumentScrollViewer Document="{Binding RenderedDocument, Mode=OneWay}"
                                                      Padding="0"
                                                      IsToolBarVisible="False"
                                                      VerticalScrollBarVisibility="Disabled"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      Loaded="FlowDocViewer_Loaded"
                                                      Unloaded="FlowDocViewer_Unloaded">
                                <FlowDocumentScrollViewer.Style>
                                    <Style TargetType="FlowDocumentScrollViewer">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUser}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <!-- 后置覆盖：解析失败（Document 为 null）时让位给纯文本兜底 TextBox -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsUser}" Value="False"/>
                                                    <Condition Binding="{Binding RenderedDocument}"
                                                               Value="{x:Null}"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </FlowDocumentScrollViewer.Style>
                            </FlowDocumentScrollViewer>
                            <!-- 助手消息兜底：Markdig 解析失败时 RenderedDocument 为 null，
                                 此处保证完整原文（含 Markdown 围栏符号）仍可读可复制，
                                 否则气泡正文会整块空白、内容看起来"凭空消失" -->
                            <TextBox Text="{Binding Content, Mode=OneWay}"
                                     IsReadOnly="True"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     TextWrapping="Wrap"
                                     Cursor="IBeam"
                                     FontSize="14"
                                     FontWeight="Normal"
                                     FontFamily="Consolas, 'Cascadia Code', 'Segoe UI', sans-serif"
                                     MinHeight="0"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     SelectionBrush="{StaticResource PrimaryBrush}"
                                     SelectionOpacity="0.35">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsUser}" Value="False"/>
                                                    <Condition Binding="{Binding RenderedDocument}"
                                                               Value="{x:Null}"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>

                        <!-- 4. 加载动画与思考状态（等待首字 / 非流式大包期间，透明轻量） -->
                        <Border Visibility="{Binding IsWaitingForFirstToken, Converter={StaticResource B2V}}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <cc:SkeletonControl CornerRadius="{StaticResource CornerSm}" Height="10" Width="14" Margin="0,0,4,0"/>
                                <cc:SkeletonControl CornerRadius="{StaticResource CornerSm}" Height="10" Width="10" Margin="0,0,4,0"/>
                                <cc:SkeletonControl CornerRadius="{StaticResource CornerSm}" Height="10" Width="16" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding WaitingHint, Mode=OneWay}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- 5. 流式阶段状态指示器（检索/联网搜索/生成...） -->
                        <Border Visibility="{Binding ShowStatus, Converter={StaticResource B2V}}"
                                Background="Transparent"
                                Margin="0,2,0,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6"
                                         Fill="{DynamicResource PrimaryBrush}"
                                         Margin="0,0,6,0"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StatusText, Mode=OneWay}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- 6. 证据条：一眼看清答案有多硬（库内/网页/图谱/通用知识） -->
                        <Border Visibility="{Binding HasEvidenceBar, Converter={StaticResource B2V}}"
                                Background="{DynamicResource PrimaryLightBrush}"
                                BorderThickness="0"
                                CornerRadius="{DynamicResource CornerSm}"
                                Padding="8,5"
                                Margin="0,6,0,4"
                                HorizontalAlignment="Left"
                                Cursor="Hand">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasEvidenceWarning}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource WarningLightBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleEvidenceBarCommand}"/>
                            </Border.InputBindings>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconBook}"
                                      Margin="0,0,5,0" VerticalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path" BasedOn="{StaticResource IconSmStyle}">
                                            <Setter Property="Stroke" Value="{DynamicResource PrimaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasEvidenceWarning}" Value="True">
                                                    <Setter Property="Stroke" Value="{DynamicResource WarningBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Text="{Binding EvidenceSummaryText, Mode=OneWay}"
                                           FontSize="11.5"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasEvidenceWarning}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding EvidenceExpandHint, Mode=OneWay}"
                                           FontSize="11"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- 6b. 引用来源卡片列表（无描边轻底 + 悬浮变色，可点击打开对应来源抽屉/网页） -->
                        <ItemsControl ItemsSource="{Binding Sources, Mode=OneWay}"
                                      Margin="0,4,0,0"
                                      Visibility="{Binding ShowSourcesList, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:SourceRef}">
                                    <Border CornerRadius="{DynamicResource CornerSm}"
                                            Padding="6,3"
                                            Margin="0,2,0,2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <MultiBinding Converter="{StaticResource SourceHighlight}">
                                                            <Binding Path="DataContext.HighlightedSourceIndex"
                                                                     RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                            <Binding Path="Index"/>
                                                        </MultiBinding>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0"
                                                    Command="{Binding DataContext.OpenSourceCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource TextButtonStyle}"
                                                    HorizontalAlignment="Left"
                                                    Padding="0">
                                                <Button.ToolTip>
                                                    <ToolTip>
                                                        <StackPanel MaxWidth="400">
                                                            <!-- web 来源 -->
                                                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsWebSource, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                                                                <Path Data="{StaticResource IconGlobe}" Style="{StaticResource IconSmStyle}" Margin="0,0,6,0"/>
                                                                <TextBlock Text="网页检索结果" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                                            </StackPanel>
                                                            <TextBlock Visibility="{Binding IsWebSource, Converter={StaticResource BoolToVis}}"
                                                                       Text="{Binding DisplayTitle}" TextWrapping="Wrap" FontWeight="Medium"/>
                                                            <TextBlock Visibility="{Binding IsWebSource, Converter={StaticResource BoolToVis}}"
                                                                       Text="{Binding Url}" Foreground="Blue" TextDecorations="Underline" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                            <TextBlock Visibility="{Binding IsWebSource, Converter={StaticResource BoolToVis}}"
                                                                       Text="{Binding SourceName, TargetNullValue=Web, StringFormat=来源引擎: {0}}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                                            <TextBlock Visibility="{Binding IsWebSource, Converter={StaticResource BoolToVis}}"
                                                                       Text="{Binding AuthorityBadgeText, StringFormat=来源级别: {0}}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                            <TextBlock Visibility="{Binding IsWebSource, Converter={StaticResource BoolToVis}}"
                                                                       Text="{Binding EvidenceBadgeText}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                            <!-- 本地来源 -->
                                                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsWebSource, Converter={StaticResource InvertBoolVis}}" Margin="0,0,0,4">
                                                                <Path Data="{StaticResource IconBook}" Style="{StaticResource IconSmStyle}" Margin="0,0,6,0"/>
                                                                <TextBlock Text="本地原著知识切片 (Ground Truth)" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                                            </StackPanel>
                                                            <TextBlock Visibility="{Binding IsWebSource, Converter={StaticResource InvertBoolVis}}"
                                                                       Text="{Binding DisplayTitle, StringFormat=出处文档: {0}}" TextWrapping="Wrap"/>
                                                            <TextBlock Visibility="{Binding IsWebSource, Converter={StaticResource InvertBoolVis}}"
                                                                       Text="{Binding Page, TargetNullValue=未知, StringFormat=原著页码: P{0}}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                            <TextBlock Visibility="{Binding IsWebSource, Converter={StaticResource InvertBoolVis}}"
                                                                       Text="{Binding Heading, TargetNullValue=正文, StringFormat=章节: {0}}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsWebSource, Converter={StaticResource InvertBoolVis}}" Margin="0,6,0,0">
                                                                <Path Data="{StaticResource IconLightbulb}" Style="{StaticResource IconSmStyle}" Margin="0,0,6,0"/>
                                                                <TextBlock Text="点击可在右侧抽屉展开原著切片或在【搜索】页全文查证" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </ToolTip>
                                                </Button.ToolTip>
                                                <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                                                    <TextBlock Text="{Binding Index, StringFormat=[{0}]}"
                                                               Style="{StaticResource SourceLineText}"
                                                               Foreground="{StaticResource PrimaryBrush}"
                                                               FontWeight="Bold"/>
                                                    <Path Data="{StaticResource IconGlobe}" Style="{StaticResource IconSmStyle}"
                                                               Visibility="{Binding IsWebSource, Converter={StaticResource BoolToVis}}"
                                                               Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                    <Path Data="{StaticResource IconFile}" Style="{StaticResource IconSmStyle}"
                                                               Visibility="{Binding IsWebSource, Converter={StaticResource InvertBoolVis}}"
                                                               Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DisplayTitle, Mode=OneWay}"
                                                               Style="{StaticResource SourceLineText}"
                                                               Margin="4,0,0,0"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="260"/>
                                                    <TextBlock Text="{Binding EvidenceBadgeText}"
                                                               Visibility="{Binding IsWebSource, Converter={StaticResource BoolToVis}}"
                                                               Style="{StaticResource SourceLineText}"
                                                               Foreground="{StaticResource PrimaryBrush}"
                                                               Margin="6,0,0,0"
                                                               FontSize="10"/>
                                                    <TextBlock Text="{Binding Page, Mode=OneWay, TargetNullValue='', StringFormat=(P{0})}"
                                                               Style="{StaticResource SourceLineText}"
                                                               Margin="4,0,0,0"
                                                               Visibility="{Binding IsWebSource, Converter={StaticResource InvertBoolVis}}"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- 右侧直达按钮 -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                                <Button Visibility="{Binding IsWebSource, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.OpenDirectWebCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding Url}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Padding="6,2"
                                                        FontSize="10"
                                                        ToolTip="在默认浏览器中一键直达该网页原文">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconGlobe}" Style="{StaticResource IconSmStyle}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="打开网页" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Visibility="{Binding IsWebSource, Converter={StaticResource InvertBoolVis}}"
                                                        Command="{Binding DataContext.OpenSourceCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Padding="6,2"
                                                        FontSize="10"
                                                        ToolTip="右侧对照原文件与关键点（自动定位引用段落）">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconFile}" Style="{StaticResource IconSmStyle}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="对照原文" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 7. 智能下一步行动建议胶囊 (Follow-up Action Chips) -->
                        <ItemsControl ItemsSource="{Binding FollowUpActions, Mode=OneWay}"
                                      Margin="0,8,0,2"
                                      Visibility="{Binding HasFollowUpActions, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.ExecuteActionCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Padding="10,4"
                                            Margin="0,0,8,6"
                                            ToolTip="点击直接执行该下一步行动建议">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Pill"
                                                        Background="{TemplateBinding Background}"
                                                        BorderThickness="0"
                                                        CornerRadius="{DynamicResource CornerLg}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <TextBlock Text="{Binding}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource PrimaryBrush}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 8. 底部操作工具栏（DeepSeek 风格：复制+微反馈、重试、点赞点踩、沉淀入库与Token统计条） -->
                        <DockPanel Margin="0,6,0,0">
                            <DockPanel.Style>
                                <Style TargetType="DockPanel">
                                    <Setter Property="Opacity" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=BubbleRoot}" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsIngesting}" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCopied}" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DockPanel.Style>

                            <!-- 左侧操作按钮组 -->
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <!-- 复制按钮（带已复制对勾反馈） -->
                                <Button Command="{Binding CopyCommand}"
                                        Style="{StaticResource BubbleActionButtonStyle}"
                                        FontSize="11"
                                        Padding="7,2"
                                        Visibility="{Binding CanCopy, Converter={StaticResource B2V}}"
                                        ToolTip="复制消息内容到剪贴板">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsCopied, Converter={StaticResource InvertBoolVis}}">
                                                <Path Data="{StaticResource IconCopy}" Style="{StaticResource IconSmStyle}" Margin="0,0,6,0"/>
                                                <TextBlock Text="复制"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsCopied, Converter={StaticResource BoolToVis}}">
                                                <Path Data="{StaticResource IconCheck}" Style="{StaticResource IconSmStyle}" Stroke="{StaticResource SuccessBrush}" Margin="0,0,6,0"/>
                                                <TextBlock Text="已复制" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button.Content>
                                </Button>

                                <!-- 点赞按钮 -->
                                <Button Command="{Binding ToggleLikeCommand}"
                                        Style="{StaticResource BubbleActionButtonStyle}"
                                        FontSize="11"
                                        Padding="6,2"
                                        Margin="4,0,0,0"
                                        Visibility="{Binding IsAssistant, Converter={StaticResource B2V}}"
                                        ToolTip="满意该回答">
                                    <Path Data="{StaticResource IconThumbsUp}">
                                        <Path.Style>
                                            <Style TargetType="Path" BasedOn="{StaticResource IconSmStyle}">
                                                <Setter Property="Opacity" Value="0.45"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLiked}" Value="True">
                                                        <Setter Property="Opacity" Value="1.0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Button>

                                <!-- 点踩按钮 -->
                                <Button Command="{Binding ToggleDislikeCommand}"
                                        Style="{StaticResource BubbleActionButtonStyle}"
                                        FontSize="11"
                                        Padding="6,2"
                                        Margin="4,0,0,0"
                                        Visibility="{Binding IsAssistant, Converter={StaticResource B2V}}"
                                        ToolTip="不满意该回答">
                                    <Path Data="{StaticResource IconThumbsDown}">
                                        <Path.Style>
                                            <Style TargetType="Path" BasedOn="{StaticResource IconSmStyle}">
                                                <Setter Property="Opacity" Value="0.45"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDisliked}" Value="True">
                                                        <Setter Property="Opacity" Value="1.0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Button>

                                <!-- 撤回按钮（仅最后一条用户消息） -->
                                <Button Command="{Binding DataContext.WithdrawCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource BubbleActionButtonStyle}"
                                        FontSize="11"
                                        Padding="7,2"
                                        Margin="6,0,0,0"
                                        Visibility="{Binding ShowWithdraw, Converter={StaticResource B2V}}"
                                        ToolTip="撤回此条问题并将内容回填到输入框">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconUndo}" Style="{StaticResource IconSmStyle}" Margin="0,0,6,0"/>
                                        <TextBlock Text="撤回"/>
                                    </StackPanel>
                                </Button>

                                <!-- 重新生成按钮（仅最后一条 assistant） -->
                                <Button Command="{Binding DataContext.RegenerateCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        Style="{StaticResource BubbleActionButtonStyle}"
                                        FontSize="11"
                                        Padding="7,2"
                                        Margin="6,0,0,0"
                                        Visibility="{Binding ShowRegenerate, Converter={StaticResource B2V}}"
                                        ToolTip="用当前模型重新回答最后一条问题（保留多轮上下文）">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconRefresh}" Style="{StaticResource IconSmStyle}" Margin="0,0,6,0"/>
                                        <TextBlock Text="重新生成"/>
                                    </StackPanel>
                                </Button>

                                <!-- 创作物画布预览入口（包含 Artifact 时可见） -->
                                <Button Command="{Binding DataContext.OpenArtifactCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource BubbleActionButtonStyle}"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource PrimaryBrush}"
                                        Padding="7,2"
                                        Margin="6,0,0,0"
                                        Visibility="{Binding HasArtifact, Converter={StaticResource B2V}}"
                                        ToolTip="在右侧创作工作台中查看幻灯片/研报预览与导出物理文件">
                                    <Button.Content>
                                        <TextBlock Text="{Binding ArtifactBadgeText}"/>
                                    </Button.Content>
                                </Button>

                                <!-- 沉淀入库（仅助手消息且有内容时可见） -->
                                <Button Command="{Binding DataContext.IngestMessageCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding}"
                                        FontSize="11"
                                        Padding="7,2"
                                        Margin="6,0,0,0"
                                        Visibility="{Binding IsAssistant, Converter={StaticResource B2V}}"
                                        ToolTip="将本条回答一键萃取并沉淀为知识库笔记（反哺知识库）">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource BubbleActionButtonStyle}">
                                            <Setter Property="Content" Value="沉淀入库"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsIngesting}" Value="True">
                                                    <Setter Property="Content" Value="正在沉淀..."/>
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsIngested}" Value="True">
                                                    <Setter Property="Content" Value="已沉淀入库"/>
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>

                            <!-- 右侧极简 Token 统计胶囊 -->
                            <Border DockPanel.Dock="Right"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderThickness="0"
                                    CornerRadius="{DynamicResource CornerPill}"
                                    Padding="8,2"
                                    Margin="8,0,0,0"
                                    Visibility="{Binding HasTokenStat, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding TokenStatText, Mode=OneWay}"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                            </Border>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 主对话区 (弹性占满) -->
            <ColumnDefinition Width="*" MinWidth="320"/>
            <!-- 协同出处抽屉：Auto = 关闭时整块 Collapsed 不占空间，打开时宽度由抽屉自身决定 -->
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ===== 左侧主对话区 ===== -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <!-- 工具条 -->
                <RowDefinition Height="Auto"/>
                <!-- 智能推荐提示条 -->
                <RowDefinition Height="Auto"/>
                <!-- 消息区 -->
                <RowDefinition Height="*"/>
                <!-- 输入区 -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== 顶部极简画卷头 (Minimal Canvas Header - DocMind Flow 2.0) ===== -->
            <Border Grid.Row="0"
                    Background="Transparent"
                    Padding="24,10,24,6"
                    Margin="0">
                <DockPanel LastChildFill="True">
                    <!-- 右侧操作组：场景指令灵感唤起 / 导出 / 清空 / 角色 -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding OpenPptPrefsCommand}"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                FontSize="11" Padding="9,2" Height="26"
                                Margin="0,0,6,0"
                                ToolTip="一键将知识库内容萃取并生成演示文稿 PPTX">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconChart}" Style="{StaticResource IconSmStyle}" Margin="0,0,4,0"/>
                                <TextBlock Text="制作PPT" FontWeight="Medium"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ExportChatCommand}"
                                Style="{DynamicResource IconButtonStyle}"
                                Width="28" Height="28"
                                FontSize="12" Margin="0,0,4,0"
                                ToolTip="导出当前对话为 Markdown">
                            <Path Data="{StaticResource IconExport}" Style="{StaticResource IconSmStyle}"/>
                        </Button>
                        <Button Command="{Binding ClearCommand}"
                                Style="{DynamicResource IconButtonStyle}"
                                Width="28" Height="28"
                                FontSize="12" Margin="0,0,4,0"
                                Foreground="{DynamicResource DangerBrush}"
                                ToolTip="清空本次对话"
                                Visibility="{Binding HasMessages, Converter={StaticResource BoolToVis}}">
                            <Path Data="{StaticResource IconTrash}" Style="{StaticResource IconSmStyle}" Stroke="{DynamicResource DangerBrush}"/>
                        </Button>
                        <Button Command="{Binding OpenCustomManagerCommand}"
                                Style="{DynamicResource IconButtonStyle}"
                                Width="28" Height="28"
                                FontSize="12"
                                ToolTip="管理办公角色与人设">
                            <Path Data="{StaticResource IconDrama}" Style="{StaticResource IconSmStyle}"/>
                        </Button>
                    </StackPanel>

                    <!-- 左侧：会话标题与当前知识库挂载与消息统计 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedSession.DisplayTitle, FallbackValue=新对话}"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="240"/>
                        <Border Background="{DynamicResource DocMindEmeraldLightBrush}"
                                BorderBrush="{DynamicResource DocMindEmeraldBrush}"
                                BorderThickness="0.8"
                                CornerRadius="{StaticResource CornerCapsule}" Padding="7,2"
                                Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding KnowledgeAnchorText}"
                                       FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource DocMindEmeraldBrush}"/>
                        </Border>
                        <TextBlock Text="{Binding MessagesCountText}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

        <!-- ===== 智能推荐提示条 ===== -->
        <Border Grid.Row="1"
                Background="{DynamicResource PrimaryLightBrush}"
                BorderBrush="{DynamicResource PrimaryBrush}"
                BorderThickness="0.5"
                CornerRadius="{StaticResource CornerLg}"
                Padding="12,8"
                Margin="0,6,0,0"
                HorizontalAlignment="Center" MaxWidth="920"
                Visibility="{Binding ShowRecommendation, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ApplyAllRecommendationsCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            FontSize="11" Padding="10,4" Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconCheck}" Style="{StaticResource IconSmStyle}" Stroke="{StaticResource SuccessBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="应用全部"/>
                        </StackPanel>
                    </Button>
                    <Button Content="忽略"
                            Command="{Binding DismissRecommendationCommand}"
                            Style="{StaticResource TextButtonStyle}"
                            FontSize="11" Padding="8,4" Foreground="{DynamicResource TextTertiaryBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconLightbulb}" Style="{StaticResource IconSmStyle}" Margin="0,0,6,0"/>
                        <TextBlock Text="智能推荐：" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding RecommendationReason}" FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <!-- 推荐角色 -->
                    <Border Visibility="{Binding RecommendedPersona, Converter={StaticResource NullToVis}}"
                            Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource CornerMd}" Padding="6,2" Margin="8,0,0,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="角色：" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding RecommendedPersona.DisplayName}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryBrush}"/>
                            <Button Content="切换" Command="{Binding ApplyRecommendedPersonaCommand}"
                                    Style="{StaticResource TextButtonStyle}" FontSize="10" Padding="4,0" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- 推荐主题 -->
                    <Border Visibility="{Binding RecommendedTheme, Converter={StaticResource NullToVis}}"
                            Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource CornerMd}" Padding="6,2" Margin="8,0,0,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="主题：" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding RecommendedTheme.DisplayName}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryBrush}"/>
                            <Button Content="切换" Command="{Binding ApplyRecommendedThemeCommand}"
                                    Style="{StaticResource TextButtonStyle}" FontSize="10" Padding="4,0" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== 消息列表 ===== -->
        <Grid Grid.Row="2">
            <ScrollViewer x:Name="MessageScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          ScrollChanged="MessageScroll_ScrollChanged">
                <!-- 限宽居中列：大窗口下对话聚焦在中间，贴近主流聊天软件观感 -->
                <Border HorizontalAlignment="Center" MaxWidth="920">
                    <StackPanel Margin="0,4">
                    <!-- 角色专属快捷问题（有消息时显示） -->
                    <Border Visibility="{Binding HasPersonaQuickQuestions, Converter={StaticResource BoolToVis}}"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource CornerLg}"
                            Padding="10,8" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6">
                                <Run Text="{Binding SelectedPersona.Icon, Mode=OneWay}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding SelectedPersona.DisplayName, Mode=OneWay}"/>
                                <Run Text=" 专属快捷提问："/>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding PersonaQuickQuestions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}" Command="{Binding DataContext.QuickAskCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                FontSize="11" Padding="10,5" Margin="0,0,6,6"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 欢迎空态（带一键体验与快捷提问；无卡片，聚焦内容本身） -->
                    <Border Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            MaxWidth="560"
                            HorizontalAlignment="Center"
                            Visibility="{Binding ShowEmptyGuide, Converter={StaticResource BoolToVis}}"
                            Margin="0,36,0,24">
                        <StackPanel>
                            <!-- 品牌徽标（软件自带图标） -->
                            <Image Source="/Assets/DocMind.png"
                                   Width="68" Height="68"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   SnapsToDevicePixels="True"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,12">
                                <Image.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="0"
                                                      Direction="270" Opacity="0.24" Color="{StaticResource PrimaryColor}"/>
                                </Image.Effect>
                            </Image>
                            <TextBlock Text="在你的文献里找答案"
                                       FontSize="18" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding EmptyGuideText, Mode=OneWay}"
                                       Style="{StaticResource BodyText}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       MaxWidth="440"
                                       Margin="0,0,0,18"/>

                            <!-- 操作按钮组：导入示例库 / 配置大模型（轻量圆角药丸按钮） -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,22">
                                <Button Command="{Binding IngestSampleKnowledgeCommand}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource BoolInvertConverter}}"
                                        Style="{DynamicResource SecondaryButtonStyle}"
                                        Padding="14,7"
                                        Margin="0,0,12,0"
                                        ToolTip="一键导入官方演示知识库，立即体验混合检索与溯源问答">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconRocket}" Style="{StaticResource IconSmStyle}" Margin="0,0,6,0"/>
                                        <TextBlock Text="导入示例知识库" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding NavigateToSettingsCommand}"
                                        Style="{DynamicResource SecondaryButtonStyle}"
                                        Padding="14,7"
                                        ToolTip="配置 DeepSeek、Qwen、Ollama 等端云大模型">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconSettings}" Style="{StaticResource IconSmStyle}" Margin="0,0,6,0"/>
                                        <TextBlock Text="配置推理模型" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- 场景探索卡片组：围绕 DocMind 本地库能力，而非通用 AI 闲聊 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <Path Data="{StaticResource IconBook}" Style="{StaticResource IconSmStyle}" Margin="0,0,6,0"/>
                                <TextBlock Text="从库内文献出发："
                                           Style="{StaticResource SmallText}"
                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                            </StackPanel>

                            <UniformGrid Columns="2" MaxWidth="620" HorizontalAlignment="Center">
                                <!-- 卡片 1: 知识库精准检索 -->
                                <Button Style="{StaticResource PromptShowcaseCardStyle}"
                                        Command="{Binding QuickAskCommand}"
                                        CommandParameter="请基于当前已导入的文档资料，全面梳理核心架构与关键业务能力"
                                        Margin="6" Height="76">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8"
                                                Background="{DynamicResource PrimaryLightBrush}"
                                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0">
                                            <Path Data="{StaticResource IconBook}" Style="{StaticResource IconSmStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <TextBlock Text="溯源问答" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="混合检索切片，回答带 [N] 出处与页码" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- 卡片 2: 专业 PPT 创作 -->
                                <Button Style="{StaticResource PromptShowcaseCardStyle}"
                                        Command="{Binding QuickAskCommand}"
                                        CommandParameter="请为我制作一份关于当前知识库核心业务的专业演示 PPT 大纲，包含封面、目录、核心内容页与总结"
                                        Margin="6" Height="76">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8"
                                                Background="{DynamicResource DocMindEmeraldLightBrush}"
                                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0">
                                            <Path Data="{StaticResource IconChart}" Style="{StaticResource IconSmStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <TextBlock Text="演示大纲" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="从库内要点提炼 PPT 结构，可导出 PPTX" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- 卡片 3: 方案对比矩阵 -->
                                <Button Style="{StaticResource PromptShowcaseCardStyle}"
                                        Command="{Binding QuickAskCommand}"
                                        CommandParameter="请对资料中涉及的技术方案进行多维度对比分析，输出优缺点、适用场景与推荐建议"
                                        Margin="6" Height="76">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8"
                                                Background="{DynamicResource DocMindCyanLightBrush}"
                                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0">
                                            <Path Data="{StaticResource IconClipboard}" Style="{StaticResource IconSmStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <TextBlock Text="方案对比" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="按维度拆优劣与适用场景，输出论证表" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- 卡片 4: 逻辑思维导图 -->
                                <Button Style="{StaticResource PromptShowcaseCardStyle}"
                                        Command="{Binding QuickAskCommand}"
                                        CommandParameter="请对知识库内容进行结构化梳理，输出层次分明的思维导图大纲（核心主题、子主题、关键要点）"
                                        Margin="6" Height="76">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8"
                                                Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1"
                                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0">
                                            <Path Data="{StaticResource IconBrain}" Style="{StaticResource IconSmStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <TextBlock Text="知识骨架" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="主题、分支、要点，理清概念与行动清单" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- 消息列表 -->
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <StaticResource ResourceKey="MessageBubbleTemplate"/>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

        <!-- ===== 悬浮灵动智能输入卡片 (Floating Smart Input Capsule - DocMind Flow 2.0) ===== -->
        <Border Grid.Row="3"
                Background="{DynamicResource FloatingCardBrush}"
                BorderBrush="{DynamicResource FloatingCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource CornerCapsule}"
                Effect="{DynamicResource ShadowFloating}"
                MaxWidth="860"
                Margin="24,4,24,12"
                Padding="16,10,16,8"
                HorizontalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- 行 0: 待发送附件条 -->
                    <RowDefinition Height="Auto"/>
                    <!-- 行 1: 沉浸式文本输入框 (主打字区，开阔透气) -->
                    <RowDefinition Height="Auto"/>
                    <!-- 行 2: 一体化工具栏 (知识库 + 模型 + 联网 + 灵感 + 算力徽章 + 附件 + 纸飞机) -->
                    <RowDefinition Height="Auto"/>
                    <!-- 行 3: 居中淡灰注记 -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 行 0: 待发送附件胶囊条 (文档/图片) -->
                <Border Grid.Row="0"
                        Visibility="{Binding HasPendingAttachments, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderLightBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8,4"
                        Margin="0,0,0,8">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Path Data="{StaticResource IconPaperclip}" Style="{StaticResource IconSmStyle}" Margin="0,0,6,0"/>
                                <TextBlock Text="已附加资料:" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding PendingAttachments}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBrush}"
                                                BorderBrush="{DynamicResource PrimaryBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource CornerLg}"
                                                Padding="8,2"
                                                Margin="0,0,6,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Icon}" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="11" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding FileSizeText, StringFormat=({0})}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Margin="4,0,4,0"/>
                                                <Button Content="×"
                                                        Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource TextButtonStyle}"
                                                        FontSize="12"
                                                        FontWeight="Bold"
                                                        Padding="2,0"
                                                        Cursor="Hand"
                                                        ToolTip="移除该附件"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="清空"
                                    Command="{Binding ClearAttachmentsCommand}"
                                    Style="{StaticResource TextButtonStyle}"
                                    FontSize="11"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- 行 1: 沉浸式文本输入框 (主打字区，开阔透气) -->
                <Grid Grid.Row="1" Margin="2,2,2,10">
                    <TextBox x:Name="ChatInputBox"
                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="8000"
                             ToolTip="输入问题或直接拖入文档/图片，Enter 发送，Shift+Enter 换行"
                             VerticalContentAlignment="Top"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             AllowDrop="True"
                             Drop="ChatInputBox_Drop"
                             PreviewDragOver="ChatInputBox_PreviewDragOver"
                             Padding="2,2,30,2"
                             MinHeight="56"
                             MaxHeight="150"
                             Background="Transparent"
                             BorderThickness="0"
                             FontSize="14"
                             PreviewKeyDown="ChatInputBox_PreviewKeyDown"/>
                    <!-- 占位提示：无输入时淡显 -->
                    <TextBlock Text="围绕库内切片追问 · Enter 发送 · 可拖入文档"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="13"
                               VerticalAlignment="Top"
                               HorizontalAlignment="Left"
                               Margin="4,3,0,0"
                               Visibility="{Binding HasInput, Converter={StaticResource InvertBoolVis}}"/>
                    <Button Style="{StaticResource IconButtonStyle}"
                            Command="{Binding ClearInputCommand}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Width="28" Height="28"
                            Margin="0,0,0,0"
                            ToolTip="清除本次输入内容"
                            Visibility="{Binding HasInput, Converter={StaticResource BoolToVis}}">
                        <Path Data="{StaticResource IconClose}" Style="{StaticResource IconSmStyle}" Width="12" Height="12"/>
                    </Button>
                </Grid>

                <!-- 行 2: 一体化工具底栏（左=输入侧: 知识库/附件/联网/灵感；右=处理与发送侧: 生效模型/模型选择/刷新/停止/发送） -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：输入侧控件（影响"问什么"）——知识库锚定 + 附件 + 联网 + 灵感 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- @知识库锚定微胶囊（点击弹出多选知识库面板） -->
                        <Border Background="{DynamicResource DocMindEmeraldLightBrush}"
                                BorderBrush="{DynamicResource DocMindEmeraldBrush}"
                                BorderThickness="0.8"
                                CornerRadius="{StaticResource CornerCapsule}"
                                Height="26"
                                Padding="9,0"
                                Margin="0,0,6,0"
                                Cursor="Hand"
                                ToolTip="点击选择对话检索的知识库（可多选，不勾选任何集合 = 检索全部）"
                                MouseLeftButtonDown="KnowledgeBadge_Click">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <StackPanel Width="252" Margin="4">
                                        <TextBlock Text="对话检索的知识库（可多选）"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Margin="6,4,6,6"/>
                                        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Collections}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                                  Content="{Binding Name}"
                                                                  FontSize="12"
                                                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                                                  Margin="3,2"
                                                                  Cursor="Hand"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <Separator Margin="2,4"/>
                                        <DockPanel Margin="4,2">
                                            <Button Command="{Binding LoadCollectionsCommand}"
                                                    DockPanel.Dock="Right"
                                                    Style="{DynamicResource SecondaryButtonStyle}"
                                                    Height="24" Padding="8,0"
                                                    Margin="6,0,0,0"
                                                    FontSize="11"
                                                    ToolTip="重新从后端拉取知识库集合列表">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconRefresh}" Style="{StaticResource IconSmStyle}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="刷新"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Content="新建"
                                                    Command="{Binding AddCollectionCommand}"
                                                    DockPanel.Dock="Right"
                                                    Style="{DynamicResource SecondaryButtonStyle}"
                                                    Height="24" Padding="8,0"
                                                    Margin="6,0,0,0"
                                                    FontSize="11"
                                                    ToolTip="创建新集合并勾选"/>
                                            <TextBox Text="{Binding NewCollectionName, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="11"
                                                     Padding="5,3"
                                                     ToolTip="输入新集合名后点「新建」"/>
                                        </DockPanel>
                                        <TextBlock Text="不勾选任何集合 = 检索全部知识库"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Margin="6,4,6,2"/>
                                    </StackPanel>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <TextBlock Text="{Binding KnowledgeAnchorText}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource DocMindEmeraldBrush}"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- 导入附件/图片按钮（属于输入侧，紧跟知识库锚定） -->
                        <Button Command="{Binding AddAttachmentCommand}"
                                Style="{DynamicResource IconButtonStyle}"
                                Width="30" Height="30"
                                Margin="0,0,4,0"
                                ToolTip="导入文档或图片（PDF/Word/PPT/Excel/MD/代码/图片OCR）">
                            <Path Data="{StaticResource IconPaperclip}" Style="{StaticResource IconSmStyle}"/>
                        </Button>

                        <!-- 联网搜索：关闭 / 普通搜索 / 深度搜索 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Path Data="{StaticResource IconGlobe}"
                                  Style="{StaticResource IconSmStyle}"
                                  Margin="0,0,4,0"
                                  VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding WebSearchModes}"
                                      SelectedItem="{Binding SelectedWebSearchMode, Mode=TwoWay}"
                                      DisplayMemberPath="Label"
                                      Style="{StaticResource CompactPillComboBoxStyle}"
                                      MinWidth="96"
                                      ToolTip="联网搜索模式：普通=多引擎常规检索；深度=更多来源与更长预算，适合多资料比对"/>
                        </StackPanel>

                        <!-- 灵感快捷菜单 -->
                        <Button Style="{DynamicResource SecondaryButtonStyle}"
                                Height="26"
                                Padding="8,0"
                                Margin="0,0,6,0"
                                FontSize="11"
                                ToolTip="快捷选择高频任务提示词模板"
                                Click="InspirationButton_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconSparkles}" Style="{StaticResource IconSmStyle}" Margin="0,0,6,0"/>
                                <TextBlock Text="灵感" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="制作演示文稿 PPT 大纲"
                                              Command="{Binding InsertPromptTemplateCommand}"
                                              CommandParameter="ppt"/>
                                    <MenuItem Header="撰写技术研报 / 方案论证"
                                              Command="{Binding InsertPromptTemplateCommand}"
                                              CommandParameter="report"/>
                                    <MenuItem Header="提炼思维导图大纲结构"
                                              Command="{Binding InsertPromptTemplateCommand}"
                                              CommandParameter="mindmap"/>
                                    <MenuItem Header="多维方案对比矩阵表格"
                                              Command="{Binding InsertPromptTemplateCommand}"
                                              CommandParameter="matrix"/>
                                    <MenuItem Header="核心要点萃取与行动清单"
                                              Command="{Binding InsertPromptTemplateCommand}"
                                              CommandParameter="summary"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>

                    <!-- 右侧：处理与发送侧（决定"怎么答"）——生效模型徽章 + 模型选择 + 刷新 + 停止 + 纸飞机发送圆钮 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 算力引擎徽章 -->
                        <Border Background="{DynamicResource SurfaceBrush}"
                                CornerRadius="12" Height="24" Padding="8,0"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                ToolTip="{Binding ComputeEngineBadgeTip}">
                            <TextBlock Text="{Binding ComputeEngineBadgeText}"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- 模型选择胶囊（贴近发送键，与生效模型徽章同组） -->
                        <ComboBox ItemsSource="{Binding ModelChoices}"
                                  SelectedItem="{Binding SelectedModelChoice, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  Style="{StaticResource CompactPillComboBoxStyle}"
                                  MinWidth="110"
                                  MaxWidth="170"
                                  Margin="0,0,4,0"
                                  ToolTip="{Binding EffectiveModelSummary}"/>

                        <!-- 刷新模型 -->
                        <Button Command="{Binding RefreshModelsCommand}"
                                Style="{DynamicResource IconButtonStyle}"
                                Width="24" Height="24"
                                FontSize="10"
                                Margin="0,0,8,0"
                                ToolTip="刷新可用模型">
                            <Path Data="{StaticResource IconRefresh}" Style="{StaticResource IconSmStyle}"/>
                        </Button>

                        <!-- ⏹ 停止按钮 -->
                        <Button Content="停止"
                                Command="{Binding StopCommand}"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Padding="10,4"
                                Height="30"
                                Margin="0,0,6,0"
                                Visibility="{Binding ShowStop, Converter={StaticResource BoolToVis}}"/>

                        <!-- 纸飞机圆形发送按钮：可发送时呼吸光晕 + 按压微缩 -->
                        <Button Command="{Binding SendCommand}"
                                Width="34" Height="34"
                                Cursor="Hand"
                                ToolTip="发送（Enter）">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Grid RenderTransformOrigin="0.5,0.5">
                                                    <!-- 可发送时的呼吸光晕环 -->
                                                    <Border x:Name="PulseRing"
                                                            Background="{DynamicResource PrimaryBrush}"
                                                            CornerRadius="{StaticResource CornerPill}"
                                                            Opacity="0"
                                                            Margin="-3"/>
                                                    <Border x:Name="SendRoot"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="{StaticResource CornerPill}"
                                                            SnapsToDevicePixels="True"
                                                            RenderTransformOrigin="0.5,0.5">
                                                        <Border.RenderTransform>
                                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                        </Border.RenderTransform>
                                                        <!-- 纸飞机图标 -->
                                                        <Path x:Name="AirplaneIcon"
                                                              Data="M2,21 L23,12 L2,3 L2,10 L17,12 L2,14 Z"
                                                              Fill="{DynamicResource PrimaryBrush}"
                                                              Width="13" Height="13"
                                                              Stretch="Uniform"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Margin="2,0,0,0"/>
                                                    </Border>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding HasInput}" Value="True">
                                                        <Setter TargetName="SendRoot" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                        <Setter TargetName="AirplaneIcon" Property="Fill" Value="{StaticResource TextOnAccentBrush}"/>
                                                        <Setter TargetName="SendRoot" Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Direction="270" Opacity="0.36" Color="{StaticResource PrimaryColor}"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard Name="SendPulse">
                                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                    <DoubleAnimation
                                                                        Storyboard.TargetName="PulseRing"
                                                                        Storyboard.TargetProperty="Opacity"
                                                                        From="0.08" To="0.28"
                                                                        Duration="0:0:0.9">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseInOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <StopStoryboard BeginStoryboardName="SendPulse"/>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="PulseRing" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="SendRoot" Property="Opacity" Value="0.88"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="SendRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.9" Duration="0:0:0.06"/>
                                                                    <DoubleAnimation Storyboard.TargetName="SendRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.9" Duration="0:0:0.06"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="SendRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.1"/>
                                                                    <DoubleAnimation Storyboard.TargetName="SendRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.1"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="SendRoot" Property="Opacity" Value="0.35"/>
                                                        <Setter TargetName="SendRoot" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                                        <Setter TargetName="AirplaneIcon" Property="Fill" Value="{DynamicResource TextMutedBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 行 3: 居中注记 — DocMind 身份一句话，而非通用 AI 免责 -->
                <TextBlock Grid.Row="3"
                           Text="问你的文献 · 回答带出处 · 数据留在本机"
                           FontSize="10.5"
                           Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,6,0,2"/>
            </Grid>
        </Border>
        </Grid>

        <!-- ===== 拖动把手：与抽屉同处 Column 1，浮在抽屉左边缘的 12px 留白间隙内 =====
             用 Thumb 而非 GridSplitter：宽度改的是 ViewModel 属性（经双向绑定回传），
             不会直接改写布局容器的 Width，因此抽屉关闭时列宽能正常塌陷为 0。 -->
        <Thumb Grid.Column="1"
               HorizontalAlignment="Left"
               VerticalAlignment="Stretch"
               Width="8"
               Margin="2,0,0,0"
               Cursor="SizeWE"
               DragDelta="DrawerThumb_DragDelta"
               DragCompleted="DrawerThumb_DragCompleted"
               ToolTip="拖动调整宽度"
               Visibility="{Binding IsSourceDrawerOpen, Converter={StaticResource BoolToVis}}">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Root" Background="Transparent">
                        <Rectangle x:Name="VisualBar"
                                   Width="1"
                                   HorizontalAlignment="Center"
                                   Fill="{StaticResource BorderBrush}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                            <Setter TargetName="VisualBar" Property="Width" Value="2"/>
                            <Setter TargetName="VisualBar" Property="Fill" Value="{StaticResource PrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>

        <!-- ===== 右侧协同抽屉 (双模：原著切片出处 / 创作工作台 Artifact Canvas) =====
             宽度双向绑定 ViewModel.SourceDrawerWidth：拖动把手改的是源属性，
             经 ViewModel 钳制（240~720）后回传，并落盘持久化。 -->
        <Border Grid.Column="1"
                Width="{Binding SourceDrawerWidth, Mode=TwoWay}"
                MinWidth="240"
                MaxWidth="1100"
                Margin="12,0,0,0"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerLg}"
                SnapsToDevicePixels="True"
                Visibility="{Binding IsSourceDrawerOpen, Converter={StaticResource BoolToVis}}">
            <Grid Margin="16,14">
                <!-- ==================== 模式 A：创作物工作台 (Artifacts Canvas) ==================== -->
                <Grid Visibility="{Binding IsArtifactMode, Converter={StaticResource B2V}}">
                    <Grid.RowDefinitions>
                        <!-- 头部 (标题 + 类型徽章 + 关闭) -->
                        <RowDefinition Height="Auto"/>
                        <!-- 本会话创作物清单 (横排切换，>1 个时显示) -->
                        <RowDefinition Height="Auto"/>
                        <!-- 主预览区 (PPT 卡片 / 文档内容) -->
                        <RowDefinition Height="*"/>
                        <!-- 底部导出工具条 -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 1. 创作物头部 -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconPalette}" Style="{StaticResource IconSmStyle}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="创作物工作台"
                                       Style="{StaticResource SubtitleText}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding OpenSlideShowCommand}"
                                    Visibility="{Binding IsPptArtifact, Converter={StaticResource B2V}}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="6,2"
                                    FontSize="11"
                                    Margin="0,0,4,0"
                                    ToolTip="进入客户端大屏全景放映模式">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconPlay}" Style="{StaticResource IconSmStyle}" Margin="0,0,6,0"/>
                                    <TextBlock Text="沉浸放映"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding OpenWebPreviewCommand}"
                                    Visibility="{Binding IsPptArtifact, Converter={StaticResource B2V}}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="6,2"
                                    FontSize="11"
                                    Margin="0,0,4,0"
                                    ToolTip="在默认浏览器中开启 16:9 交互式 HTML5 幻灯片放映">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconGlobe}" Style="{StaticResource IconSmStyle}" Margin="0,0,6,0"/>
                                    <TextBlock Text="网页放映"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding InspectPptCommand}"
                                    Visibility="{Binding IsPptArtifact, Converter={StaticResource B2V}}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="6,2"
                                    FontSize="11"
                                    Margin="0,0,6,0"
                                    ToolTip="全方位体检 PPT 结构完整度、文字密度与演讲准备度">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconSearch}" Style="{StaticResource IconSmStyle}" Margin="0,0,6,0"/>
                                    <TextBlock Text="效果自检"/>
                                </StackPanel>
                            </Button>

                            <Border Background="{StaticResource PrimaryLightBrush}"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedArtifact.Type, StringFormat={}{0}}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}"/>
                            </Border>
                        </StackPanel>

                        <Button Grid.Row="0" Grid.Column="2"
                                Command="{Binding CloseSourceDrawerCommand}"
                                Style="{StaticResource IconButtonStyle}"
                                Width="26" Height="26"
                                ToolTip="关闭工作台">
                            <Path Data="{StaticResource IconClose}" Style="{StaticResource IconSmStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- PPT 主题配色切换选择器 (仅 PPT 模式显示) -->
                        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0"
                              Visibility="{Binding IsPptArtifact, Converter={StaticResource B2V}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="配色主题:"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableThemes}"
                                      SelectedItem="{Binding SelectedTheme}"
                                      DisplayMemberPath="DisplayName"
                                      FontSize="12"
                                      Padding="6,3"
                                      ToolTip="切换 PPT 演示文稿企业级主题配色"/>
                        </Grid>
                    </Grid>

                    <!-- 2. 主预览区 -->
                    <!-- 2. 本会话创作物清单（一次会话常产出多个交付物，横排点选即可切换预览） -->
                    <Grid Grid.Row="1" Margin="0,0,0,10"
                          Visibility="{Binding HasMultipleArtifacts, Converter={StaticResource B2V}}">
                        <ListBox ItemsSource="{Binding SessionArtifacts}"
                                 SelectedItem="{Binding SelectedArtifact, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 MaxHeight="86"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ToolTip="本会话已产出的全部创作物，点击卡片即可切换预览">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,6" Margin="0,0,8,0" CornerRadius="8"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            Width="150">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Type}" FontSize="10" FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryBrush}"/>
                                            <TextBlock Text="{Binding Title}" FontSize="12" Margin="0,2,0,2"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Title}"/>
                                            <TextBlock FontSize="10" Foreground="{StaticResource TextTertiaryBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding SlideCount, StringFormat={}{0} 页}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPpt}" Value="False">
                                                                <Setter Property="Text" Value="文档 / 网页"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <Grid Grid.Row="2">
                        <!-- PPT 幻灯片预览卡片 -->
                        <Grid Visibility="{Binding IsPptArtifact, Converter={StaticResource B2V}}">
                            <Grid.RowDefinitions>
                                <!-- 幻灯片卡片 -->
                                <RowDefinition Height="*"/>
                                <!-- 翻页工具栏 -->
                                <RowDefinition Height="Auto"/>
                                <!-- 演讲备注 -->
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 空状态提示：无幻灯片内容时显示（避免整页空白无反馈） -->
                            <Border Grid.Row="0"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource CornerLg}"
                                    Padding="14"
                                    Visibility="{Binding HasSelectedSlide, Converter={StaticResource InvertBoolVis}}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="暂无幻灯片内容可预览"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="模型可能未输出结构化 PPT（缺少 :::artifact type=&quot;pptx&quot; 包裹或 --- 分页），可点「网页放映」查看 HTML 版，或在对话中要求重新生成。"
                                               FontSize="12"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               MaxWidth="300"/>
                                </StackPanel>
                            </Border>

                            <!-- 幻灯片模拟卡片 (16:9 质感卡片) -->
                            <Border Grid.Row="0"
                                    Background="{Binding SlideAccentSoftBrush}"
                                    BorderBrush="{Binding SlideAccentBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="{StaticResource CornerLg}"
                                    Padding="14"
                                    Margin="0,0,0,8">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <!-- 顶部科技装饰条 -->
                                        <Border Height="3" Background="{Binding SlideAccentBrush}" CornerRadius="{StaticResource CornerSm}" Margin="0,0,0,8"/>
                                        
                                        <!-- 板式类型指示标签 -->
                                        <Border Background="{Binding SlideAccentBrush}"
                                                CornerRadius="{StaticResource CornerSm}"
                                                Padding="5,1"
                                                HorizontalAlignment="Left"
                                                Margin="0,0,0,6">
                                            <TextBlock Text="{Binding SelectedSlide.Layout, StringFormat=板式: {0}}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextOnAccentBrush}"/>
                                        </Border>

                                        <!-- 幻灯片标题 -->
                                        <TextBlock Text="{Binding SelectedSlide.Title}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding SlideAccentBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,6"/>
                                        <!-- 封面副标题 (如果有) -->
                                        <TextBlock Text="{Binding SelectedSlide.Subtitle}"
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,10"
                                                   Visibility="{Binding SelectedSlide.IsCover, Converter={StaticResource B2V}}"/>

                                        <!-- 板式 A: 多列卡片网格 (Cards) -->
                                        <ItemsControl ItemsSource="{Binding SelectedSlide.Cards}"
                                                      Visibility="{Binding SelectedSlide.ShowCards, Converter={StaticResource B2V}}"
                                                      Margin="0,4,0,4">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource CardBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="{StaticResource CornerMd}"
                                                            Padding="8"
                                                            Margin="0,0,0,6">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                                                            <TextBlock Text="{Binding Content}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Visibility="{Binding Content, Converter={StaticResource StringToVis}}"/>
                                                            <ItemsControl ItemsSource="{Binding Bullets}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding StringFormat=• {0}}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="4,2,0,2"/>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- 板式 B: 大数字 KPI 看板 (Metrics) -->
                                        <ItemsControl ItemsSource="{Binding SelectedSlide.Metrics}"
                                                      Visibility="{Binding SelectedSlide.ShowMetrics, Converter={StaticResource B2V}}"
                                                      Margin="0,4,0,4">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource PrimaryLightBrush}"
                                                            CornerRadius="{StaticResource CornerMd}"
                                                            Padding="10,6"
                                                            Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Value}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Visibility="{Binding Description, Converter={StaticResource StringToVis}}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- 板式 C: 横向时间线 (Timeline) -->
                                        <ItemsControl ItemsSource="{Binding SelectedSlide.TimelineNodes}"
                                                      Visibility="{Binding SelectedSlide.ShowTimeline, Converter={StaticResource B2V}}"
                                                      Margin="0,4,0,4">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                                        <Border Background="{StaticResource PrimaryBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Stage}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextOnAccentBrush}"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- 板式 D: 金句引用 (Quote) -->
                                        <Border Background="{StaticResource PrimaryLightBrush}"
                                                CornerRadius="{StaticResource CornerMd}"
                                                Padding="12"
                                                Margin="0,4,0,4"
                                                Visibility="{Binding SelectedSlide.ShowQuote, Converter={StaticResource B2V}}">
                                            <TextBlock Text="{Binding SelectedSlide.QuoteText, StringFormat=“ {0} ”}"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       FontStyle="Italic"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       TextWrapping="Wrap"/>
                                        </Border>

                                        <!-- 板式 F: 商务对比矩阵 (Table) -->
                                        <Border Background="{StaticResource CardBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource CornerMd}"
                                                Padding="8,6"
                                                Margin="0,4,0,4"
                                                Visibility="{Binding SelectedSlide.HasTable, Converter={StaticResource B2V}}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <Path Data="{StaticResource IconList}" Style="{StaticResource IconSmStyle}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="对比矩阵"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource PrimaryBrush}"/>
                                                </StackPanel>
                                                <ItemsControl ItemsSource="{Binding SelectedSlide.TableLines}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}"
                                                                       FontSize="12"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       Margin="0,2,0,2"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- 右侧翻页大按钮 -->
                    <Button Grid.Column="2"
                            Command="{Binding NextSlideCommand}"
                            IsEnabled="{Binding CanNextSlide}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="44" Height="44"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            ToolTip="下一页 (Right Arrow / PageDown / Space)">
                        <Path Data="{StaticResource IconChevronRight}" Style="{StaticResource IconLgStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                        </Grid>
                    </Grid>


                <!-- 3. 底部悬浮演讲提词小抄 (Speaker Notes) -->
                <Border Grid.Row="2"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CornerLg}"
                        Padding="16,10"
                        Margin="0,16,0,0"
                        MaxWidth="950"
                        HorizontalAlignment="Center"
                        Visibility="{Binding IsSpeakerNotesVisibleInSlideShow, Converter={StaticResource B2V}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="演讲者实时提词小抄" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                            <TextBlock Text=" (仅您可见)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SelectedSlide.SpeakerNotes}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   LineHeight="20"/>
                    </StackPanel>
                </Border>
                </Grid>

                <!-- ==================== 模式 B：原著 × 关键点对照 ====================
                     修复：此前抽屉只挂了创作物模式，点击「对照原文」后右栏空白。
                     GroundTruthViewer 上方展示关键点（答案支撑句 + 引用原文），
                     下方嵌入 PDF 原文件并高亮定位，形成原文件与关键点对照。 -->
                <cc:GroundTruthViewerControl
                    Visibility="{Binding IsArtifactMode, Converter={StaticResource InvertBoolVis}}"
                    DataContext="{Binding}"
                    SelectedSource="{Binding SelectedSource, Mode=OneWay}"/>
            </Grid>
        </Border>

        <!-- ===== 自定义角色与主题管理面板（覆盖层） ===== -->
        <Border Background="{DynamicResource ScrimStrongBrush}"
                Visibility="{Binding IsCustomManagerOpen, Converter={StaticResource BoolToVis}}"
                MouseLeftButtonDown="CustomManagerOverlay_Click">
            <Border Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerXl}"
                    Padding="24"
                    MaxWidth="600"
                    MaxHeight="640"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSettings}" Style="{StaticResource IconMdStyle}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="自定义角色与主题"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right"
                                Command="{Binding CloseCustomManagerCommand}"
                                Style="{StaticResource TextButtonStyle}"
                                FontSize="16" Padding="6,2"
                                ToolTip="关闭">
                            <Path Data="{StaticResource IconClose}" Style="{StaticResource IconSmStyle}" Stroke="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </DockPanel>
                    <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- ── 自定义角色区 ── -->
                            <TextBlock Text="自定义角色" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding AllPersonas}" Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}"
                                                Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="8"
                                                Padding="10,6" Margin="0,0,0,4">
                                            <DockPanel>
                                                <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center"/>
                                                <Button Content="删除" DockPanel.Dock="Right"
                                                        Command="{Binding DataContext.RemoveCustomPersonaCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding Id}"
                                                        Style="{StaticResource TextButtonStyle}"
                                                        FontSize="11" Padding="6,2"
                                                        Foreground="{DynamicResource DangerBrush}"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="8"
                                    Padding="10,8" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="新增角色" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding NewPersonaIcon, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="18" TextAlignment="Center" Margin="0,0,8,0"
                                                 ToolTip="图标（一个 emoji）" MaxLength="4"/>
                                        <TextBox Grid.Column="1" Text="{Binding NewPersonaName, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="13" ToolTip="角色名称" Margin="0,0,0,8"/>
                                    </Grid>
                                    <TextBox Text="{Binding NewPersonaDescription, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12" ToolTip="角色描述" Margin="0,0,0,8"/>
                                    <Button Command="{Binding AddCustomPersonaCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Padding="12,6" HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconSparkles}" Style="{StaticResource IconSmStyle}" Margin="0,0,6,0"/>
                                            <TextBlock Text="添加角色"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- ── 自定义主题区 ── -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Path Data="{StaticResource IconPalette}" Style="{StaticResource IconSmStyle}" Margin="0,0,6,0"/>
                                <TextBlock Text="自定义主题" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding AllThemes}" Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}"
                                                Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="8"
                                                Padding="10,6" Margin="0,0,0,4">
                                            <DockPanel>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="14" Height="14" CornerRadius="{StaticResource CornerSm}"
                                                            Background="{Binding PrimaryBrush}" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                </StackPanel>
                                                <Button Content="删除" DockPanel.Dock="Right"
                                                        Command="{Binding DataContext.RemoveCustomThemeCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding Id}"
                                                        Style="{StaticResource TextButtonStyle}"
                                                        FontSize="11" Padding="6,2"
                                                        Foreground="{DynamicResource DangerBrush}"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="8"
                                    Padding="10,8" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="新增主题" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding NewThemeIcon, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="18" TextAlignment="Center" Margin="0,0,8,0"
                                                 ToolTip="图标（一个 emoji）" MaxLength="4"/>
                                        <TextBox Grid.Column="1" Text="{Binding NewThemeDisplayName, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="13" ToolTip="主题名称" Margin="0,0,0,8"/>
                                    </Grid>
                                    <TextBox Text="{Binding NewThemeDescription, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12" ToolTip="主题描述" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="主色 (Hex)" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                            <TextBox Text="{Binding NewThemePrimaryHex, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="12" ToolTip="主色十六进制值（#RRGGBB 格式）"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="背景色 (Hex)" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                            <TextBox Text="{Binding NewThemeBgHex, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="12" ToolTip="背景色十六进制值（#RRGGBB 格式）"/>
                                        </StackPanel>
                                    </Grid>
                                    <Button Command="{Binding AddCustomThemeCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Padding="12,6" HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconSparkles}" Style="{StaticResource IconSmStyle}" Margin="0,0,6,0"/>
                                            <TextBlock Text="添加主题"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Border>

        <!-- ===== 对话笔记沉淀入库微调弹窗（选区微调 / 选集合 / 改标题） =====
             ViewModel 已有 OpenIngestDialog / ConfirmIngestDialogAsync，此前 ChatView 缺 UI，
             点「沉淀入库」只改状态不出现任何界面，功能看起来像未实现。 -->
        <Border Background="{DynamicResource ScrimStrongBrush}"
                Visibility="{Binding IsIngestDialogOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerXl}"
                    Padding="20"
                    MaxWidth="560"
                    MaxHeight="640"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 弹窗头部 -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right"
                                Command="{Binding CloseIngestDialogCommand}"
                                Style="{StaticResource TextButtonStyle}"
                                FontSize="16" Padding="6,2"
                                ToolTip="关闭">
                            <Path Data="{StaticResource IconClose}" Style="{StaticResource IconSmStyle}" Stroke="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconImport}" Style="{StaticResource IconMdStyle}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="知识笔记沉淀入库"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- 表单 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="笔记标题" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding IngestDialogTitle, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="13" FontWeight="SemiBold"
                                     Margin="0,0,0,10" Padding="8,6"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="目标知识库集合" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <ComboBox IsEditable="True"
                                              ItemsSource="{Binding Collections}"
                                              DisplayMemberPath="Name"
                                              Text="{Binding IngestDialogCollection, UpdateSourceTrigger=PropertyChanged}"
                                              FontSize="12" Padding="8,6"
                                              ToolTip="可选择已有集合，也可直接输入新集合名"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="知识标签" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding IngestDialogTags, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12" Padding="8,6"
                                             ToolTip="逗号分隔，入库时会拼进笔记正文顶部"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="沉淀内容（可自由编辑、删减非重点）" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding IngestDialogContent, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="160"
                                     MaxHeight="260"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas, Cascadia Code, Segoe UI, sans-serif"
                                     FontSize="12"
                                     Padding="10,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Path Data="{StaticResource IconLightbulb}" Style="{StaticResource IconSmStyle}" Stroke="{DynamicResource TextTertiaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="确认后向量化写入本地知识库，可在检索与后续对话中被引用。"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 底部操作 -->
                    <DockPanel Grid.Row="2">
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsDialogIngesting, Converter={StaticResource BoolToVis}}"
                                    VerticalAlignment="Center">
                            <Path Data="{StaticResource IconRefresh}" Style="{StaticResource IconSmStyle}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="正在建立向量索引入库..."
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding CloseIngestDialogCommand}"
                                    Content="取消"
                                    Style="{DynamicResource SecondaryButtonStyle}"
                                    FontSize="12"
                                    Padding="12,6"
                                    Margin="0,0,8,0"/>
                            <Button Command="{Binding ConfirmIngestDialogCommand}"
                                    IsEnabled="{Binding IsDialogIngesting, Converter={StaticResource BoolInvertConverter}}"
                                    Style="{DynamicResource PrimaryButtonStyle}"
                                    FontSize="12"
                                    Padding="14,6">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconRocket}" Style="{StaticResource IconSmStyle}" Stroke="{DynamicResource TextInverseBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="确认沉淀入库"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
