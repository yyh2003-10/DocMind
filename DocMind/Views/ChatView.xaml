<UserControl x:Class="DocMind.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DocMind.ViewModels"
             xmlns:m="clr-namespace:DocMind.Models"
             xmlns:cc="clr-namespace:DocMind.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <!-- 消息时间/元信息 -->
        <Style x:Key="ChatMetaText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <!-- 引用来源行 -->
        <Style x:Key="SourceLineText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>

        <!-- 消息气泡模板 -->
        <DataTemplate x:Key="MessageBubbleTemplate" DataType="{x:Type vm:ChatMessage}">
            <Grid Margin="0,0,0,12">
                <Grid.Resources>
                    <BooleanToVisibilityConverter x:Key="B2V"/>
                </Grid.Resources>

                <!-- 用户消息右对齐，助手消息左对齐 -->
                <Border HorizontalAlignment="Left"
                        CornerRadius="12"
                        Padding="12,10"
                        MaxWidth="760"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="HorizontalAlignment" Value="Left"/>
                            <Style.Triggers>
                                <!-- 用户消息：右对齐 + 品牌色高亮 -->
                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel>
                        <!-- 消息内容：用户消息纯文本（支持划词高亮与复制），助手消息 Markdown 渲染 -->
                        <Grid>
                            <!-- 用户消息：只读 TextBox（支持鼠标自由划词高亮、双击选词与 Ctrl+C 复制，透明无框） -->
                            <TextBox Text="{Binding Content, Mode=OneWay}"
                                     IsReadOnly="True"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     TextWrapping="Wrap"
                                     Cursor="IBeam"
                                     FontSize="15"
                                     FontWeight="Medium"
                                     Foreground="{StaticResource TextPrimaryBrush}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <!-- 助手消息：Markdig 渲染的 FlowDocument(代码块/列表/表格/可点击链接) -->
                            <FlowDocumentScrollViewer Document="{Binding RenderedDocument, Mode=OneWay}"
                                                      Padding="0"
                                                      IsToolBarVisible="False"
                                                      VerticalScrollBarVisibility="Disabled"
                                                      Foreground="{StaticResource TextPrimaryBrush}">
                                <FlowDocumentScrollViewer.Style>
                                    <Style TargetType="FlowDocumentScrollViewer">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUser}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </FlowDocumentScrollViewer.Style>
                            </FlowDocumentScrollViewer>
                        </Grid>

                        <!-- 加载动画与思考状态胶囊（等待首字 / 非流式大包期间） -->
                        <Border Visibility="{Binding IsWaitingForFirstToken, Converter={StaticResource B2V}}"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,5"
                                Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <cc:SkeletonControl CornerRadius="2" Height="10" Width="14" Margin="0,0,4,0"/>
                                <cc:SkeletonControl CornerRadius="2" Height="10" Width="10" Margin="0,0,4,0"/>
                                <cc:SkeletonControl CornerRadius="2" Height="10" Width="16" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding WaitingHint, Mode=OneWay}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- 引用来源（可点击：搜索该来源在知识库中的相关内容） -->
                        <ItemsControl ItemsSource="{Binding Sources, Mode=OneWay}"
                                      Margin="0,8,0,0"
                                      Visibility="{Binding HasSources, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:SourceRef}">
                                    <Button Command="{Binding DataContext.OpenSourceCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource TextButtonStyle}"
                                            Padding="4,2"
                                            Margin="0,2,0,2">
                                        <Button.ToolTip>
                                            <ToolTip>
                                                <StackPanel MaxWidth="360">
                                                    <TextBlock Text="📖 本地原著知识切片 (Ground Truth)" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding Source, StringFormat=出处文档: {0}}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Page, TargetNullValue=未知, StringFormat=原著页码: P{0}}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding Heading, TargetNullValue=正文, StringFormat=章节: {0}}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                    <TextBlock Text="💡 点击可在【搜索】页全文查证与高亮定位" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </ToolTip>
                                        </Button.ToolTip>
                                        <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                                            <TextBlock Text="{Binding Index, StringFormat=[{0}]}"
                                                       Style="{StaticResource SourceLineText}"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Source, Mode=OneWay}"
                                                       Style="{StaticResource SourceLineText}"
                                                       Margin="6,0,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="340"/>
                                            <TextBlock Text="{Binding Page, Mode=OneWay, TargetNullValue=—, StringFormat=(P{0})}"
                                                       Style="{StaticResource SourceLineText}"
                                                       Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 元信息：模型 + 耗时 -->
                        <TextBlock Style="{StaticResource ChatMetaText}"
                                   Visibility="{Binding HasModel, Converter={StaticResource BoolToVis}}">
                            <TextBlock.Inlines>
                                <Run Text="{Binding Model, Mode=OneWay}"/>
                                <Run Text="("/><Run Text="{Binding Provider, Mode=OneWay}"/><Run Text=")"/>
                                <Run Text=" · "/><Run Text="{Binding ElapsedMs, Mode=OneWay, StringFormat={}{0}ms}"/>
                            </TextBlock.Inlines>
                        </TextBlock>

                        <!-- 智能下一步行动建议胶囊 (Follow-up Action Chips) -->
                        <ItemsControl ItemsSource="{Binding FollowUpActions, Mode=OneWay}"
                                      Margin="0,8,0,2"
                                      Visibility="{Binding HasFollowUpActions, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.ExecuteActionCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource PrimaryBrush}"
                                            BorderThickness="1"
                                            Cursor="Hand"
                                            Padding="10,4"
                                            Margin="0,0,8,6"
                                            ToolTip="点击直接执行该下一步行动建议">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Pill"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="12"
                                                        Padding="{TemplateBinding Padding}">
                                                    <TextBlock Text="{Binding}"
                                                               FontSize="12"
                                                               FontWeight="Medium"
                                                               Foreground="{StaticResource PrimaryBrush}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Pill" Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 操作行：复制（有内容即可见）+ 撤回（最后一条用户消息）+ 重新生成（仅最后一条 assistant） -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="复制"
                                    Command="{Binding CopyCommand}"
                                    Style="{StaticResource TextButtonStyle}"
                                    FontSize="11"
                                    Padding="8,2"
                                    Visibility="{Binding CanCopy, Converter={StaticResource B2V}}"
                                    ToolTip="复制消息内容到剪贴板"/>
                            <Button Content="撤回"
                                    Command="{Binding DataContext.WithdrawCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource TextButtonStyle}"
                                    FontSize="11"
                                    Padding="8,2"
                                    Margin="6,0,0,0"
                                    Visibility="{Binding ShowWithdraw, Converter={StaticResource B2V}}"
                                    ToolTip="撤回此条问题并将内容回填到输入框"/>
                            <Button Content="重新生成"
                                    Command="{Binding DataContext.RegenerateCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    Style="{StaticResource TextButtonStyle}"
                                    FontSize="11"
                                    Padding="8,2"
                                    Margin="8,0,0,0"
                                    Visibility="{Binding ShowRegenerate, Converter={StaticResource B2V}}"
                                    ToolTip="用当前模型重新回答最后一条问题（保留多轮上下文）"/>
                            <!-- 沉淀入库（仅助手消息且有内容时可见） -->
                            <Button Command="{Binding DataContext.IngestMessageCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="{Binding}"
                                    FontSize="11"
                                    Padding="8,2"
                                    Margin="8,0,0,0"
                                    Visibility="{Binding IsAssistant, Converter={StaticResource B2V}}"
                                    ToolTip="将本条回答一键萃取并沉淀为知识库笔记（反哺知识库）">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TextButtonStyle}">
                                        <Setter Property="Content" Value="📥 沉淀入库"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsIngesting}" Value="True">
                                                <Setter Property="Content" Value="⏳ 正在沉淀..."/>
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsIngested}" Value="True">
                                                <Setter Property="Content" Value="✅ 已沉淀入库"/>
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 主对话区 (弹性占满) -->
            <ColumnDefinition Width="*"/>
            <!-- 协同出处抽屉 (展开时显示) -->
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ===== 左侧主对话区 ===== -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <!-- 工具条 -->
                <RowDefinition Height="Auto"/>
                <!-- 消息区 -->
                <RowDefinition Height="*"/>
                <!-- 输入区 -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== 工具条：知识库集合（复选）+ 添加 + 清空 ===== -->
            <Border Grid.Row="0"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="14,10"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 第一行：集合标签 + 添加按钮 + 清空 -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="知识库"
                               Style="{StaticResource SmallText}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <!-- 添加知识库：输入框 + 按钮 -->
                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding NewCollectionName, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="输入新知识库名称后点击「添加」"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,8,0">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter"
                                            Command="{Binding AddCollectionCommand}"
                                            CommandParameter="{Binding NewCollectionName}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1"
                                Content="添加知识库"
                                Command="{Binding AddCollectionCommand}"
                                CommandParameter="{Binding NewCollectionName}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="10,4"/>
                    </Grid>

                    <Button Grid.Column="2"
                            Content="清空对话"
                            Command="{Binding ClearCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="8,0,0,0"
                            Visibility="{Binding HasMessages, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <!-- 第二行：知识库复选框列表（带最大高度限制与滚动） -->
                <ScrollViewer Grid.Row="1"
                              MaxHeight="80"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,2,0,4">
                    <ItemsControl ItemsSource="{Binding Collections}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CollectionItem}">
                                <CheckBox Content="{Binding Name}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,2,14,2"
                                          VerticalContentAlignment="Center"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 第三行：历史会话 + 快速切换模型 + 办公角色（三列规整排布） -->
                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 第1列：历史会话管理 -->
                    <Grid Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="会话:"
                                   Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding Sessions}"
                                  SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
                                  DisplayMemberPath="Display"
                                  ToolTip="历史会话（保存在本地知识库中，重启不丢失）。选中即载入并可继续追问"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0"/>
                        <Button Grid.Column="2"
                                Content="➕ 新会话"
                                Command="{Binding NewChatCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="8,4"
                                MinHeight="32"
                                Margin="0,0,4,0"
                                ToolTip="开始新会话（不删除历史记录）"/>
                        <Button Grid.Column="3"
                                Content="🗑 删除"
                                Command="{Binding DeleteSessionCommand}"
                                CommandParameter="{Binding SelectedSession}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="8,4"
                                MinHeight="32"
                                ToolTip="删除当前选中的历史会话（本地记录一并删除）"/>
                    </Grid>

                    <!-- 第2列：模型切换 -->
                    <Grid Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="模型:"
                                   Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableModels}"
                                  SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                                  ToolTip="按消息切换模型：默认用设置页配置；点击 ↻ 拉取当前提供商可用模型"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0"/>
                        <Button Grid.Column="2"
                                Content="🔄"
                                Command="{Binding RefreshModelsCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="8,4"
                                MinHeight="32"
                                ToolTip="获取当前提供商的可用模型列表"/>
                    </Grid>

                    <!-- 第3列：办公角色人设切换 -->
                    <Grid Grid.Column="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="角色:"
                                   Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailablePersonas}"
                                  SelectedItem="{Binding SelectedPersona, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  ToolTip="{Binding SelectedPersona.Description}"
                                  VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- ===== 消息列表 ===== -->
        <Grid Grid.Row="1">
            <ScrollViewer x:Name="MessageScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          ScrollChanged="MessageScroll_ScrollChanged">
                <StackPanel Margin="0,4">
                    <!-- 欢迎空态 -->
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="24"
                            VerticalAlignment="Center"
                            MaxWidth="420"
                            HorizontalAlignment="Center"
                            Visibility="{Binding ShowEmptyGuide, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="💬" FontSize="40" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding EmptyGuideText, Mode=OneWay}"
                                       Style="{StaticResource BodyText}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 消息列表 -->
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <StaticResource ResourceKey="MessageBubbleTemplate"/>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===== 输入区 ===== -->
        <Border Grid.Row="2"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="14,10"
                Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 场景快捷指令胶囊栏 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="快捷场景:"
                               Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <Button Content="📝 总结提炼"
                            Command="{Binding InsertPromptTemplateCommand}"
                            CommandParameter="summary"
                            Style="{StaticResource SecondaryButtonStyle}"
                            FontSize="11"
                            Padding="8,3"
                            Margin="0,0,6,0"
                            ToolTip="一键生成萃取提炼与 Action Items 待办清单指令"/>
                    <Button Content="📊 表格对比"
                            Command="{Binding InsertPromptTemplateCommand}"
                            CommandParameter="table"
                            Style="{StaticResource SecondaryButtonStyle}"
                            FontSize="11"
                            Padding="8,3"
                            Margin="0,0,6,0"
                            ToolTip="一键生成结构化 Markdown 多维对比表格指令"/>
                    <Button Content="✨ 规范润色"
                            Command="{Binding InsertPromptTemplateCommand}"
                            CommandParameter="polish"
                            Style="{StaticResource SecondaryButtonStyle}"
                            FontSize="11"
                            Padding="8,3"
                            Margin="0,0,6,0"
                            ToolTip="一键按企业公文与技术汇报规范进行润色重构"/>
                    <Button Content="⚠️ 风险评审"
                            Command="{Binding InsertPromptTemplateCommand}"
                            CommandParameter="pitfall"
                            Style="{StaticResource SecondaryButtonStyle}"
                            FontSize="11"
                            Padding="8,3"
                            Margin="0,0,6,0"
                            ToolTip="一键进行专家级把关，列出潜在风险与避坑建议"/>
                </StackPanel>

                <!-- 文本输入与发送按钮 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,8,0">
                        <TextBox x:Name="ChatInputBox"
                                 Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="输入问题，Enter 发送，Shift+Enter 换行。支持多轮追问"
                                 VerticalContentAlignment="Top"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="14,8,36,8"
                                 MinHeight="38"
                                 MaxHeight="120"
                                 PreviewKeyDown="ChatInputBox_PreviewKeyDown"/>
                        <Button Content="×"
                                Style="{StaticResource TextButtonStyle}"
                                Command="{Binding ClearCommand}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Padding="6,2"
                                Margin="0,0,6,0"
                                Visibility="{Binding HasInput, Converter={StaticResource BoolToVis}}"/>
                    </Grid>

                    <Button Grid.Column="1"
                            Content="发送"
                            Command="{Binding SendCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="80"
                            MinHeight="36"/>

                    <Button Grid.Column="2"
                            Content="停止"
                            Command="{Binding StopCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="80"
                            MinHeight="36"
                            Margin="8,0,0,0"
                            Visibility="{Binding ShowStop, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Grid>
        </Border>
        </Grid>

        <!-- ===== 右侧协同出处抽屉 (Context Inspector Drawer) ===== -->
        <Border Grid.Column="1"
                Width="360"
                Margin="12,0,0,0"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                SnapsToDevicePixels="True"
                Visibility="{Binding IsSourceDrawerOpen, Converter={StaticResource BoolToVis}}">
            <Grid Margin="16,14">
                <Grid.RowDefinitions>
                    <!-- 抽屉头部 (标题 + 评分 + 关闭按钮) -->
                    <RowDefinition Height="Auto"/>
                    <!-- 元数据卡片 (文件名、章节、页码) -->
                    <RowDefinition Height="Auto"/>
                    <!-- 原文切片标题 -->
                    <RowDefinition Height="Auto"/>
                    <!-- 原文切片内容 -->
                    <RowDefinition Height="*"/>
                    <!-- 底部操作按钮 -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. 抽屉头部 -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📖 原著知识切片"
                                   Style="{StaticResource SubtitleText}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 相似度评分 -->
                    <Border Grid.Column="1"
                            Background="{StaticResource PrimaryLightBrush}"
                            CornerRadius="4"
                            Padding="6,2"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedSource.Score, StringFormat=匹配度 {0:F2}}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                    </Border>

                    <!-- 关闭按钮 -->
                    <Button Grid.Column="2"
                            Content="✕"
                            Command="{Binding CloseSourceDrawerCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            Width="26" Height="26"
                            ToolTip="关闭切片预览 (Esc)"/>
                </Grid>

                <!-- 2. 出处元数据卡片 -->
                <Border Grid.Row="1"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,8"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <!-- 文档名 -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="文档：" Style="{StaticResource SmallText}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedSource.DisplayTitle}"
                                       Style="{StaticResource SmallText}"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>

                        <!-- 章节 & 页码 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding SelectedSource.Heading, TargetNullValue=正文章节, StringFormat=章节：{0}}"
                                       Style="{StaticResource SmallText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedSource.Page, TargetNullValue=—, StringFormat=第 P{0} 页}"
                                       Style="{StaticResource SmallText}"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       FontWeight="SemiBold"
                                       Margin="6,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. 原文切片标题 -->
                <TextBlock Grid.Row="2"
                           Text="正文切片 (Ground Truth)"
                           Style="{StaticResource SmallText}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,6"/>

                <!-- 4. 正文切片内容 (只读 TextBox，支持划词选择复制) -->
                <Border Grid.Row="3"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8"
                        Margin="0,0,0,12">
                    <TextBox Text="{Binding SelectedSourceSnippet, Mode=OneWay}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Background="Transparent"
                             BorderThickness="0"
                             FontSize="13"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             Cursor="IBeam"/>
                </Border>

                <!-- 5. 底部操作栏 -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="📋 复制原文"
                            Command="{Binding CopySourceSnippetCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="8,6"
                            Margin="0,0,4,0"
                            ToolTip="复制当前切片正文到剪贴板"/>

                    <Button Grid.Column="1"
                            Content="🔍 全文检索"
                            Command="{Binding SearchSourceInSearchPageCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="8,6"
                            Margin="4,0,0,0"
                            ToolTip="跳转至搜索页检索此文档的更多分块"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>