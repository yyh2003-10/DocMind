<UserControl x:Class="DocMind.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DocMind.ViewModels"
             xmlns:m="clr-namespace:DocMind.Models"
             xmlns:cc="clr-namespace:DocMind.Controls"
             xmlns:helpers="clr-namespace:DocMind.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:NullToVisibilityConverter x:Key="NullToVis"/>
        <helpers:NullToVisibilityConverter x:Key="StringToVis"/>
        <helpers:ThinkingStepIconConverter x:Key="ThinkingStepIconConverter"/>

        <!-- 消息时间/元信息 -->
        <Style x:Key="ChatMetaText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <!-- 引用来源行 -->
        <Style x:Key="SourceLineText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>

        <!-- 气泡内操作按钮：助手消息默认品牌蓝；用户灰底气泡内改用深色文字保证对比度 -->
        <Style x:Key="BubbleActionButtonStyle" TargetType="Button" BasedOn="{StaticResource TextButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUser}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource UserBubbleTextBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 紧凑药丸型 ComboBox（用于输入舱模型选择与工具条） -->
        <Style x:Key="CompactPillComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,0,22,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- 场景探索卡片样式 (Prompt Showcase Card) -->
        <Style x:Key="PromptShowcaseCardStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Border x:Name="Bloom"
                                    Background="{DynamicResource PrimaryLightBrush}"
                                    CornerRadius="{StaticResource CornerLg}"
                                    Opacity="0"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="0.75" ScaleY="0.75"/>
                                </Border.RenderTransform>
                            </Border>
                            <Border x:Name="CardBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{StaticResource CornerLg}"
                                    Padding="12,10"
                                    Margin="2"
                                    SnapsToDevicePixels="True"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <ContentPresenter/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource CardBrush}"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="CardBorder" Property="Effect" Value="{StaticResource ShadowBrandGlow}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Bloom" Storyboard.TargetProperty="Opacity" From="0" To="0.75" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Bloom" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.75" To="1" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Bloom" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.75" To="1" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Bloom" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14"/>
                                            <DoubleAnimation Storyboard.TargetName="Bloom" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.75" Duration="0:0:0.14"/>
                                            <DoubleAnimation Storyboard.TargetName="Bloom" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.75" Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.97" Duration="0:0:0.06"/>
                                            <DoubleAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.97" Duration="0:0:0.06"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 消息气泡模板（现代简约风：
             助手=无气泡纯文本流 + 可折叠轻量思考过程 + 搜索摘要 + 富文本引用 + 悬浮操作工具栏与Token统计；
             用户=浅灰纯色胶囊） -->
        <DataTemplate x:Key="MessageBubbleTemplate" DataType="{x:Type vm:ChatMessage}">
            <!--
              现代 AI 对话气泡（对齐 ChatGPT / ima / DeepSeek）：
              · 用户：右侧紧凑胶囊，仅正文，自适应高度，max-width ~70%
              · 助手：左侧品牌点 + 无卡片正文流（思考可折叠 / 引用角标 / 来源行 / 操作行）
              · 重内容（HTML 整页）放输入条上方阅读区，不进气泡、不挡输入
            -->
            <Grid Margin="0,0,0,20">
                <Grid.Resources>
                    <BooleanToVisibilityConverter x:Key="B2V"/>
                </Grid.Resources>

                <!-- ========== 用户消息：右对齐紧凑气泡 ========== -->
                <StackPanel HorizontalAlignment="Right" Margin="72,0,0,0"
                            Visibility="{Binding IsUser, Converter={StaticResource B2V}}">
                    <Border MaxWidth="620"
                            Padding="14,10,14,10"
                            CornerRadius="18,18,4,18"
                            Visibility="{Binding HasContent, Converter={StaticResource BoolToVis}}"
                            Background="{DynamicResource UserBubbleBrush}"
                            BorderBrush="{DynamicResource UserBubbleBorderBrush}"
                            BorderThickness="1"
                            Effect="{DynamicResource ShadowSm}">
                        <TextBlock Text="{Binding Content, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   FontSize="15"
                                   LineHeight="22"
                                   Foreground="{DynamicResource UserBubbleTextBrush}"
                                   Cursor="IBeam"/>
                    </Border>
                    <!-- 用户消息操作行：复制 / 撤回 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                Margin="0,6,4,0">
                        <Button Command="{Binding CopyCommand}"
                                ToolTip="复制消息内容"
                                Padding="6,2" Margin="0,0,4,0"
                                Style="{DynamicResource TextButtonStyle}"
                                Visibility="{Binding CanCopy, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconCopy}" Style="{StaticResource IconSmStyle}"
                                      Stroke="{DynamicResource TextTertiaryBrush}" Margin="0,0,4,0"/>
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="复制"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCopied}" Value="True">
                                                    <Setter Property="Text" Value="已复制 ✓"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DataContext.WithdrawCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                CommandParameter="{Binding}"
                                ToolTip="撤回此消息并回填到输入框"
                                Padding="6,2"
                                Style="{DynamicResource TextButtonStyle}"
                                Visibility="{Binding ShowWithdraw, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="撤回" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- ========== 助手消息：左对齐正文流 ========== -->
                <Grid Visibility="{Binding IsAssistant, Converter={StaticResource B2V}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 品牌点（24px，对齐首行） -->
                    <Border Width="24" Height="24"
                            CornerRadius="12"
                            Margin="0,4,10,0"
                            VerticalAlignment="Top"
                            Background="{DynamicResource DocMindEmeraldLightBrush}">
                        <Image Source="/Assets/DocMind.png" Width="14" Height="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <StackPanel Grid.Column="1" MaxWidth="860" Margin="0,0,8,0" ClipToBounds="True">
                        <!-- 思考过程（默认收起） -->
                        <StackPanel Visibility="{Binding HasThinking, Converter={StaticResource B2V}}"
                                    Margin="0,0,0,10">
                            <Button Click="ToggleThinking_Click"
                                    HorizontalAlignment="Left"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Cursor="Hand"
                                    ToolTip="展开/收起思考过程">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ThinkingIconText, Mode=OneWay}"
                                               FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding ThinkingHeaderText, Mode=OneWay}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <Path Data="{StaticResource IconChevronDown}" Style="{StaticResource IconSmStyle}"
                                          Stroke="{DynamicResource TextTertiaryBrush}" Margin="6,0,0,0"
                                          VerticalAlignment="Center"
                                          Visibility="{Binding IsThinkingExpanded, Converter={StaticResource BoolToVis}}"/>
                                    <Path Data="{StaticResource IconChevronRight}" Style="{StaticResource IconSmStyle}"
                                          Stroke="{DynamicResource TextTertiaryBrush}" Margin="6,0,0,0"
                                          VerticalAlignment="Center"
                                          Visibility="{Binding IsThinkingExpanded, Converter={StaticResource InvertBoolVis}}"/>
                                </StackPanel>
                            </Button>
                            <ItemsControl ItemsSource="{Binding ThinkingStepPills}"
                                          Visibility="{Binding IsThinkingExpanded, Converter={StaticResource BoolToVis}}"
                                          Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceBrush}"
                                                CornerRadius="8" Padding="8,4" Margin="0,0,6,6"
                                                ToolTip="{Binding Detail}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Icon}" FontSize="11"
                                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding Summary}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- 模型推理链（reasoning_content） -->
                            <TextBlock Text="{Binding ThinkingText, Mode=OneWay}"
                                       Margin="0,8,0,0"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       LineHeight="18"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       TextWrapping="Wrap"
                                       Opacity="0.9"/>

                        </StackPanel>

                        <!-- HTML 整页：与思考过程同一条消息流连续展示（卡片式，框内滚动） -->
                        <Border Margin="0,8,0,12"
                                MaxHeight="240"
                                ClipToBounds="True"
                                CornerRadius="12"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                Background="{DynamicResource CardBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHtmlAnswer}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <cc:HtmlAnswerBubble HtmlSource="{Binding Content, Mode=OneWay}"
                                                 IsStreaming="{Binding IsLoading, Mode=OneWay}"
                                                 AllowCdn="{Binding DataContext.HtmlAllowCdn, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                 Loaded="HtmlBubble_Loaded"
                                                 MaxHeight="240"
                                                 ClipToBounds="True"/>
                        </Border>

                        <!-- 正文：Markdown FlowDocument（自适应高度，跟对话滚动） -->
                        <FlowDocumentScrollViewer Document="{Binding RenderedDocument, Mode=OneWay}"
                                                  Padding="0"
                                                  IsToolBarVisible="False"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                                  Loaded="FlowDocViewer_Loaded"
                                                  Unloaded="FlowDocViewer_Unloaded">
                            <FlowDocumentScrollViewer.Style>
                                <Style TargetType="FlowDocumentScrollViewer">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RenderedDocument}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsHtmlAnswer}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </FlowDocumentScrollViewer.Style>
                        </FlowDocumentScrollViewer>

                        <!-- 纯文本兜底（解析失败） -->
                        <TextBlock Text="{Binding Content, Mode=OneWay}"
                                   TextWrapping="Wrap" FontSize="15" LineHeight="22"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Cursor="IBeam">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowTextFallback}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- 证据条 -->
                        <TextBlock Text="{Binding EvidenceSummaryText, Mode=OneWay}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Margin="0,12,0,0"
                                   Visibility="{Binding HasEvidenceBar, Converter={StaticResource B2V}}"/>

                        <!-- 来源行：紧凑 chip，点击对照原文 -->
                        <ItemsControl ItemsSource="{Binding Sources, Mode=OneWay}"
                                      Margin="0,10,0,0"
                                      Visibility="{Binding HasSources, Converter={StaticResource B2V}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,8,6" Padding="10,5"
                                            Style="{DynamicResource SecondaryButtonStyle}"
                                            Content="{Binding DisplayTitle}"
                                            ToolTip="对照原文"
                                            Command="{Binding DataContext.OpenSourceCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                                                <!-- Agent 轨迹时间线（回看） -->
                        <StackPanel Margin="0,10,0,0"
                                    Visibility="{Binding HasTrajectory, Converter={StaticResource BoolToVis}}">
                            <Button HorizontalAlignment="Left"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Cursor="Hand"
                                    Command="{Binding ToggleTrajectoryCommand}"
                                    ToolTip="展开/收起 Agent 工具轨迹">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🧭" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Agent 轨迹" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <Path Data="{StaticResource IconChevronDown}" Style="{StaticResource IconSmStyle}"
                                          Stroke="{DynamicResource TextTertiaryBrush}" Margin="6,0,0,0"
                                          VerticalAlignment="Center"
                                          Visibility="{Binding IsTrajectoryExpanded, Converter={StaticResource BoolToVis}}"/>
                                    <Path Data="{StaticResource IconChevronRight}" Style="{StaticResource IconSmStyle}"
                                          Stroke="{DynamicResource TextTertiaryBrush}" Margin="6,0,0,0"
                                          VerticalAlignment="Center"
                                          Visibility="{Binding IsTrajectoryExpanded, Converter={StaticResource InvertBoolVis}}"/>
                                </StackPanel>
                            </Button>
                            <ItemsControl ItemsSource="{Binding TrajectorySteps}"
                                          Visibility="{Binding IsTrajectoryExpanded, Converter={StaticResource BoolToVis}}"
                                          Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Step}" FontSize="11"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       Width="20" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DisplayText}" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

<!-- 消息操作行：复制 / 赞 / 踩 / 记住 / 沉淀入库 / 重新生成 / 继续写 + Token -->
                        <DockPanel Margin="0,12,0,0" LastChildFill="False"
                                   Visibility="{Binding IsLoading, Converter={StaticResource InvertBoolVis}}">
                            <!-- 右侧 Token 统计 -->
                            <Border DockPanel.Dock="Right"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="6,1.5"
                                    Visibility="{Binding HasTokenStat, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding TokenStatText, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                            </Border>

                            <!-- 左侧操作按钮 -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- 复制 -->
                                <Button Command="{Binding CopyCommand}"
                                        ToolTip="复制回答"
                                        Padding="6,2" Margin="0,0,2,0"
                                        Style="{DynamicResource TextButtonStyle}"
                                        Visibility="{Binding CanCopy, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconCopy}" Style="{StaticResource IconSmStyle}"
                                              Stroke="{DynamicResource TextTertiaryBrush}" Margin="0,0,4,0"/>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="复制"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCopied}" Value="True">
                                                            <Setter Property="Text" Value="已复制 ✓"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>

                                <!-- 点赞 -->
                                <Button Command="{Binding ToggleLikeCommand}"
                                        ToolTip="点赞此回答"
                                        Padding="6,2" Margin="0,0,2,0"
                                        Style="{DynamicResource TextButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconThumbsUp}" Margin="0,0,4,0">
                                            <Path.Style>
                                                <Style TargetType="Path" BasedOn="{StaticResource IconSmStyle}">
                                                    <Setter Property="Stroke" Value="{DynamicResource TextTertiaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLiked}" Value="True">
                                                            <Setter Property="Stroke" Value="{DynamicResource PrimaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <TextBlock Text="赞" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLiked}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>

                                <!-- 点踩 -->
                                <Button Command="{Binding ToggleDislikeCommand}"
                                        ToolTip="点踩此回答"
                                        Padding="6,2" Margin="0,0,2,0"
                                        Style="{DynamicResource TextButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconThumbsDown}" Margin="0,0,4,0">
                                            <Path.Style>
                                                <Style TargetType="Path" BasedOn="{StaticResource IconSmStyle}">
                                                    <Setter Property="Stroke" Value="{DynamicResource TextTertiaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDisliked}" Value="True">
                                                            <Setter Property="Stroke" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <TextBlock Text="踩" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDisliked}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>

                                <!-- 记住到用户记忆 -->
                                <Button Command="{Binding DataContext.RememberMessageCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="保存到用户记忆，后续对话会参考"
                                        Padding="6,2" Margin="0,0,2,0"
                                        Style="{DynamicResource TextButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconBookmark}" Style="{StaticResource IconSmStyle}"
                                              Stroke="{DynamicResource TextTertiaryBrush}" Margin="0,0,4,0"/>
                                        <TextBlock Text="记住" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    </StackPanel>
                                </Button>

                                <!-- 沉淀入库 -->
                                <Button Command="{Binding DataContext.IngestMessageCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="将此回答沉淀为知识库笔记"
                                        Padding="6,2" Margin="0,0,2,0"
                                        Style="{DynamicResource TextButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconSave}" Style="{StaticResource IconSmStyle}"
                                              Stroke="{DynamicResource TextTertiaryBrush}" Margin="0,0,4,0"/>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="沉淀入库"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsIngesting}" Value="True">
                                                            <Setter Property="Text" Value="沉淀中…"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsIngested}" Value="True">
                                                            <Setter Property="Text" Value="已入库"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>

                                <!-- 重新生成 -->
                                <Button Command="{Binding DataContext.RegenerateCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        ToolTip="重新生成此回答"
                                        Padding="6,2" Margin="0,0,2,0"
                                        Style="{DynamicResource TextButtonStyle}"
                                        Visibility="{Binding ShowRegenerate, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconRefresh}" Style="{StaticResource IconSmStyle}"
                                              Stroke="{DynamicResource TextTertiaryBrush}" Margin="0,0,4,0"/>
                                        <TextBlock Text="重新生成" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    </StackPanel>
                                </Button>

                                <!-- 继续写（截断/部分回答） -->
                                <Button Command="{Binding DataContext.ContinueWritingCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        ToolTip="在当前回答后继续补全"
                                        Padding="6,2"
                                        Style="{DynamicResource TextButtonStyle}"
                                        Visibility="{Binding ShowContinueWriting, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconChevronRight}" Style="{StaticResource IconSmStyle}"
                                              Stroke="{DynamicResource PrimaryBrush}" Margin="0,0,4,0"/>
                                        <TextBlock Text="继续写" FontSize="11" Foreground="{DynamicResource PrimaryBrush}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>

    </UserControl.Resources>

    <Grid ClipToBounds="True">
        <Grid.ColumnDefinitions>
            <!-- 主对话区 (弹性占满) -->
            <ColumnDefinition Width="*" MinWidth="320"/>
            <!-- 协同出处抽屉：Auto = 关闭时整块 Collapsed 不占空间，打开时宽度由抽屉自身决定 -->
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ===== 左侧主对话区（整体裁剪：WebView 空域不得画出本列/标题栏） -->
        <Grid Grid.Column="0" ClipToBounds="True">
            <Grid.RowDefinitions>
                <!-- 工具条 -->
                <RowDefinition Height="Auto"/>
                <!-- 智能推荐提示条 -->
                <RowDefinition Height="Auto"/>
                <!-- 消息区 -->
                <RowDefinition Height="*"/>
                <!-- HTML 整页阅读区（不遮挡、不进气泡） -->
                <RowDefinition Height="Auto"/>
                <!-- 输入区 -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== 消息列表（Row=2） ===== -->
            <ScrollViewer x:Name="MessageScroll"
                          Grid.Row="2"
                          ClipToBounds="True"
                          Padding="0,0,0,4"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PreviewMouseWheel="MessageScroll_PreviewMouseWheel"
                          ScrollChanged="MessageScroll_ScrollChanged">
                <Border HorizontalAlignment="Center" MaxWidth="920" Margin="24,8,24,12">
                    <StackPanel>
                        <!-- 首次使用三步引导：空态直接给出下一步动作，不要求用户先读日志或发送失败请求。 -->
                        <!-- P0.1 换嵌入未重建：对话页持久强警告横幅 + 直达重建索引 -->
                        <Border Background="{DynamicResource WarningLightBrush}"
                                BorderBrush="{DynamicResource WarningBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,10"
                                Margin="0,8,0,8"
                                MaxWidth="760"
                                HorizontalAlignment="Center"
                                Visibility="{Binding ShowLibraryReindexBanner, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="⚠ 检索可能降级：嵌入模型与索引维度不一致"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding LibraryStatusSummary}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="去重建索引"
                                            Style="{DynamicResource SecondaryButtonStyle}"
                                            Command="{Binding NavigateToDocumentsCommand}"
                                            Padding="12,6"
                                            Margin="0,0,8,0"/>
                                    <Button Content="重新检测"
                                            Style="{DynamicResource TextButtonStyle}"
                                            Command="{Binding RefreshLibraryStatusCommand}"
                                            Padding="8,6"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- L2 权限确认卡片 -->
                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource PrimaryBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,10"
                                Margin="0,8,0,8"
                                MaxWidth="760"
                                HorizontalAlignment="Center"
                                Visibility="{Binding HasPendingPermission, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Agent 请求写入工作区"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0">
                                        <Run Text="工具："/><Run Text="{Binding PendingPermissionToolId, Mode=OneWay}"/>
                                        <Run Text="。允许后本会话后续写入将自动放行；拒绝则模型改道。"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="允许"
                                            Style="{DynamicResource PrimaryButtonStyle}"
                                            Command="{Binding AllowPermissionCommand}"
                                            Padding="14,6"
                                            Margin="0,0,8,0"/>
                                    <Button Content="拒绝"
                                            Style="{DynamicResource SecondaryButtonStyle}"
                                            Command="{Binding DenyPermissionCommand}"
                                            Padding="14,6"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Visibility="{Binding ShowEmptyGuide, Converter={StaticResource BoolToVis}}"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CornerLg}"
                                Padding="22,20"
                                Margin="0,18,0,18"
                                MaxWidth="760"
                                HorizontalAlignment="Center">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Path Data="{StaticResource IconChat}" Style="{StaticResource IconSmStyle}" Margin="0,0,8,0"/>
                                    <TextBlock Text="开始使用 DocMind" FontSize="20" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding EmptyGuideText}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="13" LineHeight="21" TextWrapping="Wrap" Margin="0,0,0,18"/>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="01  配置模型" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="选择服务商并测试连接" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="02  导入资料" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="导入后等待状态变为可检索" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="03  开始提问" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="回答会附带可打开的证据来源" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="配置模型"
                                            Command="{Binding NavigateToSettingsCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Padding="16,8" Margin="0,0,8,0"/>
                                    <Button Content="导入资料"
                                            Command="{Binding NavigateToImportCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="16,8" Margin="0,0,8,0"/>
                                    <Button Content="试试示例问题"
                                            Command="{Binding AskQuickQuestionCommand}"
                                            CommandParameter="这份资料的核心结论是什么？"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="16,8"
                                            Visibility="{Binding IsLlmConfigured, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 角色专属快捷问题（有消息时显示） -->
                        <Border Visibility="{Binding HasPersonaQuickQuestions, Converter={StaticResource BoolToVis}}"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="{StaticResource CornerLg}"
                                Padding="10,8" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6">
                                    <Run Text="{Binding SelectedPersona.Icon, Mode=OneWay}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding SelectedPersona.DisplayName, Mode=OneWay}"/>
                                    <Run Text=" 专属快捷提问"/>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding PersonaQuickQuestions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="0,0,8,6" Padding="10,5"
                                                    Style="{DynamicResource SecondaryButtonStyle}"
                                                    Content="{Binding}"
                                                    Command="{Binding DataContext.AskQuickQuestionCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 消息气泡列表 -->
                        <ItemsControl ItemsSource="{Binding Messages}"
                                      HorizontalAlignment="Stretch">
                            <ItemsControl.ItemTemplate>
                                <StaticResource ResourceKey="MessageBubbleTemplate"/>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- ===== 消息区内容见下方 ScrollViewer；本行起为输入条 ===== -->
            <!-- HTML 整页阅读区：独立栏，ClipToBounds，绝不遮挡输入 -->
            <Border Grid.Row="3"
                    Margin="24,0,24,8"
                    MaxHeight="280"
                    ClipToBounds="True"
                    CornerRadius="{StaticResource CornerLg}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Background="{DynamicResource CardBrush}"
                    Visibility="{Binding HasHtmlMessage, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="10,8,10,4" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="页面预览"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <Button DockPanel.Dock="Right"
                                Content="导出 HTML"
                                Style="{DynamicResource TextButtonStyle}"
                                Command="{Binding ExportHtmlPageCommand}"
                                FontSize="{StaticResource FontSizeCaption}"
                                Padding="8,2"/>
                    </DockPanel>
                    <cc:HtmlAnswerBubble Grid.Row="1"
                                         HtmlSource="{Binding HtmlDisplaySource, Mode=OneWay}"
                                         IsStreaming="{Binding IsHtmlStreaming, Mode=OneWay}"
                                         AllowCdn="{Binding HtmlAllowCdn, Mode=OneWay}"
                                         MaxHeight="240"
                                         ClipToBounds="True"
                                         Margin="8,0,8,8"/>
                </Grid>
            </Border>

            <Border Grid.Row="4"
                Panel.ZIndex="100"
                Background="{DynamicResource FloatingCardBrush}"
                BorderBrush="{DynamicResource FloatingCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource CornerCapsule}"
                Effect="{DynamicResource ShadowFloating}"
                MaxWidth="860"
                Margin="24,8,24,14"
                Padding="18,12,18,10"
                HorizontalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- 行 0: 待发送附件条 -->
                    <RowDefinition Height="Auto"/>
                    <!-- 行 1: 沉浸式文本输入框 (主打字区，开阔透气) -->
                    <RowDefinition Height="Auto"/>
                    <!-- 行 2: 一体化工具栏 (知识库 + 模型 + 联网 + 灵感 + 算力徽章 + 附件 + 纸飞机) -->
                    <RowDefinition Height="Auto"/>
                    <!-- 行 3: 居中淡灰注记 -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 行 0: 待发送附件胶囊条 (文档/图片) -->
                <Border Grid.Row="0"
                        Visibility="{Binding HasPendingAttachments, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderLightBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CornerMd}"
                        Padding="8,4"
                        Margin="0,0,0,8">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Path Data="{StaticResource IconPaperclip}" Style="{StaticResource IconSmStyle}" Margin="0,0,6,0"/>
                                <TextBlock Text="已附加资料:" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding PendingAttachments}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBrush}"
                                                BorderBrush="{DynamicResource PrimaryBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource CornerLg}"
                                                Padding="8,2"
                                                Margin="0,0,6,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Icon}" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSmall}" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding FileSizeText, StringFormat=({0})}" FontSize="{StaticResource FontSizeMicro}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="4,0,4,0"/>
                                                <Button Content="×"
                                                        Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource TextButtonStyle}"
                                                        FontSize="{StaticResource FontSizeCaption}"
                                                        FontWeight="Bold"
                                                        Padding="2,0"
                                                        Cursor="Hand"
                                                        ToolTip="移除该附件"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="清空"
                                    Command="{Binding ClearAttachmentsCommand}"
                                    Style="{StaticResource TextButtonStyle}"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- 行 1: 沉浸式文本输入框 (主打字区，开阔透气) -->
                <Grid Grid.Row="1" Margin="2,2,2,10">
                    <TextBox x:Name="ChatInputBox"
                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="8000"
                             ToolTip="输入问题或直接拖入文档/图片，Enter 发送，Shift+Enter 换行"
                             VerticalContentAlignment="Top"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             AllowDrop="True"
                             Drop="ChatInputBox_Drop"
                             PreviewDragOver="ChatInputBox_PreviewDragOver"
                             Padding="2,2,30,2"
                             MinHeight="56"
                             MaxHeight="150"
                             Background="Transparent"
                             BorderThickness="0"
                             FontSize="{StaticResource FontSizeBody}"
                             PreviewKeyDown="ChatInputBox_PreviewKeyDown"/>
                    <!-- 占位提示：无输入时淡显 -->
                    <TextBlock Text="围绕库内切片追问 · Enter 发送 · 可拖入文档"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="{StaticResource FontSizeBody}"
                               VerticalAlignment="Top"
                               HorizontalAlignment="Left"
                               Margin="4,3,0,0"
                               Visibility="{Binding HasInput, Converter={StaticResource InvertBoolVis}}"/>
                    <Button Style="{StaticResource IconButtonStyle}"
                            Command="{Binding ClearInputCommand}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Width="28" Height="28"
                            Margin="0,0,0,0"
                            ToolTip="清除本次输入内容"
                            Visibility="{Binding HasInput, Converter={StaticResource BoolToVis}}">
                        <Path Data="{StaticResource IconClose}" Style="{StaticResource IconSmStyle}" Width="12" Height="12"/>
                    </Button>
                </Grid>

                <!-- 行 2: 一体化工具底栏（左=输入侧: 知识库/附件/联网/灵感；右=处理与发送侧: 生效模型/模型选择/刷新/停止/发送） -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：输入侧控件（影响"问什么"）——知识库锚定 + 附件 + 联网 + 灵感 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- @知识库锚定微胶囊（点击弹出多选知识库面板） -->
                        <Border Background="{DynamicResource DocMindEmeraldLightBrush}"
                                BorderBrush="{DynamicResource DocMindEmeraldBrush}"
                                BorderThickness="0.8"
                                CornerRadius="{StaticResource CornerCapsule}"
                                Height="26"
                                Padding="9,0"
                                Margin="0,0,6,0"
                                Cursor="Hand"
                                ToolTip="点击选择对话检索的知识库分组（可多选，不勾选任何分组 = 检索全部）"
                                MouseLeftButtonDown="KnowledgeBadge_Click">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <StackPanel Width="252" Margin="4">
                                        <TextBlock Text="对话检索的知识库（可多选）"
                                                   FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Margin="6,4,6,6"/>
                                        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Collections}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                                  Content="{Binding Name}"
                                                                  FontSize="{StaticResource FontSizeCaption}"
                                                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                                                  Margin="3,2"
                                                                  Cursor="Hand"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <Separator Margin="2,4"/>
                                        <DockPanel Margin="4,2">
                                            <Button Command="{Binding LoadCollectionsCommand}"
                                                    DockPanel.Dock="Right"
                                                    Style="{DynamicResource SecondaryButtonStyle}"
                                                    Height="24" Padding="8,0"
                                                    Margin="6,0,0,0"
                                                    FontSize="{StaticResource FontSizeSmall}"
                                                    ToolTip="重新从后端拉取知识库分组列表">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconRefresh}" Style="{StaticResource IconSmStyle}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="刷新"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Content="新建"
                                                    Command="{Binding AddCollectionCommand}"
                                                    DockPanel.Dock="Right"
                                                    Style="{DynamicResource SecondaryButtonStyle}"
                                                    Height="24" Padding="8,0"
                                                    Margin="6,0,0,0"
                                                    FontSize="{StaticResource FontSizeSmall}"
                                                     ToolTip="创建新分组并勾选"/>
                                            <TextBox Text="{Binding NewCollectionName, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="{StaticResource FontSizeSmall}"
                                                     Padding="5,3"
                                                     ToolTip="输入新分组名后点「新建」"/>
                                        </DockPanel>
                                        <TextBlock Text="不勾选任何分组 = 检索全部知识库"
                                                   FontSize="{StaticResource FontSizeMicro}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Margin="6,4,6,2"/>
                                    </StackPanel>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <TextBlock Text="{Binding KnowledgeAnchorText}"
                                       FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource DocMindEmeraldBrush}"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- 导入附件/图片按钮（属于输入侧，紧跟知识库锚定） -->
                        <Button Command="{Binding AddAttachmentCommand}"
                                Style="{DynamicResource IconButtonStyle}"
                                Width="30" Height="30"
                                Margin="0,0,4,0"
                                ToolTip="导入文档或图片（PDF/Word/PPT/Excel/MD/代码/图片OCR）">
                            <Path Data="{StaticResource IconPaperclip}" Style="{StaticResource IconSmStyle}"/>
                        </Button>

                        <!-- 回答模式：自动 / 知识库 RAG / Agent 工具 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Path Data="{StaticResource IconSparkles}"
                                  Style="{StaticResource IconSmStyle}"
                                  Margin="0,0,4,0"
                                  VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding ChatModes}"
                                      SelectedItem="{Binding SelectedChatMode, Mode=TwoWay}"
                                      DisplayMemberPath="Label"
                                      Style="{StaticResource CompactPillComboBoxStyle}"
                                      MinWidth="96"
                                      ToolTip="回答模式：自动=按问题类型路由；知识库 RAG=更快；Agent 工具=多轮检索联网。需设置中开启 Agent 总闸，否则 Agent 会回落 RAG。"/>
                        </StackPanel>

                        <!-- 联网搜索：关闭 / 普通搜索 / 深度搜索 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Path Data="{StaticResource IconGlobe}"
                                  Style="{StaticResource IconSmStyle}"
                                  Margin="0,0,4,0"
                                  VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding WebSearchModes}"
                                      SelectedItem="{Binding SelectedWebSearchMode, Mode=TwoWay}"
                                      DisplayMemberPath="Label"
                                      Style="{StaticResource CompactPillComboBoxStyle}"
                                      MinWidth="96"
                                      ToolTip="联网搜索模式：普通=多引擎常规检索；深度=更多来源与更长预算，适合多资料比对"/>
                        </StackPanel>

                        <!-- HTML 体验模式：本轮回答按整页 HTML 沙箱气泡渲染（比 Markdown 多 40%~150% token） -->
                        <CheckBox Content="HTML 体验"
                                  IsChecked="{Binding IsHtmlAnswerMode, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"
                                  FontSize="{StaticResource FontSizeSmall}"
                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                  ToolTip="HTML 体验模式：AI 以自包含整页 HTML 回答，气泡内活排版/图表/交互。注意：比普通回答多消耗 40%~150% token；可在设置中关闭 CDN 引用。"/>

                        <!-- 灵感快捷菜单 -->
                        <Button Style="{DynamicResource SecondaryButtonStyle}"
                                Height="26"
                                Padding="8,0"
                                Margin="0,0,6,0"
                                FontSize="{StaticResource FontSizeSmall}"
                                ToolTip="快捷选择高频任务提示词模板"
                                Click="InspirationButton_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconSparkles}" Style="{StaticResource IconSmStyle}" Margin="0,0,6,0"/>
                                <TextBlock Text="灵感" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="制作演示文稿 PPT 大纲"
                                              Command="{Binding InsertPromptTemplateCommand}"
                                              CommandParameter="ppt"/>
                                    <MenuItem Header="撰写技术研报 / 方案论证"
                                              Command="{Binding InsertPromptTemplateCommand}"
                                              CommandParameter="report"/>
                                    <MenuItem Header="提炼思维导图大纲结构"
                                              Command="{Binding InsertPromptTemplateCommand}"
                                              CommandParameter="mindmap"/>
                                    <MenuItem Header="多维方案对比矩阵表格"
                                              Command="{Binding InsertPromptTemplateCommand}"
                                              CommandParameter="matrix"/>
                                    <MenuItem Header="核心要点萃取与行动清单"
                                              Command="{Binding InsertPromptTemplateCommand}"
                                              CommandParameter="summary"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>

                    <!-- 右侧：处理与发送侧（决定"怎么答"）——生效模型徽章 + 模型选择 + 刷新 + 停止 + 纸飞机发送圆钮 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 算力引擎徽章 -->
                        <Border Background="{DynamicResource SurfaceBrush}"
                                CornerRadius="{StaticResource CornerLg}" Height="24" Padding="8,0"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                ToolTip="{Binding ComputeEngineBadgeTip}">
                            <TextBlock Text="{Binding ComputeEngineBadgeText}"
                                       FontSize="{StaticResource FontSizeMicro}"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- 模型选择胶囊（贴近发送键，与生效模型徽章同组） -->
                        <ComboBox ItemsSource="{Binding ModelChoices}"
                                  SelectedItem="{Binding SelectedModelChoice, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  Style="{StaticResource CompactPillComboBoxStyle}"
                                  MinWidth="110"
                                  MaxWidth="170"
                                  Margin="0,0,4,0"
                                  ToolTip="{Binding EffectiveModelSummary}"/>

                        <!-- 刷新模型 -->
                        <Button Command="{Binding RefreshModelsCommand}"
                                Style="{DynamicResource IconButtonStyle}"
                                Width="24" Height="24"
                                FontSize="{StaticResource FontSizeMicro}"
                                Margin="0,0,8,0"
                                ToolTip="刷新可用模型">
                            <Path Data="{StaticResource IconRefresh}" Style="{StaticResource IconSmStyle}"/>
                        </Button>

                        <!-- 停止按钮 -->
                        <Button Content="停止"
                                Command="{Binding StopCommand}"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Padding="10,4"
                                Height="30"
                                Margin="0,0,6,0"
                                Visibility="{Binding ShowStop, Converter={StaticResource BoolToVis}}"/>

                        <!-- 纸飞机圆形发送按钮：可发送时呼吸光晕 + 按压微缩 -->
                        <Button Command="{Binding SendCommand}"
                                Width="34" Height="34"
                                Cursor="Hand"
                                ToolTip="发送（Enter）">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Grid RenderTransformOrigin="0.5,0.5">
                                                    <!-- 可发送时的呼吸光晕环 -->
                                                    <Border x:Name="PulseRing"
                                                            Background="{DynamicResource PrimaryBrush}"
                                                            CornerRadius="{StaticResource CornerPill}"
                                                            Opacity="0"
                                                            Margin="-3"/>
                                                    <Border x:Name="SendRoot"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="{StaticResource CornerPill}"
                                                            SnapsToDevicePixels="True"
                                                            RenderTransformOrigin="0.5,0.5">
                                                        <Border.RenderTransform>
                                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                        </Border.RenderTransform>
                                                        <!-- 纸飞机图标 -->
                                                        <Path x:Name="AirplaneIcon"
                                                              Data="M2,21 L23,12 L2,3 L2,10 L17,12 L2,14 Z"
                                                              Fill="{DynamicResource PrimaryBrush}"
                                                              Width="13" Height="13"
                                                              Stretch="Uniform"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Margin="2,0,0,0"/>
                                                    </Border>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding HasInput}" Value="True">
                                                        <Setter TargetName="SendRoot" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                        <Setter TargetName="AirplaneIcon" Property="Fill" Value="{StaticResource TextOnAccentBrush}"/>
                                                        <Setter TargetName="SendRoot" Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Direction="270" Opacity="0.36" Color="{DynamicResource PrimaryColor}"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard Name="SendPulse">
                                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                    <DoubleAnimation
                                                                        Storyboard.TargetName="PulseRing"
                                                                        Storyboard.TargetProperty="Opacity"
                                                                        From="0.08" To="0.28"
                                                                        Duration="0:0:0.9">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseInOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <StopStoryboard BeginStoryboardName="SendPulse"/>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="PulseRing" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="SendRoot" Property="Opacity" Value="0.88"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="SendRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.9" Duration="0:0:0.06"/>
                                                                    <DoubleAnimation Storyboard.TargetName="SendRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.9" Duration="0:0:0.06"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="SendRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.1"/>
                                                                    <DoubleAnimation Storyboard.TargetName="SendRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.1"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="SendRoot" Property="Opacity" Value="0.35"/>
                                                        <Setter TargetName="SendRoot" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                                        <Setter TargetName="AirplaneIcon" Property="Fill" Value="{StaticResource TextMutedBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 行 3: 居中注记 — DocMind 身份一句话，而非通用 AI 免责 -->
                <TextBlock Grid.Row="3"
                           Text="问你的文献 · 回答带出处 · 数据留在本机"
                           FontSize="{StaticResource FontSizeMicro}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,6,0,2"/>
            </Grid>
        </Border>
        </Grid>

        <!-- ===== 拖动把手：与抽屉同处 Column 1，浮在抽屉左边缘的 12px 留白间隙内 =====
             用 Thumb 而非 GridSplitter：宽度改的是 ViewModel 属性（经双向绑定回传），
             不会直接改写布局容器的 Width，因此抽屉关闭时列宽能正常塌陷为 0。 -->
        <Thumb Grid.Column="1"
               HorizontalAlignment="Left"
               VerticalAlignment="Stretch"
               Width="8"
               Margin="2,0,0,0"
               Cursor="SizeWE"
               DragDelta="DrawerThumb_DragDelta"
               DragCompleted="DrawerThumb_DragCompleted"
               ToolTip="拖动调整宽度"
               Visibility="{Binding IsSourceDrawerOpen, Converter={StaticResource BoolToVis}}">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Root" Background="Transparent">
                        <Rectangle x:Name="VisualBar"
                                   Width="1"
                                   HorizontalAlignment="Center"
                                   Fill="{DynamicResource BorderBrush}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                            <Setter TargetName="VisualBar" Property="Width" Value="2"/>
                            <Setter TargetName="VisualBar" Property="Fill" Value="{StaticResource PrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>

        <!-- ===== 右侧协同抽屉 (双模：原著切片出处 / 创作工作台 Artifact Canvas) =====
             宽度双向绑定 ViewModel.SourceDrawerWidth：拖动把手改的是源属性，
             经 ViewModel 钳制（240~720）后回传，并落盘持久化。 -->
        <Border Grid.Column="1"
                Width="{Binding SourceDrawerWidth, Mode=TwoWay}"
                MinWidth="240"
                MaxWidth="1100"
                Margin="12,0,0,0"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerLg}"
                SnapsToDevicePixels="True"
                Visibility="{Binding IsSourceDrawerOpen, Converter={StaticResource BoolToVis}}">
            <Grid Margin="16,14">
                <!-- ==================== 模式 A：创作物工作台 (Artifacts Canvas) ==================== -->
                <Grid Visibility="{Binding IsArtifactMode, Converter={StaticResource B2V}}">
                    <Grid.RowDefinitions>
                        <!-- 头部 (标题 + 类型徽章 + 关闭) -->
                        <RowDefinition Height="Auto"/>
                        <!-- 本会话创作物清单 (横排切换，>1 个时显示) -->
                        <RowDefinition Height="Auto"/>
                        <!-- 主预览区 (PPT 卡片 / 文档内容) -->
                        <RowDefinition Height="*"/>
                        <!-- 体检报告（可展开） -->
                        <RowDefinition Height="Auto"/>
                        <!-- 底部导出工具条 -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 1. 创作物头部 -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconPalette}" Style="{StaticResource IconSmStyle}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="创作物工作台"
                                       Style="{StaticResource SubtitleText}"
                                       FontSize="{StaticResource FontSizeBody}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding OpenSlideShowCommand}"
                                    Visibility="{Binding IsPptArtifact, Converter={StaticResource B2V}}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="6,2"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Margin="0,0,4,0"
                                    ToolTip="进入客户端大屏全景放映模式">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconPlay}" Style="{StaticResource IconSmStyle}" Margin="0,0,6,0"/>
                                    <TextBlock Text="沉浸放映"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding OpenWebPreviewCommand}"
                                    Visibility="{Binding IsPptArtifact, Converter={StaticResource B2V}}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="6,2"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Margin="0,0,4,0"
                                    ToolTip="在默认浏览器中开启 16:9 交互式 HTML5 幻灯片放映">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconGlobe}" Style="{StaticResource IconSmStyle}" Margin="0,0,6,0"/>
                                    <TextBlock Text="网页放映"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding InspectPptCommand}"
                                    Visibility="{Binding IsPptArtifact, Converter={StaticResource B2V}}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="6,2"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Margin="0,0,6,0"
                                    ToolTip="全方位体检 PPT 结构完整度、文字密度与演讲准备度">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconSearch}" Style="{StaticResource IconSmStyle}" Margin="0,0,6,0"/>
                                    <TextBlock Text="效果自检"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding LoadArtifactVersionsCommand}"
                                    Style="{DynamicResource SecondaryButtonStyle}"
                                    Padding="6,2"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Margin="0,0,6,0"
                                    ToolTip="查看/保存/恢复历史版本">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconSave}" Style="{StaticResource IconSmStyle}" Margin="0,0,6,0"/>
                                    <TextBlock Text="版本"/>
                                </StackPanel>
                            </Button>


                            <Border Background="{DynamicResource PrimaryLightBrush}"
                                    CornerRadius="{StaticResource CornerSm}"
                                    Padding="6,2"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedArtifact.Type, StringFormat={}{0}}"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryBrush}"/>
                            </Border>
                        </StackPanel>
                            <!-- 体检报告卡片 -->
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource CornerMd}"
                                    Padding="10,8"
                                    Margin="0,8,0,0"
                                    Visibility="{Binding IsInspectionReportOpen, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="效果体检" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Margin="8,0,0,0" FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{DynamicResource AccentBrush}">
                                            <Run Text="{Binding InspectionReport.Score, Mode=OneWay}"/><Run Text=" 分 · "/><Run Text="{Binding InspectionReport.Grade, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Text="{Binding InspectionReport.Summary}"
                                               FontSize="{StaticResource FontSizeCaption}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" Margin="0,4,0,6"/>
                                    <ItemsControl ItemsSource="{Binding InspectionReport.Issues}"
                                                  MaxHeight="160">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock FontSize="{StaticResource FontSizeCaption}"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Margin="0,0,0,2">
                                                    <Run Text="{Binding Category, Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding Message, Mode=OneWay}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="按建议修订"
                                                Style="{DynamicResource PrimaryButtonStyle}"
                                                Command="{Binding ReviseFromInspectionCommand}"
                                                Padding="10,4" FontSize="{StaticResource FontSizeSmall}"
                                                Margin="0,0,8,0"/>
                                        <Button Content="关闭"
                                                Style="{DynamicResource SecondaryButtonStyle}"
                                                Command="{Binding CloseInspectionReportCommand}"
                                                Padding="10,4" FontSize="{StaticResource FontSizeSmall}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- 版本管理 -->
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource CornerMd}"
                                    Padding="10,8"
                                    Margin="0,8,0,0"
                                    Visibility="{Binding IsVersionPanelOpen, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="版本历史" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSmall}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="保存当前版本"
                                                Style="{DynamicResource SecondaryButtonStyle}"
                                                Command="{Binding SaveArtifactVersionCommand}"
                                                Padding="10,4" FontSize="{StaticResource FontSizeSmall}"
                                                Margin="0,0,8,0"/>
                                        <Button Content="刷新列表"
                                                Style="{DynamicResource SecondaryButtonStyle}"
                                                Command="{Binding LoadArtifactVersionsCommand}"
                                                Padding="10,4" FontSize="{StaticResource FontSizeSmall}"
                                                Margin="0,0,8,0"/>
                                        <Button Content="恢复此版本"
                                                Style="{DynamicResource PrimaryButtonStyle}"
                                                Command="{Binding RestoreArtifactVersionCommand}"
                                                Padding="10,4" FontSize="{StaticResource FontSizeSmall}"/>
                                    </StackPanel>
                                    <ListBox ItemsSource="{Binding ArtifactVersions}"
                                             SelectedItem="{Binding SelectedArtifactVersion, Mode=TwoWay}"
                                             MaxHeight="120" Margin="0,8,0,0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock FontSize="{StaticResource FontSizeCaption}"
                                                               FontWeight="SemiBold">
                                                        <Run Text="v"/><Run Text="{Binding Version, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Title, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding CreatedAt}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>



                        <Button Grid.Row="0" Grid.Column="2"
                                Command="{Binding CloseSourceDrawerCommand}"
                                Style="{StaticResource IconButtonStyle}"
                                Width="26" Height="26"
                                ToolTip="关闭工作台">
                            <Path Data="{StaticResource IconClose}" Style="{StaticResource IconSmStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- PPT 主题配色切换选择器 (仅 PPT 模式显示) -->
                        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0"
                              Visibility="{Binding IsPptArtifact, Converter={StaticResource B2V}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="配色主题:"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableThemes}"
                                      SelectedItem="{Binding SelectedTheme}"
                                      DisplayMemberPath="DisplayName"
                                      FontSize="{StaticResource FontSizeCaption}"
                                      Padding="6,3"
                                      ToolTip="切换 PPT 演示文稿企业级主题配色"/>
                        </Grid>
                    </Grid>

                    <!-- 2. 主预览区 -->
                    <!-- 2. 本会话创作物清单（一次会话常产出多个交付物，横排点选即可切换预览） -->
                    <Grid Grid.Row="1" Margin="0,0,0,10"
                          Visibility="{Binding HasMultipleArtifacts, Converter={StaticResource B2V}}">
                        <ListBox ItemsSource="{Binding SessionArtifacts}"
                                 SelectedItem="{Binding SelectedArtifact, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 MaxHeight="86"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ToolTip="本会话已产出的全部创作物，点击卡片即可切换预览">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,6" Margin="0,0,8,0" CornerRadius="{StaticResource CornerMd}"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            Width="150">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Type}" FontSize="{StaticResource FontSizeMicro}" FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryBrush}"/>
                                            <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontSizeCaption}" Margin="0,2,0,2"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Title}"/>
                                            <TextBlock FontSize="{StaticResource FontSizeMicro}" Foreground="{DynamicResource TextTertiaryBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding SlideCount, StringFormat={}{0} 页}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPpt}" Value="False">
                                                                <Setter Property="Text" Value="文档 / 网页"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <Grid Grid.Row="2">
                        <!-- PPT 幻灯片预览卡片 -->
                        <Grid Visibility="{Binding IsPptArtifact, Converter={StaticResource B2V}}">
                            <Grid.RowDefinitions>
                                <!-- 幻灯片卡片 -->
                                <RowDefinition Height="*"/>
                                <!-- 翻页工具栏 -->
                                <RowDefinition Height="Auto"/>
                                <!-- 演讲备注 -->
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 空状态提示：无幻灯片内容时显示（避免整页空白无反馈） -->
                            <Border Grid.Row="0"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource CornerLg}"
                                    Padding="14"
                                    Visibility="{Binding HasSelectedSlide, Converter={StaticResource InvertBoolVis}}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="暂无幻灯片内容可预览"
                                               FontSize="{StaticResource FontSizeBody}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="模型可能未输出结构化 PPT（缺少 :::artifact type=&quot;pptx&quot; 包裹或 --- 分页），可点「网页放映」查看 HTML 版，或在对话中要求重新生成。"
                                               FontSize="{StaticResource FontSizeCaption}"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               MaxWidth="300"/>
                                </StackPanel>
                            </Border>

                            <!-- 幻灯片模拟卡片 (16:9 质感卡片) -->
                            <Border Grid.Row="0"
                                    Background="{Binding SlideAccentSoftBrush}"
                                    BorderBrush="{Binding SlideAccentBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="{StaticResource CornerLg}"
                                    Padding="14"
                                    Margin="0,0,0,8">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <!-- 顶部科技装饰条 -->
                                        <Border Height="3" Background="{Binding SlideAccentBrush}" CornerRadius="{StaticResource CornerSm}" Margin="0,0,0,8"/>
                                        
                                        <!-- 板式类型指示标签 -->
                                        <Border Background="{Binding SlideAccentBrush}"
                                                CornerRadius="{StaticResource CornerSm}"
                                                Padding="5,1"
                                                HorizontalAlignment="Left"
                                                Margin="0,0,0,6">
                                            <TextBlock Text="{Binding SelectedSlide.Layout, StringFormat=板式: {0}}"
                                                       FontSize="{StaticResource FontSizeMicro}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextOnAccentBrush}"/>
                                        </Border>

                                        <!-- 幻灯片标题 -->
                                        <TextBlock Text="{Binding SelectedSlide.Title}"
                                                   FontSize="{StaticResource FontSizeSubtitle}"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding SlideAccentBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,6"/>
                                        <!-- 封面副标题 (如果有) -->
                                        <TextBlock Text="{Binding SelectedSlide.Subtitle}"
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,10"
                                                   Visibility="{Binding SelectedSlide.IsCover, Converter={StaticResource B2V}}"/>

                                        <!-- 板式 A: 多列卡片网格 (Cards) -->
                                        <ItemsControl ItemsSource="{Binding SelectedSlide.Cards}"
                                                      Visibility="{Binding SelectedSlide.ShowCards, Converter={StaticResource B2V}}"
                                                      Margin="0,4,0,4">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource CardBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="{StaticResource CornerMd}"
                                                            Padding="8"
                                                            Margin="0,0,0,6">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,4"/>
                                                            <TextBlock Text="{Binding Content}" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Visibility="{Binding Content, Converter={StaticResource StringToVis}}"/>
                                                            <ItemsControl ItemsSource="{Binding Bullets}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding StringFormat=• {0}}" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="4,2,0,2"/>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- 板式 B: 大数字 KPI 看板 (Metrics) -->
                                        <ItemsControl ItemsSource="{Binding SelectedSlide.Metrics}"
                                                      Visibility="{Binding SelectedSlide.ShowMetrics, Converter={StaticResource B2V}}"
                                                      Margin="0,4,0,4">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource PrimaryLightBrush}"
                                                            CornerRadius="{StaticResource CornerMd}"
                                                            Padding="10,6"
                                                            Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Value}" FontSize="{StaticResource FontSizeTitle}" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Label}" FontSize="{StaticResource FontSizeBody}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                <TextBlock Text="{Binding Description}" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" Visibility="{Binding Description, Converter={StaticResource StringToVis}}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- 板式 C: 横向时间线 (Timeline) -->
                                        <ItemsControl ItemsSource="{Binding SelectedSlide.TimelineNodes}"
                                                      Visibility="{Binding SelectedSlide.ShowTimeline, Converter={StaticResource B2V}}"
                                                      Margin="0,4,0,4">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                                        <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="{StaticResource CornerSm}" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Stage}" FontSize="{StaticResource FontSizeSmall}" FontWeight="Bold" Foreground="{StaticResource TextOnAccentBrush}"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- 板式 D: 金句引用 (Quote) -->
                                        <Border Background="{DynamicResource PrimaryLightBrush}"
                                                CornerRadius="{StaticResource CornerMd}"
                                                Padding="12"
                                                Margin="0,4,0,4"
                                                Visibility="{Binding SelectedSlide.ShowQuote, Converter={StaticResource B2V}}">
                                            <TextBlock Text="{Binding SelectedSlide.QuoteText, StringFormat=“ {0} ”}"
                                                       FontSize="{StaticResource FontSizeBody}"
                                                       FontWeight="Bold"
                                                       FontStyle="Italic"
                                                       Foreground="{DynamicResource PrimaryBrush}"
                                                       TextWrapping="Wrap"/>
                                        </Border>

                                        <!-- 板式 F: 商务对比矩阵 (Table) -->
                                        <Border Background="{DynamicResource CardBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource CornerMd}"
                                                Padding="8,6"
                                                Margin="0,4,0,4"
                                                Visibility="{Binding SelectedSlide.HasTable, Converter={StaticResource B2V}}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <Path Data="{StaticResource IconList}" Style="{StaticResource IconSmStyle}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="对比矩阵"
                                                               FontSize="{StaticResource FontSizeSmall}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PrimaryBrush}"/>
                                                </StackPanel>
                                                <ItemsControl ItemsSource="{Binding SelectedSlide.TableLines}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}"
                                                                       FontSize="{StaticResource FontSizeCaption}"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       Margin="0,2,0,2"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- 右侧翻页大按钮 -->
                    <Button Grid.Column="2"
                            Command="{Binding NextSlideCommand}"
                            IsEnabled="{Binding CanNextSlide}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="44" Height="44"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            ToolTip="下一页 (Right Arrow / PageDown / Space)">
                        <Path Data="{StaticResource IconChevronRight}" Style="{StaticResource IconLgStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                        </Grid>
                    </Grid>


                <!-- 3. 底部悬浮演讲提词小抄 (Speaker Notes) -->
                <Border Grid.Row="2"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CornerLg}"
                        Padding="16,10"
                        Margin="0,16,0,0"
                        MaxWidth="950"
                        HorizontalAlignment="Center"
                        Visibility="{Binding IsSpeakerNotesVisibleInSlideShow, Converter={StaticResource B2V}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="演讲者实时提词小抄" FontSize="{StaticResource FontSizeCaption}" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                            <TextBlock Text=" (仅您可见)" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SelectedSlide.SpeakerNotes}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   LineHeight="{StaticResource LineHeightBody}"/>
                    </StackPanel>
                </Border>
                </Grid>

                <!-- ==================== 模式 B：原著 × 关键点对照 ====================
                     修复：此前抽屉只挂了创作物模式，点击「对照原文」后右栏空白。
                     GroundTruthViewer 上方展示关键点（答案支撑句 + 引用原文），
                     下方嵌入 PDF 原文件并高亮定位，形成原文件与关键点对照。 -->
                <cc:GroundTruthViewerControl
                    Visibility="{Binding IsArtifactMode, Converter={StaticResource InvertBoolVis}}"
                    DataContext="{Binding}"
                    SelectedSource="{Binding SelectedSource, Mode=OneWay}"/>
            </Grid>
        </Border>

        <!-- ===== 自定义角色与主题管理面板（覆盖层） ===== -->
        <Border Background="{DynamicResource ScrimStrongBrush}"
                Visibility="{Binding IsCustomManagerOpen, Converter={StaticResource BoolToVis}}"
                MouseLeftButtonDown="CustomManagerOverlay_Click">
            <Border Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource ElevatedBorderBrush}"
                    BorderThickness="{DynamicResource ElevatedBorderThickness}"
                    CornerRadius="{StaticResource CornerXl}"
                    Padding="24"
                    MaxWidth="600"
                    MaxHeight="640"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSettings}" Style="{StaticResource IconMdStyle}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="自定义角色与主题"
                                       FontSize="{StaticResource FontSizeSubtitle}" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right"
                                Command="{Binding CloseCustomManagerCommand}"
                                Style="{StaticResource TextButtonStyle}"
                                FontSize="{StaticResource FontSizeSubtitle}" Padding="6,2"
                                ToolTip="关闭">
                            <Path Data="{StaticResource IconClose}" Style="{StaticResource IconSmStyle}" Stroke="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </DockPanel>
                    <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- ── 自定义角色区 ── -->
                            <TextBlock Text="自定义角色" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding AllPersonas}" Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}"
                                                Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="{StaticResource CornerMd}"
                                                Padding="10,6" Margin="0,0,0,4">
                                            <DockPanel>
                                                <TextBlock Text="{Binding DisplayName}" FontSize="{StaticResource FontSizeCaption}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center"/>
                                                <Button Content="删除" DockPanel.Dock="Right"
                                                        Command="{Binding DataContext.RemoveCustomPersonaCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding Id}"
                                                        Style="{StaticResource TextButtonStyle}"
                                                        FontSize="{StaticResource FontSizeSmall}" Padding="6,2"
                                                        Foreground="{DynamicResource DangerBrush}"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="{StaticResource CornerMd}"
                                    Padding="10,8" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="新增角色" FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding NewPersonaIcon, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="{StaticResource FontSizeTitle}" TextAlignment="Center" Margin="0,0,8,0"
                                                 ToolTip="图标（一个 emoji）" MaxLength="4"/>
                                        <TextBox Grid.Column="1" Text="{Binding NewPersonaName, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="{StaticResource FontSizeBody}" ToolTip="角色名称" Margin="0,0,0,8"/>
                                    </Grid>
                                    <TextBox Text="{Binding NewPersonaDescription, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="{StaticResource FontSizeCaption}" ToolTip="角色描述" Margin="0,0,0,8"/>
                                    <Button Command="{Binding AddCustomPersonaCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Padding="12,6" HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconSparkles}" Style="{StaticResource IconSmStyle}" Margin="0,0,6,0"/>
                                            <TextBlock Text="添加角色"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- ── 自定义主题区 ── -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Path Data="{StaticResource IconPalette}" Style="{StaticResource IconSmStyle}" Margin="0,0,6,0"/>
                                <TextBlock Text="自定义主题" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding AllThemes}" Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}"
                                                Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="{StaticResource CornerMd}"
                                                Padding="10,6" Margin="0,0,0,4">
                                            <DockPanel>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="14" Height="14" CornerRadius="{StaticResource CornerSm}"
                                                            Background="{Binding PrimaryBrush}" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="{StaticResource FontSizeCaption}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                </StackPanel>
                                                <Button Content="删除" DockPanel.Dock="Right"
                                                        Command="{Binding DataContext.RemoveCustomThemeCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding Id}"
                                                        Style="{StaticResource TextButtonStyle}"
                                                        FontSize="{StaticResource FontSizeSmall}" Padding="6,2"
                                                        Foreground="{DynamicResource DangerBrush}"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="{StaticResource CornerMd}"
                                    Padding="10,8" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="新增主题" FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding NewThemeIcon, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="{StaticResource FontSizeTitle}" TextAlignment="Center" Margin="0,0,8,0"
                                                 ToolTip="图标（一个 emoji）" MaxLength="4"/>
                                        <TextBox Grid.Column="1" Text="{Binding NewThemeDisplayName, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="{StaticResource FontSizeBody}" ToolTip="主题名称" Margin="0,0,0,8"/>
                                    </Grid>
                                    <TextBox Text="{Binding NewThemeDescription, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="{StaticResource FontSizeCaption}" ToolTip="主题描述" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="主色 (Hex)" FontSize="{StaticResource FontSizeMicro}" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                            <TextBox Text="{Binding NewThemePrimaryHex, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="{StaticResource FontSizeCaption}" ToolTip="主色十六进制值（#RRGGBB 格式）"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="背景色 (Hex)" FontSize="{StaticResource FontSizeMicro}" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                            <TextBox Text="{Binding NewThemeBgHex, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="{StaticResource FontSizeCaption}" ToolTip="背景色十六进制值（#RRGGBB 格式）"/>
                                        </StackPanel>
                                    </Grid>
                                    <Button Command="{Binding AddCustomThemeCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Padding="12,6" HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconSparkles}" Style="{StaticResource IconSmStyle}" Margin="0,0,6,0"/>
                                            <TextBlock Text="添加主题"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Border>

        <!-- ===== 对话笔记沉淀入库微调弹窗（选区微调 / 选集合 / 改标题） =====
             ViewModel 已有 OpenIngestDialog / ConfirmIngestDialogAsync，此前 ChatView 缺 UI，
             点「沉淀入库」只改状态不出现任何界面，功能看起来像未实现。 -->
        <Border Background="{DynamicResource ScrimStrongBrush}"
                Visibility="{Binding IsIngestDialogOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource ElevatedBorderBrush}"
                    BorderThickness="{DynamicResource ElevatedBorderThickness}"
                    CornerRadius="{StaticResource CornerXl}"
                    Padding="20"
                    MaxWidth="560"
                    MaxHeight="640"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

                    <!-- 弹窗头部 -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right"
                                Command="{Binding CloseIngestDialogCommand}"
                                Style="{StaticResource TextButtonStyle}"
                                FontSize="{StaticResource FontSizeSubtitle}" Padding="6,2"
                                ToolTip="关闭">
                            <Path Data="{StaticResource IconClose}" Style="{StaticResource IconSmStyle}" Stroke="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconImport}" Style="{StaticResource IconMdStyle}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="知识笔记沉淀入库"
                                       FontSize="{StaticResource FontSizeSubtitle}" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- 表单 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="笔记标题" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding IngestDialogTitle, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                                     Margin="0,0,0,10" Padding="8,6"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="目标知识库分组" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <ComboBox IsEditable="True"
                                              ItemsSource="{Binding Collections}"
                                              DisplayMemberPath="Name"
                                              Text="{Binding IngestDialogCollection, UpdateSourceTrigger=PropertyChanged}"
                                              FontSize="{StaticResource FontSizeCaption}" Padding="8,6"
                                              ToolTip="可选择已有分组，也可直接输入新分组名"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="知识标签" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding IngestDialogTags, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="{StaticResource FontSizeCaption}" Padding="8,6"
                                             ToolTip="逗号分隔，入库时会拼进笔记正文顶部"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="沉淀内容（可自由编辑、删减非重点）" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding IngestDialogContent, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="160"
                                     MaxHeight="260"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas, Cascadia Code, Segoe UI, sans-serif"
                                     FontSize="{StaticResource FontSizeCaption}"
                                     Padding="10,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Path Data="{StaticResource IconLightbulb}" Style="{StaticResource IconSmStyle}" Stroke="{DynamicResource TextTertiaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="确认后向量化写入本地知识库，可在检索与后续对话中被引用。"
                                           FontSize="{StaticResource FontSizeMicro}"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 底部操作 -->
                    <DockPanel Grid.Row="2">
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsDialogIngesting, Converter={StaticResource BoolToVis}}"
                                    VerticalAlignment="Center">
                            <Path Data="{StaticResource IconRefresh}" Style="{StaticResource IconSmStyle}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="正在建立向量索引入库..."
                                       FontSize="{StaticResource FontSizeSmall}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding CloseIngestDialogCommand}"
                                    Content="取消"
                                    Style="{DynamicResource SecondaryButtonStyle}"
                                    FontSize="{StaticResource FontSizeCaption}"
                                    Padding="12,6"
                                    Margin="0,0,8,0"/>
                            <Button Command="{Binding ConfirmIngestDialogCommand}"
                                    IsEnabled="{Binding IsDialogIngesting, Converter={StaticResource BoolInvertConverter}}"
                                    Style="{DynamicResource PrimaryButtonStyle}"
                                    FontSize="{StaticResource FontSizeCaption}"
                                    Padding="14,6">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconRocket}" Style="{StaticResource IconSmStyle}" Stroke="{DynamicResource TextInverseBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="确认沉淀入库"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
