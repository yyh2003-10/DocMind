<UserControl x:Class="DocMind.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DocMind.ViewModels"
             xmlns:m="clr-namespace:DocMind.Models"
             xmlns:cc="clr-namespace:DocMind.Controls"
             xmlns:helpers="clr-namespace:DocMind.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:BoolInvertConverter x:Key="BoolInvertConverter"/>
        <helpers:NullToVisibilityConverter x:Key="NullToVis"/>
        <helpers:NullToVisibilityConverter x:Key="StringToVis"/>
        <helpers:ThinkingStepIconConverter x:Key="ThinkingStepIconConverter"/>

        <!-- 消息时间/元信息 -->
        <Style x:Key="ChatMetaText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <!-- 引用来源行 -->
        <Style x:Key="SourceLineText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>

        <!-- 气泡内操作按钮：助手消息默认品牌蓝；用户消息为蓝色渐变气泡内改用白字保证对比度 -->
        <Style x:Key="BubbleActionButtonStyle" TargetType="Button" BasedOn="{StaticResource TextButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUser}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource UserBubbleTextBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 角色头像 -->
        <Style x:Key="ChatAvatarStyle" TargetType="Border">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="17"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <!-- 消息气泡模板（风格参考 chatboxai/chatbox 与 CherryHQ/cherry-studio：
             扁平化气泡——助手消息无边框无阴影、仅浅色底，减少“卡片感”） -->
        <!-- 消息气泡模板（DeepSeek 风格高质感设计：
             极简扁平化气泡 + 可折叠动态思考过程 + 模型推理链 + 搜索卡片 + 富文本引用 + 操作工具栏与Token统计） -->
        <DataTemplate x:Key="MessageBubbleTemplate" DataType="{x:Type vm:ChatMessage}">
            <Grid x:Name="BubbleRoot" Margin="0,0,0,16">
                <Grid.Resources>
                    <BooleanToVisibilityConverter x:Key="B2V"/>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 助手头像（左侧） -->
                <Border Grid.Column="0"
                        Style="{StaticResource ChatAvatarStyle}"
                        Margin="0,2,10,0"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        Visibility="{Binding IsAssistant, Converter={StaticResource B2V}}">
                    <TextBlock Text="🤖" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- 用户头像（右侧，品牌渐变圆） -->
                <Border Grid.Column="2"
                        Style="{StaticResource ChatAvatarStyle}"
                        Margin="10,2,0,0"
                        Background="{StaticResource UserBubbleBrush}"
                        Visibility="{Binding IsUser, Converter={StaticResource B2V}}">
                    <TextBlock Text="我" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource UserBubbleTextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- 对话气泡：助手=浅底扁平（无边框/无阴影）；用户=品牌蓝渐变，指向头像处小圆角 -->
                <Border Grid.Column="1"
                        Padding="14,11"
                        MaxWidth="780">
                    <Border.Style>
                        <Style TargetType="Border">
                            <!-- 默认（助手消息）：极浅底，扁平无边框 -->
                            <Setter Property="HorizontalAlignment" Value="Left"/>
                            <Setter Property="Margin" Value="0,0,28,0"/>
                            <Setter Property="CornerRadius" Value="4,16,16,16"/>
                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <!-- 用户消息：右对齐 + 品牌渐变 + 指向右下 -->
                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="28,0,0,0"/>
                                    <Setter Property="Background" Value="{StaticResource UserBubbleBrush}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="CornerRadius" Value="16,16,4,16"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel>
                        <!-- 1. 思考过程区（DeepSeek 风格：可折叠展示 AI 真实思考全链路：
                             头部动态状态「思考中 (用时 3.2 秒)...」/「已思考（用时 5 秒）▾」+ 步骤轨道 + 模型原生推理链） -->
                        <Border Visibility="{Binding HasThinking, Converter={StaticResource B2V}}"
                                Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,8"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <!-- 折叠切换头部按钮 -->
                                <Button Click="ToggleThinking_Click"
                                        HorizontalAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Cursor="Hand"
                                        ToolTip="展开/收起思考过程与模型推理链">
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                            <TextBlock Text="{Binding ThinkingIconText, Mode=OneWay}"
                                                       FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding ThinkingHeaderText, Mode=OneWay}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="▾" FontSize="11" DockPanel.Dock="Right"
                                                   Foreground="{StaticResource TextTertiaryBrush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Visibility="{Binding IsThinkingExpanded, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="▸" FontSize="11" DockPanel.Dock="Right"
                                                   Foreground="{StaticResource TextTertiaryBrush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Visibility="{Binding IsThinkingExpanded, Converter={StaticResource BoolInvertConverter}}"/>
                                    </DockPanel>
                                </Button>

                                <!-- 展开内容区 -->
                                <StackPanel Visibility="{Binding IsThinkingExpanded, Converter={StaticResource BoolToVis}}"
                                            Margin="0,8,0,0">
                                    <!-- A) 全链路步骤节点：连续细轨道竖线 + 阶段圆点 -->
                                    <Grid Visibility="{Binding HasThinkingSteps, Converter={StaticResource B2V}}" Margin="2,0,0,4">
                                        <Border Width="1.5"
                                                HorizontalAlignment="Left"
                                                Margin="4,4,0,4"
                                                Background="{StaticResource BorderLightBrush}"/>
                                        <ItemsControl ItemsSource="{Binding ThinkingSteps}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="18"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse Grid.Column="0"
                                                                 Width="7" Height="7"
                                                                 Fill="{StaticResource PrimaryBrush}"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Top"
                                                                 Margin="0,4,0,0"/>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Converter={StaticResource ThinkingStepIconConverter}}"
                                                                       FontSize="11"
                                                                       Margin="2,0,5,0"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding}"
                                                                       FontSize="12"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>

                                    <!-- B) 模型原生推理链（DeepSeek-R1 / Qwen3 reasoning_content 灰底流式卡片） -->
                                    <Border Visibility="{Binding HasThinkingText, Converter={StaticResource B2V}}"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="0"
                                            CornerRadius="6"
                                            Padding="10,8"
                                            Margin="0,4,0,0">
                                        <StackPanel>
                                            <TextBlock Text="🧠 模型推理链"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextTertiaryBrush}"
                                                       Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding ThinkingText, Mode=OneWay}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       LineHeight="18"
                                                       FontFamily="Consolas, 'Cascadia Code', 'Segoe UI', sans-serif"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 2. 搜索与来源摘要卡片（DeepSeek 风格：搜索到 N 个网页 · 浏览 X 个页面） -->
                        <Border Visibility="{Binding HasWebSources, Converter={StaticResource B2V}}"
                                Background="{StaticResource PrimaryLightBrush}"
                                BorderBrush="{StaticResource PrimaryBrush}"
                                BorderThickness="0.5"
                                CornerRadius="6"
                                Padding="8,4"
                                Margin="0,0,0,6"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔎" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SearchSummaryText, Mode=OneWay}"
                                           FontSize="11.5"
                                           FontWeight="Medium"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- 3. 消息内容：用户消息纯文本（支持划词高亮与复制），助手消息 Markdown 渲染 -->
                        <Grid>
                            <!-- 用户消息：只读 TextBox（支持鼠标自由划词高亮、双击选词与 Ctrl+C 复制，透明无框） -->
                            <TextBox Text="{Binding Content, Mode=OneWay}"
                                     IsReadOnly="True"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     TextWrapping="Wrap"
                                     Cursor="IBeam"
                                     FontSize="15"
                                     FontWeight="Medium"
                                     Foreground="{StaticResource UserBubbleTextBrush}"
                                     SelectionBrush="{StaticResource UserBubbleTextBrush}"
                                     SelectionOpacity="0.35">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <!-- 助手消息：Markdig 渲染的 FlowDocument(代码块/列表/表格/可点击链接/交互角标) -->
                            <FlowDocumentScrollViewer Document="{Binding RenderedDocument, Mode=OneWay}"
                                                      Padding="0"
                                                      IsToolBarVisible="False"
                                                      VerticalScrollBarVisibility="Disabled"
                                                      Foreground="{StaticResource TextPrimaryBrush}"
                                                      Loaded="FlowDocViewer_Loaded"
                                                      Unloaded="FlowDocViewer_Unloaded">
                                <FlowDocumentScrollViewer.Style>
                                    <Style TargetType="FlowDocumentScrollViewer">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUser}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </FlowDocumentScrollViewer.Style>
                            </FlowDocumentScrollViewer>
                        </Grid>

                        <!-- 4. 加载动画与思考状态胶囊（等待首字 / 非流式大包期间） -->
                        <Border Visibility="{Binding IsWaitingForFirstToken, Converter={StaticResource B2V}}"
                                Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,5"
                                Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <cc:SkeletonControl CornerRadius="2" Height="10" Width="14" Margin="0,0,4,0"/>
                                <cc:SkeletonControl CornerRadius="2" Height="10" Width="10" Margin="0,0,4,0"/>
                                <cc:SkeletonControl CornerRadius="2" Height="10" Width="16" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding WaitingHint, Mode=OneWay}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- 5. 流式阶段状态指示器（检索/联网搜索/生成...） -->
                        <Border Visibility="{Binding ShowStatus, Converter={StaticResource B2V}}"
                                Background="Transparent"
                                Margin="0,2,0,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6"
                                         Fill="{StaticResource PrimaryBrush}"
                                         Margin="0,0,6,0"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StatusText, Mode=OneWay}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- 6. 引用来源卡片列表（可点击打开对应来源抽屉/网页） -->
                        <ItemsControl ItemsSource="{Binding Sources, Mode=OneWay}"
                                      Margin="0,8,0,0"
                                      Visibility="{Binding HasSources, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:SourceRef}">
                                    <Border Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="6,3"
                                            Margin="0,2,0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0"
                                                    Command="{Binding DataContext.OpenSourceCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource TextButtonStyle}"
                                                    HorizontalAlignment="Left"
                                                    Padding="0">
                                                <Button.ToolTip>
                                                    <ToolTip>
                                                        <StackPanel MaxWidth="400">
                                                            <!-- web 来源 -->
                                                            <TextBlock Visibility="{Binding IsWebSource, Converter={StaticResource BoolToVis}}"
                                                                       Text="🌐 网页检索结果" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                                                            <TextBlock Visibility="{Binding IsWebSource, Converter={StaticResource BoolToVis}}"
                                                                       Text="{Binding DisplayTitle}" TextWrapping="Wrap" FontWeight="Medium"/>
                                                            <TextBlock Visibility="{Binding IsWebSource, Converter={StaticResource BoolToVis}}"
                                                                       Text="{Binding Url}" Foreground="Blue" TextDecorations="Underline" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                            <TextBlock Visibility="{Binding IsWebSource, Converter={StaticResource BoolToVis}}"
                                                                       Text="{Binding SourceName, TargetNullValue=Web, StringFormat=来源引擎: {0}}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                                            <TextBlock Visibility="{Binding IsWebSource, Converter={StaticResource BoolToVis}}"
                                                                       Text="{Binding AuthorityBadgeText, StringFormat=来源级别: {0}}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                            <TextBlock Visibility="{Binding IsWebSource, Converter={StaticResource BoolToVis}}"
                                                                       Text="{Binding EvidenceBadgeText}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                            <!-- 本地来源 -->
                                                            <TextBlock Visibility="{Binding IsWebSource, Converter={StaticResource BoolInvertConverter}}"
                                                                       Text="📖 本地原著知识切片 (Ground Truth)" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                                                            <TextBlock Visibility="{Binding IsWebSource, Converter={StaticResource BoolInvertConverter}}"
                                                                       Text="{Binding Source, StringFormat=出处文档: {0}}" TextWrapping="Wrap"/>
                                                            <TextBlock Visibility="{Binding IsWebSource, Converter={StaticResource BoolInvertConverter}}"
                                                                       Text="{Binding Page, TargetNullValue=未知, StringFormat=原著页码: P{0}}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                            <TextBlock Visibility="{Binding IsWebSource, Converter={StaticResource BoolInvertConverter}}"
                                                                       Text="{Binding Heading, TargetNullValue=正文, StringFormat=章节: {0}}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                            <TextBlock Visibility="{Binding IsWebSource, Converter={StaticResource BoolInvertConverter}}"
                                                                       Text="💡 点击可在右侧抽屉展开原著切片或在【搜索】页全文查证" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,6,0,0"/>
                                                        </StackPanel>
                                                    </ToolTip>
                                                </Button.ToolTip>
                                                <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                                                    <TextBlock Text="{Binding Index, StringFormat=[{0}]}"
                                                               Style="{StaticResource SourceLineText}"
                                                               Foreground="{StaticResource PrimaryBrush}"
                                                               FontWeight="Bold"/>
                                                    <TextBlock Text="🌐"
                                                               Visibility="{Binding IsWebSource, Converter={StaticResource BoolToVis}}"
                                                               FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="📄"
                                                               Visibility="{Binding IsWebSource, Converter={StaticResource BoolInvertConverter}}"
                                                               FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DisplayTitle, Mode=OneWay}"
                                                               Style="{StaticResource SourceLineText}"
                                                               Margin="4,0,0,0"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="260"/>
                                                    <TextBlock Text="{Binding EvidenceBadgeText}"
                                                               Visibility="{Binding IsWebSource, Converter={StaticResource BoolToVis}}"
                                                               Style="{StaticResource SourceLineText}"
                                                               Foreground="{StaticResource PrimaryBrush}"
                                                               Margin="6,0,0,0"
                                                               FontSize="10"/>
                                                    <TextBlock Text="{Binding Page, Mode=OneWay, TargetNullValue='', StringFormat=(P{0})}"
                                                               Style="{StaticResource SourceLineText}"
                                                               Margin="4,0,0,0"
                                                               Visibility="{Binding IsWebSource, Converter={StaticResource BoolInvertConverter}}"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- 右侧直达按钮 -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                                <Button Visibility="{Binding IsWebSource, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.OpenDirectWebCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding Url}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Padding="6,2"
                                                        FontSize="10"
                                                        ToolTip="在默认浏览器中一键直达该网页原文">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🌐 打开网页 ↗" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Visibility="{Binding IsWebSource, Converter={StaticResource BoolInvertConverter}}"
                                                        Command="{Binding DataContext.OpenSourceCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Padding="6,2"
                                                        FontSize="10"
                                                        ToolTip="在右侧协同抽屉展开该原著切片">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="📄 查看切片" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 7. 智能下一步行动建议胶囊 (Follow-up Action Chips) -->
                        <ItemsControl ItemsSource="{Binding FollowUpActions, Mode=OneWay}"
                                      Margin="0,8,0,2"
                                      Visibility="{Binding HasFollowUpActions, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.ExecuteActionCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource PrimaryBrush}"
                                            BorderThickness="1"
                                            Cursor="Hand"
                                            Padding="10,4"
                                            Margin="0,0,8,6"
                                            ToolTip="点击直接执行该下一步行动建议">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Pill"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="12"
                                                        Padding="{TemplateBinding Padding}">
                                                    <TextBlock Text="{Binding}"
                                                               FontSize="12"
                                                               FontWeight="Medium"
                                                               Foreground="{StaticResource PrimaryBrush}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Pill" Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 8. 底部操作工具栏（DeepSeek 风格：复制+微反馈、重试、点赞点踩、沉淀入库与Token统计条） -->
                        <DockPanel Margin="0,6,0,0">
                            <DockPanel.Style>
                                <Style TargetType="DockPanel">
                                    <Setter Property="Opacity" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=BubbleRoot}" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsIngesting}" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCopied}" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DockPanel.Style>

                            <!-- 左侧操作按钮组 -->
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <!-- 复制按钮（带已复制对勾反馈） -->
                                <Button Command="{Binding CopyCommand}"
                                        Style="{StaticResource BubbleActionButtonStyle}"
                                        FontSize="11"
                                        Padding="7,2"
                                        Visibility="{Binding CanCopy, Converter={StaticResource B2V}}"
                                        ToolTip="复制消息内容到剪贴板">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📋 复制" Visibility="{Binding IsCopied, Converter={StaticResource BoolInvertConverter}}"/>
                                            <TextBlock Text="✅ 已复制" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" Visibility="{Binding IsCopied, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </Button.Content>
                                </Button>

                                <!-- 点赞按钮 -->
                                <Button Command="{Binding ToggleLikeCommand}"
                                        Style="{StaticResource BubbleActionButtonStyle}"
                                        FontSize="11"
                                        Padding="6,2"
                                        Margin="4,0,0,0"
                                        Visibility="{Binding IsAssistant, Converter={StaticResource B2V}}"
                                        ToolTip="满意该回答">
                                    <TextBlock Text="👍">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Opacity" Value="0.45"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLiked}" Value="True">
                                                        <Setter Property="Opacity" Value="1.0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>

                                <!-- 点踩按钮 -->
                                <Button Command="{Binding ToggleDislikeCommand}"
                                        Style="{StaticResource BubbleActionButtonStyle}"
                                        FontSize="11"
                                        Padding="6,2"
                                        Margin="4,0,0,0"
                                        Visibility="{Binding IsAssistant, Converter={StaticResource B2V}}"
                                        ToolTip="不满意该回答">
                                    <TextBlock Text="👎">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Opacity" Value="0.45"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDisliked}" Value="True">
                                                        <Setter Property="Opacity" Value="1.0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>

                                <!-- 撤回按钮（仅最后一条用户消息） -->
                                <Button Content="↩️ 撤回"
                                        Command="{Binding DataContext.WithdrawCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource BubbleActionButtonStyle}"
                                        FontSize="11"
                                        Padding="7,2"
                                        Margin="6,0,0,0"
                                        Visibility="{Binding ShowWithdraw, Converter={StaticResource B2V}}"
                                        ToolTip="撤回此条问题并将内容回填到输入框"/>

                                <!-- 重新生成按钮（仅最后一条 assistant） -->
                                <Button Content="🔄 重新生成"
                                        Command="{Binding DataContext.RegenerateCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        Style="{StaticResource BubbleActionButtonStyle}"
                                        FontSize="11"
                                        Padding="7,2"
                                        Margin="6,0,0,0"
                                        Visibility="{Binding ShowRegenerate, Converter={StaticResource B2V}}"
                                        ToolTip="用当前模型重新回答最后一条问题（保留多轮上下文）"/>

                                <!-- 创作物画布预览入口（包含 Artifact 时可见） -->
                                <Button Command="{Binding DataContext.OpenArtifactCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource BubbleActionButtonStyle}"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource PrimaryBrush}"
                                        Padding="7,2"
                                        Margin="6,0,0,0"
                                        Visibility="{Binding HasArtifact, Converter={StaticResource B2V}}"
                                        ToolTip="在右侧创作工作台中查看幻灯片/研报预览与导出物理文件">
                                    <Button.Content>
                                        <TextBlock Text="{Binding ArtifactBadgeText}"/>
                                    </Button.Content>
                                </Button>

                                <!-- 沉淀入库（仅助手消息且有内容时可见） -->
                                <Button Command="{Binding DataContext.IngestMessageCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding}"
                                        FontSize="11"
                                        Padding="7,2"
                                        Margin="6,0,0,0"
                                        Visibility="{Binding IsAssistant, Converter={StaticResource B2V}}"
                                        ToolTip="将本条回答一键萃取并沉淀为知识库笔记（反哺知识库）">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource BubbleActionButtonStyle}">
                                            <Setter Property="Content" Value="📥 沉淀入库"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsIngesting}" Value="True">
                                                    <Setter Property="Content" Value="⏳ 正在沉淀..."/>
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsIngested}" Value="True">
                                                    <Setter Property="Content" Value="✅ 已沉淀入库"/>
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>

                            <!-- 右侧极简 Token 统计胶囊（DeepSeek 风格） -->
                            <Border DockPanel.Dock="Right"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="8,2"
                                    Margin="8,0,0,0"
                                    Visibility="{Binding HasTokenStat, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding TokenStatText, Mode=OneWay}"
                                           FontSize="10"
                                           Foreground="{StaticResource TextTertiaryBrush}"/>
                            </Border>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 主对话区 (弹性占满) -->
            <ColumnDefinition Width="*"/>
            <!-- 协同出处抽屉 (展开时显示) -->
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ===== 左侧主对话区 ===== -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <!-- 工具条 -->
                <RowDefinition Height="Auto"/>
                <!-- 消息区 -->
                <RowDefinition Height="*"/>
                <!-- 输入区 -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== 工具条：知识库集合（复选）+ 添加 + 清空 ===== -->
            <Border Grid.Row="0"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="14,10"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 第一行：集合标签 + 添加按钮 + 清空 -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="知识库"
                               Style="{StaticResource SmallText}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <!-- 添加知识库：输入框 + 按钮 -->
                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding NewCollectionName, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="输入新知识库名称后点击「添加」"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,8,0">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter"
                                            Command="{Binding AddCollectionCommand}"
                                            CommandParameter="{Binding NewCollectionName}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1"
                                Content="添加知识库"
                                Command="{Binding AddCollectionCommand}"
                                CommandParameter="{Binding NewCollectionName}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="10,4"/>
                    </Grid>

                    <Button Grid.Column="2"
                            Content="清空对话"
                            Command="{Binding ClearCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="8,0,0,0"
                            Visibility="{Binding HasMessages, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <!-- 第二行：知识库复选框列表（带最大高度限制与滚动） -->
                <ScrollViewer Grid.Row="1"
                              MaxHeight="80"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,2,0,4">
                    <ItemsControl ItemsSource="{Binding Collections}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CollectionItem}">
                                <CheckBox Content="{Binding Name}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,2,14,2"
                                          VerticalContentAlignment="Center"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 第三行：历史会话 + 快速切换模型 + 办公角色（三列规整排布） -->
                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 第1列：历史会话管理 -->
                    <Grid Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="会话:"
                                   Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding Sessions}"
                                  SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
                                  DisplayMemberPath="Display"
                                  ToolTip="历史会话（保存在本地知识库中，重启不丢失）。选中即载入并可继续追问"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0"/>
                        <Button Grid.Column="2"
                                Content="➕ 新会话"
                                Command="{Binding NewChatCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="8,4"
                                MinHeight="32"
                                Margin="0,0,4,0"
                                ToolTip="开始新会话（不删除历史记录）"/>
                        <Button Grid.Column="3"
                                Content="🗑 删除"
                                Command="{Binding DeleteSessionCommand}"
                                CommandParameter="{Binding SelectedSession}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="8,4"
                                MinHeight="32"
                                ToolTip="删除当前选中的历史会话（本地记录一并删除）"/>
                    </Grid>

                    <!-- 第2列：模型选择器（点选模型即切换服务商，按请求生效） -->
                    <Grid Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="模型:"
                                   Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding ModelChoices}"
                                  SelectedItem="{Binding SelectedModelChoice, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  ToolTip="点选模型即切换到对应服务商（下条消息生效）；「默认（设置页配置）」= 用设置页填写的服务商配置"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0"/>
                        <Button Grid.Column="2"
                                Content="🔄"
                                Command="{Binding RefreshModelsCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="8,4"
                                MinHeight="32"
                                ToolTip="获取当前服务商的可用模型列表"/>
                    </Grid>

                    <!-- 第3列：办公角色人设切换 -->
                    <Grid Grid.Column="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="角色:"
                                   Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailablePersonas}"
                                  SelectedItem="{Binding SelectedPersona, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  ToolTip="{Binding SelectedPersona.Description}"
                                  VerticalAlignment="Center"/>
                        <Button Grid.Column="2"
                                Content="📤 导出对话"
                                Command="{Binding ExportChatCommand}"
                                Style="{StaticResource TextButtonStyle}"
                                FontSize="12"
                                Padding="8,4"
                                Margin="8,0,0,0"
                                ToolTip="将当前完整对话与引用资料导出为 Markdown 文档"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- ===== 消息列表 ===== -->
        <Grid Grid.Row="1">
            <ScrollViewer x:Name="MessageScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          ScrollChanged="MessageScroll_ScrollChanged">
                <StackPanel Margin="0,4">
                    <!-- 欢迎空态（带一键体验与快捷提问） -->
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="24"
                            VerticalAlignment="Center"
                            MaxWidth="520"
                            HorizontalAlignment="Center"
                            Visibility="{Binding ShowEmptyGuide, Converter={StaticResource BoolToVis}}"
                            Margin="0,20,0,20">
                        <StackPanel>
                            <TextBlock Text="💬" FontSize="42" HorizontalAlignment="Center"/>
                            <TextBlock Text="DocMind 智能知识库助手"
                                       FontSize="16" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,4"/>
                            <TextBlock Text="{Binding EmptyGuideText, Mode=OneWay}"
                                       Style="{StaticResource BodyText}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="0,0,0,16"/>

                            <!-- 操作按钮组：导入示例库 / 配置大模型 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <Button Content="🚀 一键导入官方示例库"
                                        Command="{Binding IngestSampleKnowledgeCommand}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource BoolInvertConverter}}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Padding="14,8"
                                        Margin="0,0,10,0"/>
                                <Button Content="⚙️ 配置大模型 (DeepSeek/离线)"
                                        Command="{Binding NavigateToSettingsCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="14,8"/>
                            </StackPanel>

                            <!-- 推荐快捷体验问题 -->
                            <TextBlock Text="💡 也可以直接点击下方问题开始探索："
                                       Style="{StaticResource SmallText}"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8"/>

                            <WrapPanel HorizontalAlignment="Center">
                                <Button Content="✨ DocMind 核心能力与格式"
                                        Command="{Binding QuickAskCommand}"
                                        CommandParameter="请总结 DocMind 的核心能力与支持的文档格式"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        FontSize="11" Padding="8,4" Margin="3"/>
                                <Button Content="🔍 什么是双引擎混合检索？"
                                        Command="{Binding QuickAskCommand}"
                                        CommandParameter="请解释 DocMind 的向量+BM25双引擎混合检索原理"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        FontSize="11" Padding="8,4" Margin="3"/>
                                <Button Content="⚡ 如何接入 DeepSeek 或本地模型？"
                                        Command="{Binding QuickAskCommand}"
                                        CommandParameter="如何在 DocMind 中配置 DeepSeek API 或本地 Ollama？"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        FontSize="11" Padding="8,4" Margin="3"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- 消息列表 -->
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <StaticResource ResourceKey="MessageBubbleTemplate"/>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===== 输入区 ===== -->
        <Border Grid.Row="2"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="14,10"
                Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 场景快捷指令胶囊栏 -->
                <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="创作 &amp; 场景:"
                                   Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <Button Content="📊 制作PPT"
                                Command="{Binding InsertPromptTemplateCommand}"
                                CommandParameter="ppt"
                                Style="{StaticResource SecondaryButtonStyle}"
                                FontSize="11"
                                Padding="8,3"
                                Margin="0,0,6,0"
                                ToolTip="依托知识库生成分页 PPT 幻灯片大纲与演讲备注"/>
                        <Button Content="📄 撰写研报"
                                Command="{Binding InsertPromptTemplateCommand}"
                                CommandParameter="report"
                                Style="{StaticResource SecondaryButtonStyle}"
                                FontSize="11"
                                Padding="8,3"
                                Margin="0,0,6,0"
                                ToolTip="撰写结构严谨的技术方案论证、公文与行业研报"/>
                        <Button Content="🎓 编制教案"
                                Command="{Binding InsertPromptTemplateCommand}"
                                CommandParameter="lesson"
                                Style="{StaticResource SecondaryButtonStyle}"
                                FontSize="11"
                                Padding="8,3"
                                Margin="0,0,6,0"
                                ToolTip="生成系统教学大纲、课时教学环节与随堂测验"/>
                        <Button Content="📑 对比矩阵"
                                Command="{Binding InsertPromptTemplateCommand}"
                                CommandParameter="matrix"
                                Style="{StaticResource SecondaryButtonStyle}"
                                FontSize="11"
                                Padding="8,3"
                                Margin="0,0,6,0"
                                ToolTip="抽取多维度数据指标对比表格"/>
                        <Button Content="🌐 知识看板"
                                Command="{Binding InsertPromptTemplateCommand}"
                                CommandParameter="webpage"
                                Style="{StaticResource SecondaryButtonStyle}"
                                FontSize="11"
                                Padding="8,3"
                                Margin="0,0,6,0"
                                ToolTip="生成单文件交互式 HTML 总结看板"/>
                        <Button Content="📝 总结提炼"
                                Command="{Binding InsertPromptTemplateCommand}"
                                CommandParameter="summary"
                                Style="{StaticResource SecondaryButtonStyle}"
                                FontSize="11"
                                Padding="8,3"
                                Margin="0,0,6,0"
                                ToolTip="一键生成萃取提炼与 Action Items 待办清单指令"/>
                        <Button Content="✨ 规范润色"
                                Command="{Binding InsertPromptTemplateCommand}"
                                CommandParameter="polish"
                                Style="{StaticResource SecondaryButtonStyle}"
                                FontSize="11"
                                Padding="8,3"
                                Margin="0,0,6,0"
                                ToolTip="一键按企业公文与技术汇报规范进行润色重构"/>
                        <Button Content="⚠️ 风险评审"
                                Command="{Binding InsertPromptTemplateCommand}"
                                CommandParameter="pitfall"
                                Style="{StaticResource SecondaryButtonStyle}"
                                FontSize="11"
                                Padding="8,3"
                                Margin="0,0,6,0"
                                ToolTip="一键进行专家级把关，列出潜在风险与避坑建议"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- 待发送附件胶囊条 (文档/图片) -->
                <Border Grid.Row="1"
                        Visibility="{Binding HasPendingAttachments, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8,4"
                        Margin="0,0,0,8">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📎 已附加资料:" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ItemsControl ItemsSource="{Binding PendingAttachments}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBrush}"
                                                BorderBrush="{DynamicResource PrimaryBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="8,2"
                                                Margin="0,0,6,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Icon}" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="11" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding FileSizeText, StringFormat=({0})}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Margin="4,0,4,0"/>
                                                <Button Content="×"
                                                        Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource TextButtonStyle}"
                                                        FontSize="12"
                                                        FontWeight="Bold"
                                                        Padding="2,0"
                                                        Cursor="Hand"
                                                        ToolTip="移除该附件"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="清空"
                                    Command="{Binding ClearAttachmentsCommand}"
                                    Style="{StaticResource TextButtonStyle}"
                                    FontSize="11"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- 文本输入与发送按钮 -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 📎 导入附件/图片按钮 -->
                    <Button Grid.Column="0"
                            Command="{Binding AddAttachmentCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            ToolTip="导入文档（PDF/Word/PPT/Excel/Markdown/代码）或图片（自动OCR识别）让AI分析读取"
                            Padding="8,6"
                            MinHeight="38"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📎" FontSize="14" Margin="0,0,4,0"/>
                            <TextBlock Text="导入附件" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Grid Grid.Column="1" Margin="0,0,8,0">
                        <TextBox x:Name="ChatInputBox"
                                 Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="输入问题或直接拖入文档/图片，Enter 发送，Shift+Enter 换行"
                                 VerticalContentAlignment="Top"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 AllowDrop="True"
                                 Drop="ChatInputBox_Drop"
                                 PreviewDragOver="ChatInputBox_PreviewDragOver"
                                 Padding="14,8,36,8"
                                 MinHeight="38"
                                 MaxHeight="120"
                                 PreviewKeyDown="ChatInputBox_PreviewKeyDown"/>
                        <Button Content="×"
                                Style="{StaticResource TextButtonStyle}"
                                Command="{Binding ClearCommand}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Padding="6,2"
                                Margin="0,0,6,0"
                                Visibility="{Binding HasInput, Converter={StaticResource BoolToVis}}"/>
                    </Grid>

                    <!-- 联网搜索开关 -->
                    <CheckBox Grid.Column="2"
                              IsChecked="{Binding IsWebSearchEnabled}"
                              Content="🌐 联网搜索"
                              FontSize="11"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              VerticalAlignment="Center"
                              Cursor="Hand"
                              Margin="0,0,8,0"
                              ToolTip="开启后自动从互联网检索最新前沿资料补充回答"/>

                    <Button Grid.Column="3"
                            Content="发送"
                            Command="{Binding SendCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="80"
                            MinHeight="38"/>

                    <Button Grid.Column="4"
                            Content="停止"
                            Command="{Binding StopCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="80"
                            MinHeight="38"
                            Margin="8,0,0,0"
                            Visibility="{Binding ShowStop, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Grid>
        </Border>
        </Grid>

        <!-- ===== 右侧协同抽屉 (双模：原著切片出处 / 创作工作台 Artifact Canvas) ===== -->
        <Border Grid.Column="1"
                Width="380"
                Margin="12,0,0,0"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                SnapsToDevicePixels="True"
                Visibility="{Binding IsSourceDrawerOpen, Converter={StaticResource BoolToVis}}">
            <Grid Margin="16,14">
                <!-- ==================== 模式 A：🎨 创作物工作台 (Artifacts Canvas) ==================== -->
                <Grid Visibility="{Binding IsArtifactMode, Converter={StaticResource B2V}}">
                    <Grid.RowDefinitions>
                        <!-- 头部 (标题 + 类型徽章 + 关闭) -->
                        <RowDefinition Height="Auto"/>
                        <!-- 主预览区 (PPT 卡片 / 文档内容) -->
                        <RowDefinition Height="*"/>
                        <!-- 底部导出工具条 -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 1. 创作物头部 -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎨 创作物工作台"
                                       Style="{StaticResource SubtitleText}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="🎬 沉浸放映"
                                    Command="{Binding OpenSlideShowCommand}"
                                    Visibility="{Binding IsPptArtifact, Converter={StaticResource B2V}}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="6,2"
                                    FontSize="11"
                                    Margin="0,0,4,0"
                                    ToolTip="进入客户端大屏全景放映模式"/>

                            <Button Content="🌐 网页放映"
                                    Command="{Binding OpenWebPreviewCommand}"
                                    Visibility="{Binding IsPptArtifact, Converter={StaticResource B2V}}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="6,2"
                                    FontSize="11"
                                    Margin="0,0,4,0"
                                    ToolTip="在默认浏览器中开启 16:9 交互式 HTML5 幻灯片放映"/>

                            <Button Content="🔍 效果自检"
                                    Command="{Binding InspectPptCommand}"
                                    Visibility="{Binding IsPptArtifact, Converter={StaticResource B2V}}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="6,2"
                                    FontSize="11"
                                    Margin="0,0,6,0"
                                    ToolTip="全方位体检 PPT 结构完整度、文字密度与演讲准备度"/>

                            <Border Background="{StaticResource PrimaryLightBrush}"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedArtifact.Type, StringFormat={}{0}}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}"/>
                            </Border>
                        </StackPanel>

                        <Button Grid.Row="0" Grid.Column="2"
                                Content="✕"
                                Command="{Binding CloseSourceDrawerCommand}"
                                Style="{StaticResource IconButtonStyle}"
                                Width="26" Height="26"
                                ToolTip="关闭工作台"/>

                        <!-- PPT 主题配色切换选择器 (仅 PPT 模式显示) -->
                        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0"
                              Visibility="{Binding IsPptArtifact, Converter={StaticResource B2V}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="配色主题:"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableThemes}"
                                      SelectedItem="{Binding SelectedTheme}"
                                      DisplayMemberPath="DisplayName"
                                      FontSize="12"
                                      Padding="6,3"
                                      ToolTip="切换 PPT 演示文稿企业级主题配色"/>
                        </Grid>
                    </Grid>

                    <!-- 2. 主预览区 -->
                    <Grid Grid.Row="1">
                        <!-- PPT 幻灯片预览卡片 -->
                        <Grid Visibility="{Binding IsPptArtifact, Converter={StaticResource B2V}}">
                            <Grid.RowDefinitions>
                                <!-- 幻灯片卡片 -->
                                <RowDefinition Height="*"/>
                                <!-- 翻页工具栏 -->
                                <RowDefinition Height="Auto"/>
                                <!-- 演讲备注 -->
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 幻灯片模拟卡片 (16:9 质感卡片) -->
                            <Border Grid.Row="0"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource PrimaryBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="10"
                                    Padding="14"
                                    Margin="0,0,0,8">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <!-- 顶部科技装饰条 -->
                                        <Border Height="3" Background="{StaticResource PrimaryBrush}" CornerRadius="2" Margin="0,0,0,8"/>
                                        
                                        <!-- 板式类型指示标签 -->
                                        <Border Background="{StaticResource PrimaryLightBrush}"
                                                CornerRadius="3"
                                                Padding="5,1"
                                                HorizontalAlignment="Left"
                                                Margin="0,0,0,6">
                                            <TextBlock Text="{Binding SelectedSlide.Layout, StringFormat=板式: {0}}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryBrush}"/>
                                        </Border>

                                        <!-- 幻灯片标题 -->
                                        <TextBlock Text="{Binding SelectedSlide.Title}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,6"/>
                                        <!-- 封面副标题 (如果有) -->
                                        <TextBlock Text="{Binding SelectedSlide.Subtitle}"
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,10"
                                                   Visibility="{Binding SelectedSlide.IsCover, Converter={StaticResource B2V}}"/>

                                        <!-- 板式 A: 多列卡片网格 (Cards) -->
                                        <ItemsControl ItemsSource="{Binding SelectedSlide.Cards}"
                                                      Visibility="{Binding SelectedSlide.IsCards, Converter={StaticResource B2V}}"
                                                      Margin="0,4,0,4">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource CardBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="8"
                                                            Margin="0,0,0,6">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                                                            <TextBlock Text="{Binding Content}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Visibility="{Binding Content, Converter={StaticResource StringToVis}}"/>
                                                            <ItemsControl ItemsSource="{Binding Bullets}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding StringFormat=• {0}}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="4,2,0,2"/>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- 板式 B: 大数字 KPI 看板 (Metrics) -->
                                        <ItemsControl ItemsSource="{Binding SelectedSlide.Metrics}"
                                                      Visibility="{Binding SelectedSlide.IsMetrics, Converter={StaticResource B2V}}"
                                                      Margin="0,4,0,4">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource PrimaryLightBrush}"
                                                            CornerRadius="6"
                                                            Padding="10,6"
                                                            Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Value}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Visibility="{Binding Description, Converter={StaticResource StringToVis}}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- 板式 C: 横向时间线 (Timeline) -->
                                        <ItemsControl ItemsSource="{Binding SelectedSlide.TimelineNodes}"
                                                      Visibility="{Binding SelectedSlide.IsTimeline, Converter={StaticResource B2V}}"
                                                      Margin="0,4,0,4">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                                        <Border Background="{StaticResource PrimaryBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Stage}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- 板式 D: 金句引用 (Quote) -->
                                        <Border Background="{StaticResource PrimaryLightBrush}"
                                                CornerRadius="6"
                                                Padding="12"
                                                Margin="0,4,0,4"
                                                Visibility="{Binding SelectedSlide.IsQuote, Converter={StaticResource B2V}}">
                                            <TextBlock Text="{Binding SelectedSlide.QuoteText, StringFormat=“ {0} ”}"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       FontStyle="Italic"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       TextWrapping="Wrap"/>
                                        </Border>

                                        <!-- 板式 E: 普通要点列表 (General / 默认) -->
                                        <ItemsControl ItemsSource="{Binding SelectedSlide.BulletPoints}"
                                                      Visibility="{Binding SelectedSlide.IsGeneral, Converter={StaticResource B2V}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                                        <TextBlock Text="•" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding}" FontSize="13" TextWrapping="Wrap" MaxWidth="300" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- 翻页导航栏 -->
                            <Grid Grid.Row="1" Margin="0,4,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="◀ 上一页"
                                        Command="{Binding PrevSlideCommand}"
                                        IsEnabled="{Binding CanPrevSlide}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="8,3"
                                        FontSize="11"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SlideCountText}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="2"
                                        Content="下一页 ▶"
                                        Command="{Binding NextSlideCommand}"
                                        IsEnabled="{Binding CanNextSlide}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="8,3"
                                        FontSize="11"/>
                            </Grid>

                            <!-- 演讲备注 (Speaker Notes) 展开框 -->
                            <Border Grid.Row="2"
                                    Background="{StaticResource PrimaryLightBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,6"
                                    Margin="0,0,0,8"
                                    Visibility="{Binding SelectedSlide.HasNotes, Converter={StaticResource B2V}}">
                                <StackPanel>
                                    <TextBlock Text="🎤 本页演讲备注 (Speaker Notes)："
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding SelectedSlide.SpeakerNotes}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 非 PPT 交付物内容文本框 (研报/表格/网页) -->
                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10"
                                Margin="0,0,0,8"
                                Visibility="{Binding IsPptArtifact, Converter={StaticResource BoolInvertConverter}}">
                            <TextBox Text="{Binding SelectedArtifact.RawContent, Mode=OneWay}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="13"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     Cursor="IBeam"/>
                        </Border>

                        <!-- PPT 效果体检诊断报告浮层面板 -->
                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource PrimaryBrush}"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Padding="12"
                                Margin="0,0,0,8"
                                Visibility="{Binding IsInspectionReportOpen, Converter={StaticResource B2V}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- 报告头部 -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="📋 PPT 效果体检报告" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="✕" Command="{Binding CloseInspectionReportCommand}" Style="{StaticResource IconButtonStyle}" Width="22" Height="22"/>
                                    </Grid>

                                    <!-- 得分与等级大看板 -->
                                    <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" HorizontalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding InspectionReport.Score}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="健康度得分" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <Border Background="{StaticResource PrimaryBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding InspectionReport.Grade, StringFormat=评级: {0}}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                                <TextBlock Text="{Binding InspectionReport.Summary}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- 4 大体检核心指标 -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{StaticResource CardBrush}" CornerRadius="4" Padding="4,4" Margin="0,0,3,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding InspectionReport.SlideCount, StringFormat={}{0} 页}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="总篇幅" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Background="{StaticResource CardBrush}" CornerRadius="4" Padding="4,4" Margin="0,0,3,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding InspectionReport.NotesCoveragePct, StringFormat={}{0}%}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="提词覆盖" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Background="{StaticResource CardBrush}" CornerRadius="4" Padding="4,4" Margin="0,0,3,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding InspectionReport.ArchetypeDiversity, StringFormat={}{0} 种}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="板式丰富" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="3" Background="{StaticResource CardBrush}" CornerRadius="4" Padding="4,4">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding InspectionReport.AvgWordsPerSlide, StringFormat={}{0} 字}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="单页字数" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- 诊断问题与优化建议列表 -->
                                    <TextBlock Text="💡 诊断建议与优化项:" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,4"/>
                                    <ItemsControl ItemsSource="{Binding InspectionReport.Issues}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,0,4">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                            <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                                <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding FixSuggestion, StringFormat=建议: {0}}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Visibility="{Binding FixSuggestion, Converter={StaticResource StringToVis}}" Margin="4,2,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button Content="返回幻灯片画布" Command="{Binding CloseInspectionReportCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Center" Margin="0,8,0,0" Padding="12,4" FontSize="11"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- 3. 底部导出按钮栏 -->
                    <StackPanel Grid.Row="2">
                        <Button Content="📥 一键编译导出为本地物理文件"
                                Command="{Binding ExportArtifactFileCommand}"
                                CommandParameter="{Binding SelectedArtifact.Type}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="12,8"
                                FontWeight="Bold"
                                FontSize="13"
                                Margin="0,0,0,6"
                                ToolTip="将当前创作物编译生成原生 PPTX / Word / Excel / HTML 文件并在资源管理器中定位"/>
                    </StackPanel>
                </Grid>

                <!-- ==================== 模式 B：📖 原著知识切片 ==================== -->
                <Grid Visibility="{Binding IsArtifactMode, Converter={StaticResource BoolInvertConverter}}">
                    <Grid.RowDefinitions>
                        <!-- 抽屉头部 (标题 + 评分 + 关闭按钮) -->
                        <RowDefinition Height="Auto"/>
                        <!-- 元数据卡片 (文件名、章节、页码) -->
                        <RowDefinition Height="Auto"/>
                        <!-- 原文切片标题 -->
                        <RowDefinition Height="Auto"/>
                        <!-- 原文切片内容 -->
                        <RowDefinition Height="*"/>
                        <!-- 底部操作按钮 -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 1. 抽屉头部 -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- web 来源标题 -->
                            <TextBlock Visibility="{Binding SelectedSource.IsWebSource, Converter={StaticResource BoolToVis}}"
                                       Text="🌐 网页检索结果"
                                       Style="{StaticResource SubtitleText}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       VerticalAlignment="Center"/>
                            <!-- 本地来源标题 -->
                            <TextBlock Visibility="{Binding SelectedSource.IsWebSource, Converter={StaticResource BoolInvertConverter}}"
                                       Text="📖 原著知识切片"
                                       Style="{StaticResource SubtitleText}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 相似度评分（仅本地来源显示） -->
                        <Border Grid.Column="1"
                                Visibility="{Binding SelectedSource.IsWebSource, Converter={StaticResource BoolInvertConverter}}"
                                Background="{StaticResource PrimaryLightBrush}"
                                CornerRadius="4"
                                Padding="6,2"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedSource.Score, StringFormat=匹配度 {0:F2}}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}"/>
                        </Border>

                        <!-- 搜索引擎来源标签（仅 web 来源显示） -->
                        <Border Grid.Column="1"
                                Visibility="{Binding SelectedSource.IsWebSource, Converter={StaticResource BoolToVis}}"
                                Background="{StaticResource PrimaryLightBrush}"
                                CornerRadius="4"
                                Padding="6,2"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedSource.SourceName, TargetNullValue=Web, StringFormat=来源: {0}}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}"/>
                        </Border>

                        <!-- 关闭按钮 -->
                        <Button Grid.Column="2"
                                Content="✕"
                                Command="{Binding CloseSourceDrawerCommand}"
                                Style="{StaticResource IconButtonStyle}"
                                Width="26" Height="26"
                                ToolTip="关闭切片预览 (Esc)"/>
                    </Grid>

                    <!-- 2. 出处元数据卡片 -->
                    <Border Grid.Row="1"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <!-- 本地来源：文档名 + 章节/页码 -->
                            <StackPanel Visibility="{Binding SelectedSource.IsWebSource, Converter={StaticResource BoolInvertConverter}}">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="文档：" Style="{StaticResource SmallText}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedSource.DisplayTitle}"
                                               Style="{StaticResource SmallText}"
                                               FontWeight="Medium"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding SelectedSource.Heading, TargetNullValue=正文章节, StringFormat=章节：{0}}"
                                               Style="{StaticResource SmallText}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedSource.Page, TargetNullValue=—, StringFormat=第 P{0} 页}"
                                               Style="{StaticResource SmallText}"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               FontWeight="SemiBold"
                                               Margin="6,0,0,0"/>
                                </Grid>
                            </StackPanel>
                            <!-- web 来源：标题 + URL -->
                            <StackPanel Visibility="{Binding SelectedSource.IsWebSource, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding SelectedSource.DisplayTitle}"
                                           Style="{StaticResource SmallText}"
                                           FontWeight="Medium"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SelectedSource.Url}"
                                           Style="{StaticResource SmallText}"
                                           Foreground="Blue"
                                           TextDecorations="Underline"
                                           TextWrapping="Wrap"
                                           Cursor="Hand"
                                           MouseLeftButtonDown="OpenWebSource_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 3. 原文切片标题 -->
                    <TextBlock Grid.Row="2"
                               Text="正文切片 (Ground Truth)"
                               Style="{StaticResource SmallText}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,6"/>

                    <!-- 4. 正文切片内容 -->
                    <Border Grid.Row="3"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8"
                            Margin="0,0,0,12">
                        <TextBox Text="{Binding SelectedSourceSnippet, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="13"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 Cursor="IBeam"/>
                    </Border>

                    <!-- 5. 底部操作栏 -->
                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Row="0" Grid.Column="0"
                                Content="📋 复制摘要"
                                Command="{Binding CopySourceSnippetCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="8,6"
                                Margin="0,0,4,6"
                                ToolTip="复制当前切片正文到剪贴板"/>

                        <!-- 本地来源：全文检索 -->
                        <Button Grid.Row="0" Grid.Column="1"
                                Visibility="{Binding SelectedSource.IsWebSource, Converter={StaticResource BoolInvertConverter}}"
                                Content="🔍 全文检索"
                                Command="{Binding SearchSourceInSearchPageCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="8,6"
                                Margin="4,0,0,6"
                                ToolTip="跳转至搜索页检索此文档的更多分块"/>

                        <!-- web 来源：在浏览器中打开 -->
                        <Button Grid.Row="0" Grid.Column="1"
                                Visibility="{Binding SelectedSource.IsWebSource, Converter={StaticResource BoolToVis}}"
                                Content="🌐 在浏览器中打开"
                                Command="{Binding OpenWebSourceCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="8,6"
                                Margin="4,0,0,6"
                                ToolTip="在默认浏览器中打开此网页"/>

                        <!-- 本地来源：文件定位 + 打开文件 -->
                        <Button Grid.Row="1" Grid.Column="0"
                                Visibility="{Binding SelectedSource.IsWebSource, Converter={StaticResource BoolInvertConverter}}"
                                Content="📂 文件定位"
                                Command="{Binding RevealSourceInExplorerCommand}"
                                Style="{StaticResource TextButtonStyle}"
                                FontSize="11"
                                Padding="6,4"
                                Margin="0,0,4,0"
                                ToolTip="在 Windows 文件资源管理器中选中并定位原文件"/>

                        <Button Grid.Row="1" Grid.Column="1"
                                Visibility="{Binding SelectedSource.IsWebSource, Converter={StaticResource BoolInvertConverter}}"
                                Content="📄 打开文件"
                                Command="{Binding OpenSourceFileCommand}"
                                Style="{StaticResource TextButtonStyle}"
                                FontSize="11"
                                Padding="6,4"
                                Margin="4,0,0,0"
                                ToolTip="使用系统默认程序打开此原文件"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- =====================================================================
             沉淀入库微调弹窗（方案 A + B：支持用户自选范围、修改标题、切换目标集合与标签）
             ===================================================================== -->
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="3"
                Background="#66000000"
                Visibility="{Binding IsIngestDialogOpen, Converter={StaticResource B2V}}"
                Panel.ZIndex="1000">
            <Border Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    MaxWidth="560"
                    MaxHeight="620"
                    Margin="24"
                    Padding="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Effect="{StaticResource ShadowLg}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 弹窗头部 -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,16">
                        <Button DockPanel.Dock="Right"
                                Command="{Binding CloseIngestDialogCommand}"
                                Content="✕"
                                Width="26" Height="26"
                                Background="Transparent"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                BorderThickness="0"
                                Cursor="Hand"
                                FontSize="13"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📥" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="知识笔记沉淀入库" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- 弹窗内容表单 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                        <StackPanel>
                            <!-- 笔记标题 -->
                            <TextBlock Text="笔记标题" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding IngestDialogTitle, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="13" FontWeight="SemiBold"
                                     Margin="0,0,0,14" Padding="8,6"/>

                            <!-- 目标集合与标签 -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="目标知识库集合" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding IngestDialogCollection, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="输入或选择要存入的知识库集合名（默认 default）"
                                             Padding="8,6"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="知识标签 (可选，逗号分隔)" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding IngestDialogTags, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="例如：经验, 架构, 踩坑排错"
                                             Padding="8,6"/>
                                </StackPanel>
                            </Grid>

                            <!-- 沉淀内容正文（支持用户自由增删、挑选重点片段） -->
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="沉淀内容 (可自由编辑、删减非重点)" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                                <TextBlock Text="支持 Markdown" DockPanel.Dock="Right" Style="{StaticResource SmallText}" Foreground="{StaticResource TextTertiaryBrush}"/>
                            </DockPanel>
                            <TextBox Text="{Binding IngestDialogContent, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="160"
                                     MaxHeight="260"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas, 'Cascadia Code', 'Segoe UI', sans-serif"
                                     FontSize="12"
                                     Padding="10,8"
                                     Margin="0,0,0,6"/>
                            <TextBlock Text="💡 提示：您可以在上方自由删减寒暄、仅保留核心方案或补充个人批注，点击确认后即刻向量化存入本地知识库。"
                                       Style="{StaticResource SmallText}"
                                       Foreground="{StaticResource TextTertiaryBrush}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 弹窗底部操作按钮 -->
                    <DockPanel Grid.Row="2">
                        <TextBlock Text="⏳ 正在建立向量索引并入库..."
                                   Visibility="{Binding IsDialogIngesting, Converter={StaticResource B2V}}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="取消"
                                    Command="{Binding CloseIngestDialogCommand}"
                                    Style="{StaticResource TextButtonStyle}"
                                    Padding="14,6"
                                    Margin="0,0,8,0"/>
                            <Button Content="🚀 确认沉淀入库"
                                    Command="{Binding ConfirmIngestDialogCommand}"
                                    IsEnabled="{Binding IsDialogIngesting, Converter={StaticResource BoolInvertConverter}}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="18,6"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>
        </Border>

        <!-- ==================== 🎬 大屏沉浸式幻灯片放映室 (SlideShow Modal) ==================== -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                Background="#D8000000"
                Visibility="{Binding IsSlideShowOpen, Converter={StaticResource B2V}}"
                d:Visibility="Collapsed"
                Panel.ZIndex="2000">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <!-- 顶部控制条 -->
                    <RowDefinition Height="Auto"/>
                    <!-- 16:9 核心舞台 -->
                    <RowDefinition Height="*"/>
                    <!-- 底部演讲提词小抄 -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. 顶部控制工具条 -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🎬 " FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedArtifact.Title}" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        <Border Background="#33FFFFFF" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedTheme.DisplayName}" FontSize="11" Foreground="#E2E8F0"/>
                        </Border>
                    </StackPanel>

                    <!-- 中间页码指示器 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#22FFFFFF" BorderBrush="#44FFFFFF" BorderThickness="1" CornerRadius="20" Padding="16,4">
                            <TextBlock Text="{Binding SlideCountText}" FontSize="14" FontWeight="Bold" Foreground="#38BDF8"/>
                        </Border>
                    </StackPanel>

                    <!-- 右侧操作 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="🎤 演讲提词"
                                Command="{Binding ToggleSlideShowNotesCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="10,4"
                                FontSize="12"
                                Margin="0,0,8,0"
                                ToolTip="显示/隐藏演讲提词小抄"/>
                        <Button Content="✕ 退出放映 (Esc)"
                                Command="{Binding CloseSlideShowCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,4"
                                FontSize="12"
                                FontWeight="Bold"
                                ToolTip="退出全屏放映模式"/>
                    </StackPanel>
                </Grid>

                <!-- 2. 16:9 核心幻灯片舞台 -->
                <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="1100" Width="950">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧翻页大按钮 -->
                    <Button Grid.Column="0"
                            Content="◀"
                            Command="{Binding PrevSlideCommand}"
                            IsEnabled="{Binding CanPrevSlide}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="44" Height="44"
                            FontSize="18"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            ToolTip="上一页 (Left Arrow / PageUp)"/>

                    <!-- 16:9 质感幻灯片主卡片 -->
                    <Border Grid.Column="1"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            BorderThickness="1.5"
                            CornerRadius="16"
                            Padding="36"
                            MinHeight="460"
                            Effect="{StaticResource ShadowLg}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- 顶部主题色装饰条 -->
                                <Border Height="4" Background="{DynamicResource PrimaryBrush}" CornerRadius="2" Margin="0,0,0,18"/>

                                <!-- 标题与板式徽章 -->
                                <DockPanel Margin="0,0,0,16">
                                    <Border Background="{DynamicResource PrimaryLightBrush}"
                                            CornerRadius="4"
                                            Padding="8,2"
                                            DockPanel.Dock="Right"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="{Binding SelectedSlide.Layout, StringFormat={}{0}}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryBrush}"/>
                                    </Border>
                                    <TextBlock Text="{Binding SelectedSlide.Title}"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"/>
                                </DockPanel>

                                <!-- 副标题 (如果有) -->
                                <TextBlock Text="{Binding SelectedSlide.Subtitle}"
                                           FontSize="15"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,20"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding SelectedSlide.Subtitle, Converter={StaticResource StringToVis}}"/>

                                <!-- 板式 1：卡片网格 (Cards Grid) -->
                                <ItemsControl ItemsSource="{Binding SelectedSlide.Cards}"
                                              Visibility="{Binding SelectedSlide.IsCards, Converter={StaticResource B2V}}"
                                              Margin="0,6,0,12">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource PrimaryLightBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="16"
                                                    Margin="6">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="16"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource PrimaryBrush}"
                                                               Margin="0,0,0,8"/>
                                                    <TextBlock Text="{Binding Content}"
                                                               FontSize="13"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               Margin="0,0,0,6"
                                                               Visibility="{Binding Content, Converter={StaticResource StringToVis}}"/>
                                                    <ItemsControl ItemsSource="{Binding Bullets}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding StringFormat=• {0}}"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           TextWrapping="Wrap"
                                                                           Margin="0,2,0,0"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 板式 2：大数字 KPI 看板 (Metrics) -->
                                <ItemsControl ItemsSource="{Binding SelectedSlide.Metrics}"
                                              Visibility="{Binding SelectedSlide.IsMetrics, Converter={StaticResource B2V}}"
                                              Margin="0,12,0,16">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="4"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource CardBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="14"
                                                    Margin="6">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding Value}"
                                                               FontSize="32"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource PrimaryBrush}"
                                                               HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Label}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 板式 3：时间线路线图 (Timeline) -->
                                <ItemsControl ItemsSource="{Binding SelectedSlide.TimelineNodes}"
                                              Visibility="{Binding SelectedSlide.IsTimeline, Converter={StaticResource B2V}}"
                                              Margin="0,10,0,16">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource PrimaryLightBrush}"
                                                    BorderBrush="{DynamicResource PrimaryBrush}"
                                                    BorderThickness="0,3,0,0"
                                                    CornerRadius="0,0,8,8"
                                                    Padding="12"
                                                    Margin="6">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Stage}"
                                                               FontSize="13"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource PrimaryBrush}"
                                                               Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 板式 4：金句核心观点 (Quote) -->
                                <Border Background="{DynamicResource PrimaryLightBrush}"
                                        BorderBrush="{DynamicResource PrimaryBrush}"
                                        BorderThickness="4,0,0,0"
                                        CornerRadius="0,8,8,0"
                                        Padding="20"
                                        Margin="0,16,0,16"
                                        Visibility="{Binding SelectedSlide.IsQuote, Converter={StaticResource B2V}}">
                                    <TextBlock Text="{Binding SelectedSlide.QuoteText, StringFormat=“ {0} ”}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               FontStyle="Italic"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <!-- 常规要点列表 (Bullet Points) -->
                                <ItemsControl ItemsSource="{Binding SelectedSlide.BulletPoints}"
                                              Visibility="{Binding SelectedSlide.IsGeneral, Converter={StaticResource B2V}}"
                                              Margin="0,6,0,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <TextBlock Text="✦ "
                                                           Foreground="{DynamicResource PrimaryBrush}"
                                                           FontSize="15"
                                                           FontWeight="Bold"/>
                                                <TextBlock Text="{Binding}"
                                                           FontSize="15"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextWrapping="Wrap"
                                                           LineHeight="24"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- 右侧翻页大按钮 -->
                    <Button Grid.Column="2"
                            Content="▶"
                            Command="{Binding NextSlideCommand}"
                            IsEnabled="{Binding CanNextSlide}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="44" Height="44"
                            FontSize="18"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            ToolTip="下一页 (Right Arrow / PageDown / Space)"/>
                </Grid>

                <!-- 3. 底部悬浮演讲提词小抄 (Speaker Notes) -->
                <Border Grid.Row="2"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16,10"
                        Margin="0,16,0,0"
                        MaxWidth="950"
                        HorizontalAlignment="Center"
                        Visibility="{Binding IsSpeakerNotesVisibleInSlideShow, Converter={StaticResource B2V}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="🎤 演讲者实时提词小抄" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                            <TextBlock Text=" (仅您可见)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SelectedSlide.SpeakerNotes}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   LineHeight="20"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>